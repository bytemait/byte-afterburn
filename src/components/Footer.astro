---
interface Props {
  immersive?: boolean;
}

const { immersive = false } = Astro.props;
---

{immersive ? (
  <footer class="byte-footer">
    <div class="byte-footer-container">
      <div class="byte-footer-spacer" aria-hidden="true">
        <div class="byte-footer-object">
          <div class="byte-footer-glow"></div>
          <svg class="byte-pillars" viewBox="0 0 1440 680" preserveAspectRatio="xMidYMax slice">
            <defs>
              <linearGradient id="byte-pillar-left" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2b312d" /><stop offset="1" stop-color="#101411" /></linearGradient>
              <linearGradient id="byte-pillar-right" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1c211e" /><stop offset="1" stop-color="#070907" /></linearGradient>
              <linearGradient id="byte-pillar-green-left" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#23be74" /><stop offset="1" stop-color="#075a34" /></linearGradient>
              <linearGradient id="byte-pillar-green-right" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#169456" /><stop offset="1" stop-color="#043d23" /></linearGradient>
              <filter id="byte-pillar-blur" x="-30%" y="-50%" width="160%" height="200%"><feGaussianBlur stdDeviation="26" /></filter>
            </defs>
            <g filter="url(#byte-pillar-blur)" opacity=".34">
              <path d="M86 468 200 402 314 468 200 534Z" fill="#22c579" />
              <path d="M592 272 720 198 848 272 720 346Z" fill="#52e0a6" />
              <path d="M1130 436 1242 371 1354 436 1242 501Z" fill="#22c579" />
            </g>
            <g class="pillar"><path d="M-88 470 28 403 144 470 28 537Z" fill="#363d38" /><path d="M-88 470 28 537 28 680-88 613Z" fill="url(#byte-pillar-left)" /><path d="M28 537 144 470 144 613 28 680Z" fill="url(#byte-pillar-right)" /></g>
            <g class="pillar"><path d="M104 425 220 358 336 425 220 492Z" fill="#414943" /><path d="M104 425 220 492 220 680 104 613Z" fill="url(#byte-pillar-left)" /><path d="M220 492 336 425 336 613 220 680Z" fill="url(#byte-pillar-right)" /></g>
            <g class="pillar"><path d="M296 490 412 423 528 490 412 557Z" fill="#303732" /><path d="M296 490 412 557 412 680 296 613Z" fill="url(#byte-pillar-left)" /><path d="M412 557 528 490 528 613 412 680Z" fill="url(#byte-pillar-right)" /></g>
            <g class="pillar"><path d="M488 380 604 313 720 380 604 447Z" fill="#444c46" /><path d="M488 380 604 447 604 680 488 613Z" fill="url(#byte-pillar-left)" /><path d="M604 447 720 380 720 613 604 680Z" fill="url(#byte-pillar-right)" /></g>
            <g class="pillar pillar-accent"><path d="M604 252 720 185 836 252 720 319Z" fill="#52e0a6" /><path d="M604 252 720 319 720 680 604 613Z" fill="url(#byte-pillar-green-left)" /><path d="M720 319 836 252 836 613 720 680Z" fill="url(#byte-pillar-green-right)" /></g>
            <g class="pillar"><path d="M720 392 836 325 952 392 836 459Z" fill="#454d47" /><path d="M720 392 836 459 836 680 720 613Z" fill="url(#byte-pillar-left)" /><path d="M836 459 952 392 952 613 836 680Z" fill="url(#byte-pillar-right)" /></g>
            <g class="pillar"><path d="M912 472 1028 405 1144 472 1028 539Z" fill="#343b36" /><path d="M912 472 1028 539 1028 680 912 613Z" fill="url(#byte-pillar-left)" /><path d="M1028 539 1144 472 1144 613 1028 680Z" fill="url(#byte-pillar-right)" /></g>
            <g class="pillar"><path d="M1104 405 1220 338 1336 405 1220 472Z" fill="#414941" /><path d="M1104 405 1220 472 1220 680 1104 613Z" fill="url(#byte-pillar-left)" /><path d="M1220 472 1336 405 1336 613 1220 680Z" fill="url(#byte-pillar-right)" /></g>
            <g class="pillar"><path d="M1296 485 1412 418 1528 485 1412 552Z" fill="#343b36" /><path d="M1296 485 1412 552 1412 680 1296 613Z" fill="url(#byte-pillar-left)" /><path d="M1412 552 1528 485 1528 613 1412 680Z" fill="url(#byte-pillar-right)" /></g>
          </svg>
          <div class="byte-footer-haze"></div>
        </div>
      </div>

      <div class="byte-footer-bottom">
        <p class="byte-copyright">©2026 BYTE <a class="afterburn-link" href="https://github.com/bytemait/byte-afterburn" target="_blank" rel="noreferrer" aria-label="Open the Byte Afterburn GitHub repository">
          <span class="afterburn-word">AFTERBURN</span>
          <svg class="afterburn-github" viewBox="0 0 24 24" aria-hidden="true"><defs><pattern id="footer-mesh-pattern" width="7" height="7" patternUnits="userSpaceOnUse"><path d="M0 6 3.5 1 7 5M0 2.5 7 4" fill="none" stroke="#52e0a6" stroke-width=".45"/><circle cx="0" cy="6" r=".7" fill="#b3ffd8"/><circle cx="3.5" cy="1" r=".7" fill="#b3ffd8"/><circle cx="7" cy="5" r=".7" fill="#b3ffd8"/></pattern></defs><path d="M12 2a10 10 0 00-3.16 19.5c.5.1.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 015 0c1.9-.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .26.18.58.69.48A10 10 0 0022 12 10 10 0 0012 2z" fill="url(#footer-mesh-pattern)" stroke="#9ff7c8" stroke-width=".65" stroke-linejoin="round" /></svg>
        </a></p>
        <nav aria-label="Social links"><a href="#">Instagram</a><a href="#">LinkedIn</a></nav>
        <a class="byte-back-to-top" href="#">Back to top</a>
      </div>
    </div>
  </footer>
) : (
  <footer>
    <div class="wrap">
      <div class="footer-grid">
        <div><a href="/" class="brand"><span class="mark"><svg><use href="#i-cube" /></svg></span> Byte</a><p class="muted" style="margin-top:14px;font-size:.88rem;line-height:1.6;">Build. Connect. Create Impact.</p></div>
        <div><h5>Quick Links</h5><ul><li><a href="/">Home</a></li><li><a href="/#about">About</a></li><li><a href="/events">Events</a></li><li><a href="/">Projects</a></li><li><a href="/">Contact</a></li></ul></div>
        <div><h5>Follow Us</h5><ul><li><a href="#">Instagram</a></li><li><a href="#">LinkedIn</a></li><li><a href="#">GitHub</a></li><li><a href="#">YouTube</a></li></ul></div>
        <div><h5>Contact Us</h5><ul><li><a href="#">byte.society@college.edu</a></li><li><a href="#">CSE Block, College Campus</a></li></ul></div>
      </div>
      <div class="footer-bottom"><span>© 2026 B.Y.T.E. All rights reserved.</span><a href="#" class="to-top"><svg width="16" height="16"><use href="#i-up" /></svg></a></div>
    </div>
  </footer>
)}

<style>
  @font-face {
    font-family: 'Clash Display';
    src: url('/portx/original/clash-600.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  .byte-footer { position: relative; min-height: clamp(560px, 48vw, 720px); overflow: hidden; padding: 0; border-top: 0; background: transparent; }
  .byte-footer-container { position: relative; isolation: isolate; width: 100%; min-height: inherit; overflow: hidden; }
  .byte-footer-spacer { position: absolute; inset: 0; width: 100%; overflow: visible; }
  .byte-footer-object { position: absolute; z-index: 1; top: -80px; right: 0; left: 0; height: calc(100% + 160px); overflow: hidden; }
  .byte-footer-glow { position: absolute; z-index: -1; left: 50%; bottom: -8%; width: min(88vw, 1280px); height: 58%; transform: translateX(-50%); border-radius: 50%; background: rgba(34, 197, 121, .31); filter: blur(112px); }
  .byte-pillars { width: 100%; height: 100%; display: block; transform: translateY(42px) scaleY(1.25); transform-origin: center bottom; }
  .pillar path { stroke: rgba(113, 134, 120, .27); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .pillar-accent path { stroke: rgba(117, 255, 184, .55); }
  .byte-footer-haze { position: absolute; inset: auto -8% -4%; height: 60%; background: rgba(11, 14, 12, .52); backdrop-filter: blur(28px); -webkit-backdrop-filter: blur(28px); mask-image: linear-gradient(to bottom, transparent, #000 30%); }
  .byte-footer-bottom { position: absolute; z-index: 3; right: clamp(20px, 5vw, 72px); bottom: 42px; left: clamp(20px, 5vw, 72px); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 34px; margin: 0; color: #f1f4ef; font-family: 'Clash Display', sans-serif; font-size: 24px; font-weight: 600; letter-spacing: -.03em; }
  .byte-footer-bottom p { margin: 0; }
  .byte-footer-bottom nav { display: flex; gap: 40px; justify-content: center; }
  .byte-footer-bottom a { color: inherit; text-transform: uppercase; transition: color 180ms ease; }
  .byte-footer-bottom a:hover { color: #52e0a6; }
  .byte-back-to-top { justify-self: end; mix-blend-mode: difference; }
  .afterburn-link { position: relative; display: inline-grid; place-items: center; width: 138px; height: 33px; margin-left: 5px; vertical-align: middle; color: #a3f4c6; text-decoration: none; }
  .afterburn-word { grid-area: 1 / 1; font-family: 'Clash Display', sans-serif; font-size: 22px; font-weight: 600; letter-spacing: -.055em; color: transparent; -webkit-text-stroke: .65px #9ff7c8; background: radial-gradient(circle at 1.2px 1.2px, #b3ffd8 0 1.2px, transparent 1.5px) 0 0 / 8px 8px, linear-gradient(125deg, transparent 44%, #52e0a6 45% 47%, transparent 48%) 0 0 / 13px 10px; background-clip: text; -webkit-background-clip: text; transition: opacity 220ms ease, transform 280ms cubic-bezier(.16,1,.3,1); }
  .afterburn-github { grid-area: 1 / 1; width: 32px; height: 32px; opacity: 0; transform: scale(.55) rotate(-24deg); transform-origin: center; transition: opacity 180ms ease, transform 280ms cubic-bezier(.16,1,.3,1); }
  .afterburn-link:hover .afterburn-word, .afterburn-link:focus-visible .afterburn-word { opacity: 0; transform: scale(.72) rotate(10deg); }
  .afterburn-link:hover .afterburn-github, .afterburn-link:focus-visible .afterburn-github { opacity: 1; transform: scale(1) rotate(0); }
  .afterburn-link:focus-visible { outline: 1px solid #52e0a6; outline-offset: 4px; border-radius: 2px; }
  @media (max-width: 810px) { .byte-footer-bottom { right: 40px; left: 40px; bottom: 38px; } }
  @media (max-width: 640px) {
    .byte-footer { min-height: 390px; }
    .byte-footer-bottom { right: 20px; bottom: 30px; left: 20px; font-size: 16px; letter-spacing: -.02em; }
    .afterburn-link { width: 104px; height: 24px; }
    .afterburn-word { font-size: 15px; }
    .afterburn-github { width: 24px; height: 24px; }
    .byte-footer-object { top: -58px; width: 690px; height: calc(100% + 116px); left: 50%; right: auto; transform: translateX(-50%); }
    .byte-footer-bottom { display: flex; flex-direction: column; gap: 24px; align-items: center; }
    .byte-footer-bottom nav { width: 100%; gap: 0; justify-content: space-between; order: -1; }
  }
  @media (prefers-reduced-motion: reduce) { .byte-footer-bottom a, .afterburn-word, .afterburn-github { transition: none; } }
</style>
