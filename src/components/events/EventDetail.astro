---
interface AgendaItem {
  time: string;
  title: string;
  detail?: string;
}

interface Props {
  name: string;
  type: string;
  date: string;
  time: string;
  venue: string;
  description: string;
  agenda: AgendaItem[];
  whoCanAttend: string[];
  ctaLabel?: string;
}

const {
  name,
  type,
  date,
  time,
  venue,
  description,
  agenda,
  whoCanAttend,
  ctaLabel = 'Register Now',
} = Astro.props;
---

<div class="page-header event-detail-header">
  <div class="wrap">
    <span class="type-pill">{type}</span>
    <h1>{name}</h1>
    <div class="event-meta-row">
      <span><svg><use href="#i-clock"/></svg>{date} &middot; {time}</span>
      <span><svg><use href="#i-pin"/></svg>{venue}</span>
    </div>
  </div>
</div>

<section>
  <div class="wrap event-detail-grid">
    <div class="event-detail-main">
      <h2>About this event</h2>
      <p class="event-description">{description}</p>

      <h2>Agenda &amp; Highlights</h2>
      <ol class="agenda-list">
        {agenda.map((item) => (
          <li>
            <span class="agenda-time">{item.time}</span>
            <div>
              <h4>{item.title}</h4>
              {item.detail && <p>{item.detail}</p>}
            </div>
          </li>
        ))}
      </ol>

      <h2>Who Can Attend</h2>
      <ul class="attend-list">
        {whoCanAttend.map((line) => (
          <li><svg><use href="#i-award"/></svg>{line}</li>
        ))}
      </ul>
    </div>

    <aside class="event-detail-side">
      <div class="register-card">
        <div class="date-chip lg"><b>{date.split(' ')[0]}</b><span>{date.split(' ')[1]}</span></div>
        <div class="meta-row">
          <span><svg><use href="#i-clock"/></svg>{time}</span>
          <span><svg><use href="#i-pin"/></svg>{venue}</span>
        </div>
        <button class="btn btn-primary register-btn">{ctaLabel}</button>
        <p class="register-note">Seats are limited — registration closes 24 hours before the event.</p>
      </div>
      <a href="/events" class="link-btn back-link"><svg><use href="#i-arrow"/></svg> Back to all events</a>
    </aside>
  </div>
</section>

<style>
  .event-detail-header .wrap { padding-top: 6px; }
  .type-pill {
    display: inline-block;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--lime);
    background: rgba(34, 197, 121, 0.1);
    border: 1px solid rgba(34, 197, 121, 0.35);
    border-radius: 999px;
    padding: 5px 14px;
    margin-bottom: 16px;
  }
  .event-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 16px;
  }
  .event-meta-row span {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    font-size: .9rem;
  }
  .event-meta-row svg { width: 15px; height: 15px; flex-shrink: 0; }

  .event-detail-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .event-detail-main h2 {
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .02em;
    margin: 40px 0 16px;
  }
  .event-detail-main h2:first-child { margin-top: 0; }
  .event-description {
    color: var(--text-dim);
    line-height: 1.75;
    font-size: .96rem;
  }

  .agenda-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .agenda-list li {
    display: flex;
    gap: 18px;
    padding: 16px 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .agenda-time {
    flex-shrink: 0;
    width: 92px;
    font-family: 'JetBrains Mono', monospace;
    font-size: .78rem;
    color: var(--lime);
    font-weight: 600;
  }
  .agenda-list h4 { font-size: .95rem; font-weight: 700; margin: 0 0 4px; }
  .agenda-list p { color: var(--text-faint); font-size: .85rem; margin: 0; line-height: 1.5; }

  .attend-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .attend-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--text-dim);
    font-size: .92rem;
  }
  .attend-list svg { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; color: var(--lime); }

  .event-detail-side { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 16px; }
  .register-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
  }
  .register-card .date-chip.lg { width: 64px; margin-bottom: 18px; }
  .register-card .date-chip.lg b { font-size: 1.6rem; }
  .register-card .meta-row { margin-bottom: 20px; }
  .register-btn { width: 100%; }
  .register-note { color: var(--text-faint); font-size: .78rem; margin: 14px 0 0; line-height: 1.5; }
  .back-link { justify-content: center; }

  @media (max-width: 900px) {
    .event-detail-grid { grid-template-columns: 1fr; gap: 32px; }
    .event-detail-side { position: static; }
  }
</style>
