---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);

const ctaLabel = data.ctaLabel ?? 'Register Now';
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const day = String(data.date.getUTCDate()).padStart(2, '0');
const month = MONTHS[data.date.getUTCMonth()];
const dateLabel = `${day} ${month}`;
---

<div class="page-header event-detail-header">
  <div class="wrap">
    <span class="type-pill">{data.type}</span>
    <h1>{data.name}</h1>
    <div class="event-meta-row">
      <span><svg><use href="#i-clock"/></svg>{dateLabel} &middot; {data.time}</span>
      <span><svg><use href="#i-pin"/></svg>{data.venue}</span>
    </div>
  </div>
</div>

{data.image && (
  <section class="event-hero-section">
    <div class="wrap">
      <figure class="hero-stage">
        <img src={data.image} alt={`${data.name} hero image`} fetchpriority="high" />
      </figure>
    </div>
  </section>
)}

<section>
  <div class="wrap event-detail-grid">
    <div class="event-detail-main">
      <h2>About this event</h2>
      <div class="event-description">
        <Content />
      </div>

      <h2>Agenda &amp; Highlights</h2>
      <ol class="agenda-list">
        {data.agenda.map((item) => (
          <li>
            <span class="agenda-time">{item.time}</span>
            <div>
              <h4>{item.title}</h4>
              {item.detail && <p>{item.detail}</p>}
            </div>
          </li>
        ))}
      </ol>

      <h2>Who Can Attend</h2>
      <ul class="attend-list">
        {data.whoCanAttend.map((line) => (
          <li><svg><use href="#i-award"/></svg>{line}</li>
        ))}
      </ul>
    </div>

    <aside class="event-detail-side">
      <div class="register-card">
        <div class="date-chip lg"><b>{day}</b><span>{month}</span></div>
        <div class="meta-row">
          <span><svg><use href="#i-clock"/></svg>{data.time}</span>
          <span><svg><use href="#i-pin"/></svg>{data.venue}</span>
        </div>
        {data.registration ? (
          <a href={data.registration} class="btn btn-primary register-btn" target="_blank" rel="noopener noreferrer">{ctaLabel}</a>
        ) : (
          <button class="btn btn-primary register-btn">{ctaLabel}</button>
        )}
        <p class="register-note">Seats are limited — registration closes 24 hours before the event.</p>
      </div>
      <a href="/events" class="link-btn back-link"><svg><use href="#i-arrow"/></svg> Back to all events</a>
    </aside>
  </div>
</section>

{data.gallery.length > 0 && (
  <section class="event-gallery-section">
    <div class="wrap">
      <h2>Event Gallery</h2>
      <div class={`masonry-grid ${data.gallery.length < 4 ? 'masonry-grid-sparse' : ''}`}>
        {data.gallery.map((imgUrl) => (
          <figure class="masonry-item">
            <img src={imgUrl} loading="lazy" alt={`${data.name} gallery image`} />
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .event-detail-header .wrap { padding-top: 6px; }
  .type-pill {
    display: inline-block;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--lime);
    background: rgba(34, 197, 121, 0.1);
    border: 1px solid rgba(34, 197, 121, 0.35);
    border-radius: 999px;
    padding: 5px 14px;
    margin-bottom: 16px;
  }
  .event-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 16px;
  }
  .event-meta-row span {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    font-size: .9rem;
  }
  .event-meta-row svg { width: 15px; height: 15px; flex-shrink: 0; }

  .event-detail-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .event-detail-main h2 {
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .02em;
    margin: 40px 0 16px;
  }
  .event-detail-main h2:first-child { margin-top: 0; }
  .event-description :global(p) {
    margin: 0;
    color: var(--text-dim);
    line-height: 1.75;
    font-size: .96rem;
  }
  .event-description :global(p + p) {
    margin-top: 1em;
  }

  .agenda-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .agenda-list li {
    display: flex;
    gap: 18px;
    padding: 16px 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .agenda-time {
    flex-shrink: 0;
    width: 92px;
    font-family: 'JetBrains Mono', monospace;
    font-size: .78rem;
    color: var(--lime);
    font-weight: 600;
  }
  .agenda-list h4 { font-size: .95rem; font-weight: 700; margin: 0 0 4px; }
  .agenda-list p { color: var(--text-faint); font-size: .85rem; margin: 0; line-height: 1.5; }

  .attend-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .attend-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--text-dim);
    font-size: .92rem;
  }
  .attend-list svg { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; color: var(--lime); }

  .event-detail-side { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 16px; }
  .register-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
  }
  .register-card .date-chip.lg { width: 64px; margin-bottom: 18px; }
  .register-card .date-chip.lg b { font-size: 1.6rem; }
  .register-card .meta-row { margin-bottom: 20px; }
  .register-btn { width: 100%; }
  .register-note { color: var(--text-faint); font-size: .78rem; margin: 14px 0 0; line-height: 1.5; }
  .back-link { justify-content: center; }

  /* Hero Section */
  .event-hero-section {
    padding-bottom: 56px;
  }
  .hero-stage {
    position: relative;
    width: 100%;
    height: clamp(300px, 45vw, 600px);
    margin: 0;
    overflow: hidden;
    border-radius: 20px;
    background: #171717;
  }
  .hero-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .05);
    border-radius: inherit;
  }
  .hero-stage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Pinterest-Style Masonry Gallery */
  .event-gallery-section {
    padding: 60px 0 120px;
    border-top: 1px solid var(--line);
    margin-top: 80px;
  }
  .event-gallery-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .02em;
    margin-bottom: 40px;
  }

  .masonry-grid {
    column-count: 3;
    column-gap: 24px;
    width: 100%;
  }

  /* Handle sparse galleries (1-3 images) differently */
  .masonry-grid-sparse {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    column-count: auto;
  }
  .masonry-grid-sparse .masonry-item {
    flex: 1 1 calc(50% - 12px);
    min-width: 280px;
    margin-bottom: 0;
  }
  /* Force images in sparse view to fill the flex container vertically */
  .masonry-grid-sparse .masonry-item img {
    height: 100%;
    object-fit: cover;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 24px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--panel);
    border: 1px solid rgba(82, 224, 166, 0.15);
    position: relative;
    transform: translateZ(0);
    display: inline-block;
    width: 100%;
  }

  @media (max-width: 900px) {
    .masonry-grid:not(.masonry-grid-sparse) {
      column-count: 2;
    }
    .event-detail-grid { grid-template-columns: 1fr; gap: 32px; }
    .event-detail-side { position: static; }
  }

  @media (max-width: 600px) {
    .masonry-grid:not(.masonry-grid-sparse) {
      column-count: 1;
    }
  }
  
  .masonry-item img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  
  .masonry-item:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 900px) {
    .event-detail-grid { grid-template-columns: 1fr; gap: 32px; }
    .event-detail-side { position: static; }
  }
</style>
