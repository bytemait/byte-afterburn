---
import type { TaskDepartment } from '../../data/tasks';

interface Props {
  dept: TaskDepartment;
}

const { dept } = Astro.props;
---

<div class="project-card">
  <div class="project-card-image">
    <img
      src={dept.image}
      alt={`${dept.department} preview`}
      loading="lazy"
    />
  </div>
  <div class="project-card-body">
    <h3>{dept.department}</h3>
    <div class="task-tagline">{dept.tagline}</div>
    <p class="task-desc">{dept.description}</p>
    <div class="project-meta">
      <span class="project-meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>{dept.estimatedTime}</span>
      </span>
      <span class="project-meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <span class="project-meta-tags">
          {dept.skills.map((skill) => (
            <span class="project-tag">{skill}</span>
          ))}
        </span>
      </span>
    </div>
    <div class="project-card-actions">
      <a href={`/tasks/${dept.slug}`} class="link-btn active-task-btn">
        View Tasks
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</div>

<style>
  .task-tagline {
    color: var(--lime);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: -4px 0 8px;
  }

  .task-desc {
    color: var(--text-dim);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0 0 14px;
  }

  .project-card-actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .active-task-btn {
    color: var(--lime-bright, #52e0a6);
    border-color: rgba(82, 224, 166, 0.3);
    background: rgba(82, 224, 166, 0.05);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .active-task-btn:hover {
    background: rgba(82, 224, 166, 0.15);
    border-color: var(--lime-bright, #52e0a6);
    color: #ffffff;
  }
</style>
