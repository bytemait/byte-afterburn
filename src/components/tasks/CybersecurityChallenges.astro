---
import type { TaskProblemStatement } from '../../data/tasks';

interface Props {
  tasks: TaskProblemStatement[];
}

const { tasks } = Astro.props;
---

<div class="challenges">
  {tasks.map((task, index) => (
    <article class="challenge" aria-labelledby={`security-task-${index + 1}`}>
      <p class="challenge-number">Task {String(index + 1).padStart(2, '0')}</p>
      <h3 id={`security-task-${index + 1}`}>{task.title.replace(/^Task \d+ — /, '')}</h3>
      <p class="challenge-description">{task.brief}</p>
      {task.id === 'sec-cryptography' && (
        <div class="challenge-prompt">
          <label for="crypto-challenge-value">Challenge text</label>
          <div class="copy-field">
            <button class="copy-button" type="button" data-copy-target="crypto-challenge-value" aria-label="Copy cryptography challenge text">Copy</button>
            <input id="crypto-challenge-value" type="text" value={task.concept} readonly />
          </div>
          <span class="copy-status" role="status" aria-live="polite"></span>
        </div>
      )}
      {task.id === 'sec-steganography' && task.referenceUrl && (
        <div class="challenge-prompt">
          <label for="stego-challenge-link">Challenge file link</label>
          <div class="copy-field">
            <button class="copy-button" type="button" data-copy-target="stego-challenge-link" aria-label="Copy steganography challenge link">Copy</button>
            <input id="stego-challenge-link" type="url" value={task.referenceUrl.url} readonly />
            <a class="open-link" href={task.referenceUrl.url} target="_blank" rel="noopener noreferrer" aria-label="Open steganography challenge file">↗</a>
          </div>
          <span class="copy-status" role="status" aria-live="polite"></span>
        </div>
      )}
      {task.id === 'sec-binary-exploitation' && (
        <>
          <div class="challenge-prompt"><span>Remote challenge endpoint</span><code>{task.concept}</code></div>
          <ul class="binary-steps">
            {task.requirements?.map((requirement) => <li>{requirement}</li>)}
          </ul>
        </>
      )}
      <p class="flag-format">Find the flag that is in the format <code>BYTE&#123;&#125;</code></p>
    </article>
  ))}
</div>

<script>
  const bindCopyButtons = () => {
    document.querySelectorAll<HTMLButtonElement>('.copy-button:not([data-bound])').forEach((button) => {
      button.dataset.bound = 'true';
      button.addEventListener('click', async () => {
        const targetId = button.dataset.copyTarget;
        const input = targetId ? document.getElementById(targetId) as HTMLInputElement | null : null;
        const status = button.closest('.challenge-prompt')?.querySelector<HTMLElement>('.copy-status');
        if (!input) return;

        let copied = false;
        try {
          await navigator.clipboard.writeText(input.value);
          copied = true;
        } catch {
          input.select();
          copied = document.execCommand('copy');
          input.setSelectionRange(0, 0);
        }

        if (status) status.textContent = copied ? 'Copied to clipboard' : 'Could not copy. Select the text to copy it manually.';
        button.textContent = copied ? 'Copied' : 'Copy';
        window.setTimeout(() => {
          button.textContent = 'Copy';
          if (status) status.textContent = '';
        }, 2200);
      });
    });
  };

  bindCopyButtons();
  document.addEventListener('astro:page-load', bindCopyButtons);
</script>

<style>
  .challenges { display: grid; gap: 16px; }
  .challenge {
    min-width: 0;
    padding: 24px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .challenge-number {
    margin: 0 0 8px;
    color: var(--lime-bright, #52e0a6);
    font: 700 .7rem/1.4 'JetBrains Mono', monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .challenge h3 { margin: 0 0 10px; font-size: 1.15rem; color: var(--text); }
  .challenge-description {
    margin: 0 0 18px;
    color: var(--text-dim);
    font-size: .86rem;
    line-height: 1.65;
  }
  .challenge-prompt { display: grid; gap: 8px; min-width: 0; }
  .challenge-prompt label,
  .challenge-prompt > span:first-child { color: var(--text-dim); font-size: .8rem; font-weight: 600; }
  .copy-field {
    display: flex;
    align-items: stretch;
    width: 100%;
    min-width: 0;
    min-height: 46px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg-soft);
    transition: border-color .16s ease;
  }
  .copy-field:focus-within { border-color: var(--lime-bright, #52e0a6); }
  .copy-button {
    flex: 0 0 auto;
    min-width: 74px;
    padding: 0 12px;
    border-right: 1px solid var(--line);
    background: rgba(82, 224, 166, .08);
    color: var(--lime-bright, #52e0a6);
    font-size: .78rem;
    font-weight: 700;
    transition: background .16s ease;
  }
  .copy-button:hover { background: rgba(82, 224, 166, .17); }
  .copy-button:focus-visible, .open-link:focus-visible {
    outline: 2px solid var(--lime-bright, #52e0a6);
    outline-offset: -3px;
  }
  .copy-field input {
    flex: 1 1 auto;
    width: 0;
    min-width: 0;
    margin: 0;
    padding: 0 14px;
    border: 0;
    background: transparent;
    color: var(--text);
    font: .82rem 'JetBrains Mono', monospace;
    text-overflow: ellipsis;
    cursor: text;
  }
  .copy-field input:focus { outline: none; text-overflow: clip; }
  .open-link {
    display: grid;
    place-items: center;
    flex: 0 0 46px;
    border-left: 1px solid var(--line);
    color: var(--lime-bright, #52e0a6);
    font-size: 1.1rem;
  }
  .open-link:hover { background: rgba(82, 224, 166, .1); }
  .copy-status {
    display: block;
    min-height: 1em;
    color: var(--lime-bright, #52e0a6);
    font-size: .7rem;
    line-height: 1.3;
  }
  .binary-steps {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    padding-left: 20px;
    color: var(--text-dim);
    font-size: .82rem;
    line-height: 1.6;
  }
  .binary-steps li::marker { color: var(--lime-bright, #52e0a6); }
  .flag-format {
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--text-dim);
    font-size: .78rem;
  }
  .flag-format code {
    color: var(--lime-bright, #52e0a6);
    font: 700 .8rem 'JetBrains Mono', monospace;
  }
  .challenge-prompt code {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 12px 14px;
    overflow-wrap: anywhere;
    color: var(--lime-bright, #52e0a6);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
    font: .85rem/1.55 'JetBrains Mono', monospace;
    user-select: text;
  }
  @media (max-width: 640px) {
    .challenge { padding: 20px 16px; }
    .copy-button { min-width: 64px; padding: 0 8px; }
    .copy-field input { font-size: .75rem; padding: 0 10px; }
    .open-link { flex-basis: 42px; }
  }
</style>
