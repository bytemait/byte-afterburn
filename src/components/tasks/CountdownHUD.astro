---
---

<div class="sticky-countdown-badge" id="stickyCountdown" role="timer" aria-label="Tasks reveal countdown">
  <div class="sticky-countdown-inner">
    <!-- FOUR CORNER RETICLES -->
    <span class="hud-corner top-left" aria-hidden="true"></span>
    <span class="hud-corner top-right" aria-hidden="true"></span>
    <span class="hud-corner bottom-left" aria-hidden="true"></span>
    <span class="hud-corner bottom-right" aria-hidden="true"></span>

    <!-- SUBTLE CONSTELLATION SVG -->
    <svg aria-hidden="true" class="hud-network" viewBox="0 0 160 80">
      <path d="M10 60 L45 25 L80 50 L120 18 L150 45" stroke="#52e0a6" stroke-width="1.2" stroke-opacity="0.3" fill="none" />
      <circle cx="10" cy="60" r="2" fill="#52e0a6" opacity="0.6"/>
      <circle cx="45" cy="25" r="2.5" fill="#52e0a6" opacity="0.8"/>
      <circle cx="80" cy="50" r="2" fill="#52e0a6" opacity="0.6"/>
      <circle cx="120" cy="18" r="2.5" fill="#52e0a6" opacity="0.9"/>
      <circle cx="150" cy="45" r="2" fill="#52e0a6" opacity="0.7"/>
    </svg>

    <div class="sticky-badge-header">
      <div class="header-status">
        <span class="sticky-live-dot" aria-hidden="true"></span>
        <span class="sticky-badge-label">REVEAL IN</span>
      </div>
      <span class="hud-mark" aria-hidden="true">
        <i/><i/><i/><i/>
      </span>
    </div>

    <div class="sticky-digits-row">
      <span class="sticky-digit" id="cdDays">00</span><span class="sticky-unit">d</span> <span class="sticky-sep">:</span>
      <span class="sticky-digit" id="cdHours">00</span><span class="sticky-unit">h</span> <span class="sticky-sep">:</span>
      <span class="sticky-digit" id="cdMins">00</span><span class="sticky-unit">m</span> <span class="sticky-sep">:</span>
      <span class="sticky-digit" id="cdSecs">00</span><span class="sticky-unit">s</span>
    </div>
  </div>
</div>

<script>
  import { TASK_CONFIG } from '../../data/tasks';

  function initStickyCountdown() {
    const daysEl = document.getElementById('cdDays');
    const hoursEl = document.getElementById('cdHours');
    const minsEl = document.getElementById('cdMins');
    const secsEl = document.getElementById('cdSecs');
    const badge = document.getElementById('stickyCountdown');

    // 1. Footer collision observer
    if (badge) {
      const footer = document.querySelector('.byte-footer');
      if (footer) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            badge.classList.toggle('is-over-footer', entry.isIntersecting);
          },
          { rootMargin: '0px 0px 90px' }
        );
        observer.observe(footer);
      }
    }

    // 2. Countdown calculation
    if (!daysEl) return;

    // Reveal target timestamp from centralized configuration
    const TARGET_TIME = TASK_CONFIG.revealTimestamp;

    function updateCountdown() {
      const now = Date.now();
      let diff = Math.max(0, TARGET_TIME - now);

      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      diff -= d * (1000 * 60 * 60 * 24);
      const h = Math.floor(diff / (1000 * 60 * 60));
      diff -= h * (1000 * 60 * 60);
      const m = Math.floor(diff / (1000 * 60));
      diff -= m * (1000 * 60);
      const s = Math.floor(diff / 1000);

      const pad = (n: number) => String(n).padStart(2, '0');

      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minsEl) minsEl.textContent = pad(m);
      if (secsEl) secsEl.textContent = pad(s);
    }

    updateCountdown();
    const interval = setInterval(updateCountdown, 1000);

    document.addEventListener(
      'astro:before-swap',
      () => clearInterval(interval),
      { once: true }
    );
  }

  initStickyCountdown();
  document.addEventListener('astro:page-load', initStickyCountdown);
</script>

<style>
  .sticky-countdown-badge {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 20;
    transform: translateZ(0);
    transition: bottom 420ms cubic-bezier(0.16, 1, 0.3, 1), transform 220ms ease;
  }

  .sticky-countdown-badge.is-over-footer {
    bottom: 88px;
  }

  .sticky-countdown-inner {
    position: relative;
    background: rgba(12, 16, 13, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(82, 224, 166, 0.38);
    border-radius: 12px;
    padding: 10px 14px 10px 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 16px rgba(82, 224, 166, 0.12);
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 185px;
    overflow: hidden;
  }

  /* HUD RETICLES */
  .hud-corner {
    position: absolute;
    width: 6px;
    height: 6px;
    pointer-events: none;
    z-index: 2;
  }

  .hud-corner.top-left {
    top: 4px;
    left: 4px;
    border-top: 1.5px solid var(--lime-bright, #52e0a6);
    border-left: 1.5px solid var(--lime-bright, #52e0a6);
  }

  .hud-corner.top-right {
    top: 4px;
    right: 4px;
    border-top: 1.5px solid var(--lime-bright, #52e0a6);
    border-right: 1.5px solid var(--lime-bright, #52e0a6);
  }

  .hud-corner.bottom-left {
    bottom: 4px;
    left: 4px;
    border-bottom: 1.5px solid var(--lime-bright, #52e0a6);
    border-left: 1.5px solid var(--lime-bright, #52e0a6);
  }

  .hud-corner.bottom-right {
    bottom: 4px;
    right: 4px;
    border-bottom: 1.5px solid var(--lime-bright, #52e0a6);
    border-right: 1.5px solid var(--lime-bright, #52e0a6);
  }

  .hud-network {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.5;
  }

  .sticky-badge-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .header-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .sticky-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime-bright, #52e0a6);
    box-shadow: 0 0 6px var(--lime-bright, #52e0a6);
    animation: livePulse 2s infinite;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .sticky-badge-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--text-dim, #a4b0a2);
    letter-spacing: 0.05em;
  }

  .hud-mark {
    width: 10px;
    height: 10px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5px;
    transform: rotate(45deg);
    color: var(--lime-bright, #52e0a6);
    opacity: 0.7;
  }

  .hud-mark i {
    display: block;
    border-radius: 0.5px;
    background: currentColor;
  }

  .sticky-digits-row {
    position: relative;
    z-index: 1;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.96rem;
    font-weight: 800;
    color: var(--lime-bright, #52e0a6);
    letter-spacing: 0.02em;
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .sticky-digit {
    font-variant-numeric: tabular-nums;
  }

  .sticky-unit {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-dim, #a4b0a2);
    margin-right: 2px;
  }

  .sticky-sep {
    color: var(--lime-dim, #1a9c5f);
    opacity: 0.7;
    margin: 0 1px;
  }

  @media (max-width: 809.98px) {
    .sticky-countdown-badge {
      right: 14px;
      bottom: 14px;
    }

    .sticky-countdown-badge.is-over-footer {
      bottom: 82px;
    }
  }
</style>
