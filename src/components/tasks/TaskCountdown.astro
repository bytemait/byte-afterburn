---
---

<div class="task-countdown-card" role="timer" aria-label="Task submission deadline countdown">
  <div class="countdown-main">
    <div class="countdown-info">
      <div class="countdown-badge">
        <span class="live-dot"></span>
        <span>Recruitment Active</span>
      </div>
      <h3 class="countdown-title">Submission Window Closes In</h3>
      <p class="countdown-subtitle">Complete your task and submit your repo + live demo before time expires.</p>
    </div>

    <div class="countdown-timer-wrap">
      <div class="timer-unit">
        <span class="timer-num" id="pageCdDays">03</span>
        <span class="timer-label">Days</span>
      </div>
      <span class="timer-sep">:</span>
      <div class="timer-unit">
        <span class="timer-num" id="pageCdHours">14</span>
        <span class="timer-label">Hours</span>
      </div>
      <span class="timer-sep">:</span>
      <div class="timer-unit">
        <span class="timer-num" id="pageCdMins">42</span>
        <span class="timer-label">Mins</span>
      </div>
      <span class="timer-sep">:</span>
      <div class="timer-unit">
        <span class="timer-num" id="pageCdSecs">18</span>
        <span class="timer-label">Secs</span>
      </div>
    </div>
  </div>

  <div class="countdown-footer">
    <div class="countdown-footer-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Deadline: <strong>Day 5 &bull; 11:59 PM IST</strong></span>
    </div>
    <div class="countdown-footer-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      <span>Deliverables: <strong>GitHub Repo + Hosted Demo / Output</strong></span>
    </div>
  </div>
</div>

<script>
  function initPageCountdown() {
    const daysEl = document.getElementById('pageCdDays');
    const hoursEl = document.getElementById('pageCdHours');
    const minsEl = document.getElementById('pageCdMins');
    const secsEl = document.getElementById('pageCdSecs');

    if (!daysEl) return;

    const TARGET_STORAGE_KEY = 'byte_tasks_target_v1';
    let targetTime = 0;
    try {
      const stored = localStorage.getItem(TARGET_STORAGE_KEY);
      if (stored && Number(stored) > Date.now()) {
        targetTime = Number(stored);
      } else {
        targetTime = Date.now() + (4 * 24 + 14) * 3600 * 1000 + 42 * 60 * 1000;
        localStorage.setItem(TARGET_STORAGE_KEY, String(targetTime));
      }
    } catch {
      targetTime = Date.now() + (4 * 24 + 14) * 3600 * 1000;
    }

    function updateTimer() {
      const now = Date.now();
      let diff = Math.max(0, targetTime - now);

      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      diff -= d * (1000 * 60 * 60 * 24);
      const h = Math.floor(diff / (1000 * 60 * 60));
      diff -= h * (1000 * 60 * 60);
      const m = Math.floor(diff / (1000 * 60));
      diff -= m * (1000 * 60);
      const s = Math.floor(diff / 1000);

      const pad = (n: number) => String(n).padStart(2, '0');

      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minsEl) minsEl.textContent = pad(m);
      if (secsEl) secsEl.textContent = pad(s);
    }

    updateTimer();
    const interval = setInterval(updateTimer, 1000);

    document.addEventListener(
      'astro:before-swap',
      () => clearInterval(interval),
      { once: true }
    );
  }

  initPageCountdown();
  document.addEventListener('astro:page-load', initPageCountdown);
</script>

<style>
  .task-countdown-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px 28px;
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .countdown-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .countdown-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 480px;
  }

  .countdown-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--lime);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    padding: 3px 8px;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    width: fit-content;
    margin-bottom: 4px;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 6px var(--lime);
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .countdown-title {
    font-family: 'Sora', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .countdown-subtitle {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin: 0;
    line-height: 1.45;
  }

  .countdown-timer-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    padding: 12px 18px;
    border-radius: 12px;
  }

  .timer-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 46px;
  }

  .timer-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--lime);
    line-height: 1.1;
  }

  .timer-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  .timer-sep {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .countdown-footer {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
  }

  .countdown-footer-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .countdown-footer-item svg {
    width: 14px;
    height: 14px;
    color: var(--lime);
    flex-shrink: 0;
  }

  .countdown-footer-item strong {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .task-countdown-card {
      padding: 18px 18px;
    }

    .countdown-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .countdown-timer-wrap {
      width: 100%;
      justify-content: space-around;
      padding: 10px 12px;
    }

    .timer-unit {
      min-width: 38px;
    }

    .timer-num {
      font-size: 1.25rem;
    }

    .countdown-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
