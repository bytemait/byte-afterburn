---
import { TASK_CONFIG } from '../../data/tasks';
---

<div class="task-countdown-box" role="region" aria-label="Task reveal countdown">
  <!-- CORNER RETICLES -->
  <span class="corner-reticle top-left" aria-hidden="true"></span>
  <span class="corner-reticle top-right" aria-hidden="true"></span>
  <span class="corner-reticle bottom-left" aria-hidden="true"></span>
  <span class="corner-reticle bottom-right" aria-hidden="true"></span>

  <!-- TOP CYBER TELEMETRY HEADER -->
  <div class="countdown-outer-header">
    <div class="header-tag-group">
      <span class="header-slash" aria-hidden="true">//</span>
      <span class="header-title">TASKS REVEAL COUNTDOWN</span>
      <span class="header-slash" aria-hidden="true">//</span>
    </div>
    <div class="header-meta-group">
      <span class="live-dot" aria-hidden="true"></span>
      <span class="header-target-time">{TASK_CONFIG.revealDateFull}</span>
    </div>
  </div>

  <!-- 4 TIMELINE-STYLE UNIT BOXES GRID -->
  <div class="countdown-inner-grid">
    <!-- DAYS -->
    <div class="unit-card">
      <span class="unit-reticle top-right" aria-hidden="true"></span>
      <span class="unit-reticle bottom-left" aria-hidden="true"></span>
      <div class="unit-fact-bar">
        <span class="unit-code">DAYS</span>
        <span class="unit-index">01</span>
      </div>
      <div class="unit-number-box">
        <span class="unit-giant-num" id="pageCdDays">00</span>
      </div>
      <div class="unit-bottom-accent">
        <div class="accent-track">
          <div class="accent-fill"></div>
        </div>
      </div>
    </div>

    <!-- HOURS -->
    <div class="unit-card">
      <span class="unit-reticle top-right" aria-hidden="true"></span>
      <span class="unit-reticle bottom-left" aria-hidden="true"></span>
      <div class="unit-fact-bar">
        <span class="unit-code">HOURS</span>
        <span class="unit-index">02</span>
      </div>
      <div class="unit-number-box">
        <span class="unit-giant-num" id="pageCdHours">00</span>
      </div>
      <div class="unit-bottom-accent">
        <div class="accent-track">
          <div class="accent-fill"></div>
        </div>
      </div>
    </div>

    <!-- MINUTES -->
    <div class="unit-card">
      <span class="unit-reticle top-right" aria-hidden="true"></span>
      <span class="unit-reticle bottom-left" aria-hidden="true"></span>
      <div class="unit-fact-bar">
        <span class="unit-code">MINUTES</span>
        <span class="unit-index">03</span>
      </div>
      <div class="unit-number-box">
        <span class="unit-giant-num" id="pageCdMins">00</span>
      </div>
      <div class="unit-bottom-accent">
        <div class="accent-track">
          <div class="accent-fill"></div>
        </div>
      </div>
    </div>

    <!-- SECONDS -->
    <div class="unit-card">
      <span class="unit-reticle top-right" aria-hidden="true"></span>
      <span class="unit-reticle bottom-left" aria-hidden="true"></span>
      <div class="unit-fact-bar">
        <span class="unit-code">SECONDS</span>
        <span class="unit-index">04</span>
      </div>
      <div class="unit-number-box">
        <span class="unit-giant-num" id="pageCdSecs">00</span>
      </div>
      <div class="unit-bottom-accent">
        <div class="accent-track">
          <div class="accent-fill"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { TASK_CONFIG } from '../../data/tasks';

  function initCountdown() {
    const daysEl = document.getElementById('pageCdDays');
    const hoursEl = document.getElementById('pageCdHours');
    const minsEl = document.getElementById('pageCdMins');
    const secsEl = document.getElementById('pageCdSecs');

    if (!daysEl) return;

    // Reveal target timestamp from centralized configuration
    const TARGET_TIME = TASK_CONFIG.revealTimestamp;
    const OVERRIDE_KEY = 'byte_tasks_lock_override';

    function isLocked() {
      const override = localStorage.getItem(OVERRIDE_KEY);
      if (override === 'unlocked') return false;
      if (override === 'locked') return true;
      return Date.now() < TARGET_TIME;
    }

    function applyLockState(locked: boolean) {
      if (locked) {
        document.documentElement.classList.add('tasks-locked');
        document.documentElement.classList.remove('tasks-unlocked');
      } else {
        document.documentElement.classList.remove('tasks-locked');
        document.documentElement.classList.add('tasks-unlocked');
      }
    }

    applyLockState(isLocked());

    window.addEventListener('byte:tasks-lock-change', ((e: CustomEvent) => {
      const locked = e.detail?.locked ?? isLocked();
      applyLockState(locked);
    }) as EventListener);

    function update() {
      const now = Date.now();
      let diff = Math.max(0, TARGET_TIME - now);

      if (diff === 0 && !localStorage.getItem(OVERRIDE_KEY)) {
        applyLockState(false);
      }

      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      diff -= d * (1000 * 60 * 60 * 24);
      const h = Math.floor(diff / (1000 * 60 * 60));
      diff -= h * (1000 * 60 * 60);
      const m = Math.floor(diff / (1000 * 60));
      diff -= m * (1000 * 60);
      const s = Math.floor(diff / 1000);

      const pad = (n: number) => String(n).padStart(2, '0');

      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minsEl) minsEl.textContent = pad(m);
      if (secsEl) secsEl.textContent = pad(s);
    }

    update();
    const interval = setInterval(update, 1000);

    document.addEventListener(
      'astro:before-swap',
      () => clearInterval(interval),
      { once: true }
    );
  }

  initCountdown();
  document.addEventListener('astro:page-load', initCountdown);
</script>

<style>
  .task-countdown-box {
    background: var(--panel, #171717);
    border: 1px solid var(--line, #292929);
    border-radius: 14px;
    padding: 16px 20px 18px;
    margin-bottom: 36px;
    position: relative;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  /* CORNER RETICLES */
  .corner-reticle {
    position: absolute;
    width: 8px;
    height: 8px;
    pointer-events: none;
    z-index: 2;
  }

  .corner-reticle.top-left {
    top: 6px;
    left: 6px;
    border-top: 2px solid var(--lime-bright, #52e0a6);
    border-left: 2px solid var(--lime-bright, #52e0a6);
  }

  .corner-reticle.top-right {
    top: 6px;
    right: 6px;
    border-top: 2px solid var(--lime-bright, #52e0a6);
    border-right: 2px solid var(--lime-bright, #52e0a6);
  }

  .corner-reticle.bottom-left {
    bottom: 6px;
    left: 6px;
    border-bottom: 2px solid var(--lime-bright, #52e0a6);
    border-left: 2px solid var(--lime-bright, #52e0a6);
  }

  .corner-reticle.bottom-right {
    bottom: 6px;
    right: 6px;
    border-bottom: 2px solid var(--lime-bright, #52e0a6);
    border-right: 2px solid var(--lime-bright, #52e0a6);
  }

  /* TOP HEADER */
  .countdown-outer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
  }

  .header-tag-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .header-slash {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--lime-bright, #52e0a6);
    user-select: none;
  }

  .header-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text, #ffffff);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .header-meta-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-dim, #a4b0a2);
    letter-spacing: 0.04em;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime-bright, #52e0a6);
    box-shadow: 0 0 6px var(--lime-bright, #52e0a6);
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* INNER 4-BOX GRID */
  .countdown-inner-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    width: 100%;
  }

  .unit-card {
    background: var(--bg-soft, #141414);
    border: 1px solid var(--line, #292929);
    border-radius: 8px;
    padding: 10px 12px 10px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .unit-card:hover {
    transform: translateY(-2px);
    background: #161c18;
    border-color: rgba(82, 224, 166, 0.4);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4), 0 0 14px rgba(82, 224, 166, 0.1);
  }

  /* UNIT RETICLES */
  .unit-reticle {
    position: absolute;
    width: 5px;
    height: 5px;
    pointer-events: none;
    z-index: 2;
    opacity: 0.45;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .unit-card:hover .unit-reticle {
    opacity: 0.9;
  }

  .unit-reticle.top-right {
    top: 4px;
    right: 4px;
    border-top: 1.5px solid var(--lime-bright, #52e0a6);
    border-right: 1.5px solid var(--lime-bright, #52e0a6);
  }

  .unit-reticle.bottom-left {
    bottom: 4px;
    left: 4px;
    border-bottom: 1.5px solid var(--lime-bright, #52e0a6);
    border-left: 1.5px solid var(--lime-bright, #52e0a6);
  }

  .unit-fact-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    width: 100%;
  }

  .unit-code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--text-dim, #a4b0a2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .unit-card:hover .unit-code {
    color: var(--lime-bright, #52e0a6);
  }

  .unit-index {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    font-weight: 700;
    color: var(--lime, #22c579);
    opacity: 0.75;
    letter-spacing: 0.04em;
  }

  .unit-number-box {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 0 6px;
  }

  .unit-giant-num {
    font-family: 'Clash Display', sans-serif;
    font-size: 34px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-feature-settings: 'tnum' on, 'zero' on;
    font-variant-numeric: tabular-nums;
    color: var(--lime-bright, #52e0a6);
    text-shadow: 0 0 16px rgba(82, 224, 166, 0.35);
    transition: color 0.2s ease;
  }

  .unit-card:hover .unit-giant-num {
    color: #7dffc4;
    text-shadow: 0 0 22px rgba(82, 224, 166, 0.5);
  }

  .unit-bottom-accent {
    margin-top: auto;
    padding-top: 4px;
  }

  .accent-track {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }

  .accent-fill {
    height: 100%;
    width: 100%;
    background: var(--lime-bright, #52e0a6);
    box-shadow: 0 0 6px var(--lime-bright, #52e0a6);
  }

  @media (max-width: 1024px) {
    .task-countdown-box {
      padding: 14px 16px 16px;
    }

    .countdown-inner-grid {
      gap: 10px;
    }

    .unit-card {
      padding: 9px 10px 8px;
    }

    .unit-giant-num {
      font-size: 30px;
    }
  }

  @media (max-width: 640px) {
    .task-countdown-box {
      padding: 14px 12px 14px;
    }

    .countdown-outer-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 10px;
      padding-bottom: 8px;
    }

    .countdown-inner-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .unit-card {
      padding: 8px 10px 8px;
    }

    .unit-giant-num {
      font-size: 26px;
    }

    .unit-number-box {
      padding: 6px 0 4px;
    }
  }
</style>
