---
import type { TaskDepartment } from '../../data/tasks';
import { taskDepartments, TASK_CONFIG } from '../../data/tasks';
import { getCollection } from 'astro:content';
import ProblemStatementCard from './ProblemStatementCard.astro';
import AppDevRoadmap from './AppDevRoadmap.astro';
import ElectronicsRosGuide from './ElectronicsRosGuide.astro';
import CybersecurityChallenges from './CybersecurityChallenges.astro';
import CybersecuritySubmission from './CybersecuritySubmission.astro';
import GraphicDesignSubmission from './GraphicDesignSubmission.astro';
import SubmissionProtocol from './SubmissionProtocol.astro';
import OtherDepartments from './OtherDepartments.astro';

interface Props {
  dept: TaskDepartment;
}

const { dept } = Astro.props;
const otherDepts = taskDepartments.filter((d) => d.slug !== dept.slug);
const contactIdsByDepartment: Record<string, string[]> = {
  'web-dev': ['khushi-dhankar', 'aditya-gupta'],
  'app-dev': ['khushi-dhankar', 'aditya-gupta'],
  cybersecurity: ['tejas-singh-kapur', 'shruti'],
  'ml-research': ['krishna-mudgal'],
  'agentic-ai': ['snow-sadh'],
  cad: ['devesh-dev'],
  electronics: ['devesh-dev'],
  ros: ['aditya-kumar-maurya'],
  'graphic-design': ['priyanka'],
  'video-editing': ['punya-arora'],
  outreach: ['chidroopa-kanaparthy']
};
const members = await getCollection('members');
const helpContacts = (contactIdsByDepartment[dept.slug] ?? [])
  .map((id) => members.find((member) => member.id === id))
  .filter((member) => member !== undefined);
---

<!-- PAGE HEADER -->
<div class="page-header project-detail-header">
  <div class="wrap">
    <div class="header-top-row">
      <span class="type-pill">Recruitment Task &bull; {dept.department}</span>
    </div>

    <h1>{dept.department} Tasks</h1>
    <div class="event-meta-row">
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Estimated: {dept.estimatedTime}
      </span>
      <span class="status-live-meta">
        <span class="live-dot"></span>
        <span class="lock-status-text">Status: Locked</span>
      </span>
    </div>
  </div>
</div>

<!-- MAIN TWO-COLUMN CONTENT GRID -->
<section class="dept-content-section">
  <div class="wrap event-detail-grid">

    <!-- LEFT MAIN COLUMN -->
    <div class="event-detail-main">
      {['ml-research', 'agentic-ai'].includes(dept.slug) && (
        <section class="year-guidance" aria-labelledby="year-guidance-title">
          <p class="year-guidance-eyebrow">ML Research / Agentic AI</p>
          <h2 id="year-guidance-title">Choose two tasks.</h2>
          <p class="year-guidance-intro">Pick any two of the four tasks across ML Research and Agentic AI. Your year determines the required difficulty combination:</p>
          <ol class="year-guidance-list">
            <li>
              <span class="year-guidance-number" aria-hidden="true">01</span>
              <div>
                <h3>First year <span>Any two tasks</span></h3>
                <p>Choose any two of the four tasks. You can pick both from the same track—for example, Basic and Advanced Agentic AI—or mix tracks and difficulty levels.</p>
              </div>
            </li>
            <li>
              <span class="year-guidance-number" aria-hidden="true">02</span>
              <div>
                <h3>Second year <span>At least one Advanced</span></h3>
                <p>Choose any two of the four tasks across both tracks. At least one of your choices must be Advanced.</p>
              </div>
            </li>
            <li>
              <span class="year-guidance-number" aria-hidden="true">03</span>
              <div>
                <h3>Third year <span>Both Advanced</span></h3>
                <p>Choose the Advanced task from ML Research and the Advanced task from Agentic AI.</p>
              </div>
            </li>
          </ol>
        </section>
      )}
      {['electronics', 'ros'].includes(dept.slug) && <ElectronicsRosGuide track={dept.slug as 'electronics' | 'ros'} />}
      {dept.slug === 'cybersecurity' && <CybersecuritySubmission />}
      <div class="project-story">
        {dept.slug === 'cad' && (
          <section class="cad-guidelines">
            <p class="domain-guidance-eyebrow">CAD submission requirements</p>
            <h2>One folder. Both CAD tasks.</h2>
            <p>Submit one Google Drive folder link through the website upload form. Your name, roll number, and department are already captured at login; use your name only in the folder name: <code>&lt;YourName&gt;_CAD</code>.</p>
            <div class="cad-sharing-note">
              <strong>Mandatory sharing permission</strong>
              <span>Anyone with the link — Viewer</span>
              <p>Restricted or login-required links count as not submitted. Test the folder from an incognito window before submitting.</p>
            </div>
            <h3>Required folder structure</h3>
            <pre class="cad-folder-tree"><code>&lt;YourName&gt;_CAD/\n├── Task1/\n│   ├── Task1.stl (or Task1.step)\n│   └── Design_rationale.docx\n└── Task2/ (if attempted)\n    ├── Task2.step\n    ├── Demo.mp4 (or Demo.gif / labeled screenshots)\n    └── Design_rationale.docx</code></pre>
            <h3>Choose tasks by year</h3>
            <ol class="domain-year-rules">
              <li><strong>1st year:</strong> Complete at least CAD Task 1.</li>
              <li><strong>2nd year:</strong> Complete CAD Tasks 1 and 2.</li>
            </ol>
            <ul class="cad-checklist">
              <li>Use the exact file names shown so submissions can be processed correctly.</li>
              <li>Task 1 model: Task1.stl or Task1.step. Rationale: 150–250 words on board arrangement, standoff heights, wall height, lid mechanism and tradeoffs.</li>
              <li>Task 2: preserve joints/mates in Task2.step. Demonstrate motion at 0°, 90°, 180°, and 270° without interference/binding, using video/GIF or labeled screenshots. Rationale: 150–250 words on dimensions, joints, and interference checks.</li>
              <li>Use only official component drawings. Models should be printable in principle, with reasonable wall thickness and no unsupported overhangs; printing is not required.</li>
              <li>Task 1 is required for shortlisting. Task 2 is optional and adds bonus weight.</li>
            </ul>
          </section>
        )}
        {!['app-dev', 'ml-research', 'agentic-ai', 'cad', 'electronics', 'ros', 'cybersecurity', 'graphic-design', 'video-editing', 'outreach'].includes(dept.slug) && (
          <section>
            <h2>Evaluation Criteria</h2>
            <p>What our domain leads look for during code reviews and technical interview walkthroughs:</p>
            <ul class="attend-list eval-criteria-list">
              {dept.evaluationCriteria.map((criterion) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{criterion}</span>
                </li>
              ))}
            </ul>
          </section>
        )}


        <section class="problem-statements-wrapper">
          {dept.slug !== 'app-dev' && dept.slug !== 'cybersecurity' && (
            <>
              <h2>{dept.slug === 'electronics' ? 'Electronics tasks' : dept.slug === 'ros' ? 'ROS task' : 'Problem Statements'}</h2>
              <p>{dept.slug === 'electronics' ? 'Start with Task 1. Task 2 adds weight to your submission; Task 3 is an optional X-factor bonus.' : dept.slug === 'ros' ? 'Build and demonstrate the patrol package described below.' : 'Read through the problem statements below and follow the requirements for your chosen task.'}</p>
            </>
          )}

          <!-- B.Y.T.E. CYBER LOCK GATE -->
          <div class="task-lock-gate" id="taskLockGate">
            <!-- FOUR CORNER BRACKET RETICLES -->
            <span class="gate-corner top-left" aria-hidden="true"></span>
            <span class="gate-corner top-right" aria-hidden="true"></span>
            <span class="gate-corner bottom-left" aria-hidden="true"></span>
            <span class="gate-corner bottom-right" aria-hidden="true"></span>

            <!-- CONSTELLATION NETWORK WIREFRAME SVG -->
            <svg aria-hidden="true" class="gate-network" viewBox="0 0 700 240">
              <defs>
                <linearGradient id="gateNetGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#52e0a6" stop-opacity="0.3"/>
                  <stop offset="50%" stop-color="#52e0a6" stop-opacity="0.08"/>
                  <stop offset="100%" stop-color="#52e0a6" stop-opacity="0.25"/>
                </linearGradient>
              </defs>
              <path d="M20,170 L110,80 L220,140 L350,55 L480,120 L590,40 L670,160 M110,80 L260,40 L480,120 M220,140 L380,190 L590,40" stroke="url(#gateNetGrad)" stroke-width="1.2" fill="none" />
              <circle cx="20" cy="170" r="3" fill="#52e0a6" opacity="0.6"/>
              <circle cx="110" cy="80" r="3.5" fill="#52e0a6" opacity="0.85"/>
              <circle cx="220" cy="140" r="3" fill="#52e0a6" opacity="0.6"/>
              <circle cx="260" cy="40" r="2.5" fill="#52e0a6" opacity="0.5"/>
              <circle cx="350" cy="55" r="4" fill="#52e0a6" opacity="0.95"/>
              <circle cx="380" cy="190" r="3" fill="#52e0a6" opacity="0.6"/>
              <circle cx="480" cy="120" r="3.5" fill="#52e0a6" opacity="0.8"/>
              <circle cx="590" cy="40" r="3" fill="#52e0a6" opacity="0.75"/>
              <circle cx="670" cy="160" r="3.5" fill="#52e0a6" opacity="0.7"/>
            </svg>

            <div class="gate-card">
              <div class="gate-telemetry-pill">
                <span class="gate-live-dot" aria-hidden="true"></span>
                <span class="telemetry-label">// ACCESS LOCKED //</span>
              </div>

              <div class="gate-icon-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </div>

              <div class="gate-header-block">
                <h3 class="gate-title">Problem Statements Locked</h3>
                <p class="gate-desc">
                  Tasks for <strong>{dept.department}</strong> will be revealed on <strong>{TASK_CONFIG.revealDateFull}</strong>.
                </p>
              </div>

              <!-- CLASH DISPLAY CYBER COUNTDOWN -->
              <div class="gate-countdown-grid" role="timer" aria-live="polite">
                <div class="gate-cd-box">
                  <span class="cd-num" id="gateCdDays">00</span>
                  <span class="cd-label">// DAYS //</span>
                </div>
                <span class="cd-colon" aria-hidden="true">:</span>
                <div class="gate-cd-box">
                  <span class="cd-num" id="gateCdHours">00</span>
                  <span class="cd-label">// HOURS //</span>
                </div>
                <span class="cd-colon" aria-hidden="true">:</span>
                <div class="gate-cd-box">
                  <span class="cd-num" id="gateCdMins">00</span>
                  <span class="cd-label">// MINS //</span>
                </div>
                <span class="cd-colon" aria-hidden="true">:</span>
                <div class="gate-cd-box">
                  <span class="cd-num" id="gateCdSecs">00</span>
                  <span class="cd-label">// SECS //</span>
                </div>
              </div>

              <p class="gate-hint">
                Review the submission instructions while you wait for the tasks to unlock.
              </p>
            </div>
          </div>

          <!-- ACTUAL PROBLEM STATEMENT STACK (SMOOTH REVEAL) -->
          <div class="tasks-stack" id="tasksStackContainer">
            {dept.slug === 'app-dev' ? (
              <AppDevRoadmap task={dept.tasks[0]} />
            ) : dept.slug === 'cybersecurity' ? (
              <CybersecurityChallenges tasks={dept.tasks} />
            ) : (
              dept.tasks.map((task) => <ProblemStatementCard task={task} />)
            )}
          </div>
        </section>

        <!-- SUBMISSION PROTOCOL -->
        {!['app-dev', 'cad', 'electronics', 'ros', 'cybersecurity', 'graphic-design'].includes(dept.slug) && (
          <section>
            <SubmissionProtocol />
          </section>
        )}
      </div>
      {dept.slug === 'graphic-design' && <GraphicDesignSubmission />}
    </div>

    <!-- RIGHT STICKY SIDEBAR -->
    <aside class="event-detail-side">
      <!-- TASK SUPPORT CONTACTS -->
      <div class="register-card contacts-card">
        <div class="tech-stack-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <h3>Need a hand?</h3>
        </div>
        <p class="contacts-intro">Reach out to {dept.slug === 'electronics' ? 'an Electronics' : `a ${dept.department}`} lead for help with your task.</p>
        <ul class="tech-stack-list">
          {helpContacts.map((contact) => (
            <li class="contact-item">
              <span class="contact-initials" aria-hidden="true">{(contact.data.short || contact.data.name.slice(0, 1)).slice(0, 2)}</span>
              <div>
                <a class="tech-name contact-name" href={`/members/${contact.id}/`}>{contact.data.name}</a>
                <span class="contact-role">{contact.data.role}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- SUBMISSION ACTION CARD -->
      <div class="register-card submit-sidebar-card">
        <div class="submit-card-content">
          <div class="submit-card-badge">
            <span class="live-dot"></span>
            <span>Submission Window</span>
          </div>
          <h3>Ready to Submit?</h3>
          <p>{dept.slug === 'cad' ? 'Submit one Google Drive folder link containing your CAD task files through the website upload form.' : dept.slug === 'electronics' ? 'Submit one Electronics-only Google Drive folder link through the website upload form.' : dept.slug === 'ros' ? 'Submit one separate ROS-only Google Drive folder link through the website upload form.' : dept.slug === 'cybersecurity' ? 'Submit a public GitHub repository and a public Google Doc explaining your approach and tools.' : ['graphic-design', 'video-editing', 'outreach'].includes(dept.slug) ? 'Submit your work using the format in the task instructions. Make sure all shared links are publicly accessible.' : 'Submit your GitHub repository, README, and live demo output link before the window closes.'}</p>
          <div class="side-deadline-tag">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Portal opens {TASK_CONFIG.submissionOpenShort}</span>
          </div>
          <div class="submission-countdown" role="timer" aria-label="Submission portal opening countdown">
            <div><strong id="submitCdDays">00</strong><span>Days</span></div>
            <div><strong id="submitCdHours">00</strong><span>Hours</span></div>
            <div><strong id="submitCdMins">00</strong><span>Minutes</span></div>
            <div><strong id="submitCdSecs">00</strong><span>Seconds</span></div>
          </div>
        </div>
      </div>

      <!-- DISCORD MENTOR SUPPORT LINK -->
      <a href={TASK_CONFIG.discordUrl} class="github-project-link discord-sidebar-link" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6h0a14.5 14.5 0 0 0-4-1.5 9.8 9.8 0 0 0-.4 1.8 13.9 13.9 0 0 0-3.2 0 9.8 9.8 0 0 0-.4-1.8A14.5 14.5 0 0 0 6 6a15.8 15.8 0 0 0-2.4 9.7 14.4 14.4 0 0 0 4.5 2.3 10.3 10.3 0 0 0 1-1.6 9.3 9.3 0 0 1-1.5-.7c.1-.1.3-.2.4-.3a10.6 10.6 0 0 0 8 0c.1.1.3.2.4.3a9.3 9.3 0 0 1-1.5.7 10.3 10.3 0 0 0 1 1.6 14.4 14.4 0 0 0 4.5-2.3A15.8 15.8 0 0 0 18 6Z"/><path d="M9.5 11.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/><path d="M14.5 11.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/></svg>
        <span>Ask in Discord (#recruitment)</span>
        <svg class="external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>

      <!-- BACK TO ALL TASKS LINK -->
      <a href="/tasks" class="link-btn back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to all tasks
      </a>
    </aside>

  </div>
</section>

<!-- OTHER DEPARTMENTS -->
<section class="other-depts-wrap-section">
  <div class="wrap">
    <OtherDepartments otherDepts={otherDepts} />
  </div>
</section>

<script>
  import { TASK_CONFIG } from '../../data/tasks';

  function initSubmissionCountdown() {
    const daysEl = document.getElementById('submitCdDays');
    const hoursEl = document.getElementById('submitCdHours');
    const minsEl = document.getElementById('submitCdMins');
    const secsEl = document.getElementById('submitCdSecs');
    if (!daysEl) return;

    const update = () => {
      let diff = Math.max(0, TASK_CONFIG.submissionOpenTimestamp - Date.now());
      const days = Math.floor(diff / 86400000);
      diff -= days * 86400000;
      const hours = Math.floor(diff / 3600000);
      diff -= hours * 3600000;
      const minutes = Math.floor(diff / 60000);
      diff -= minutes * 60000;
      const seconds = Math.floor(diff / 1000);
      const pad = (value: number) => String(value).padStart(2, '0');
      daysEl.textContent = pad(days);
      if (hoursEl) hoursEl.textContent = pad(hours);
      if (minsEl) minsEl.textContent = pad(minutes);
      if (secsEl) secsEl.textContent = pad(seconds);
    };

    update();
    const interval = setInterval(update, 1000);
    document.addEventListener('astro:before-swap', () => clearInterval(interval), { once: true });
  }

  initSubmissionCountdown();
  document.addEventListener('astro:page-load', initSubmissionCountdown);

  function initDetailLock() {
    const daysEl = document.getElementById('gateCdDays');
    const hoursEl = document.getElementById('gateCdHours');
    const minsEl = document.getElementById('gateCdMins');
    const secsEl = document.getElementById('gateCdSecs');

    const TARGET_TIME = TASK_CONFIG.revealTimestamp;
    const OVERRIDE_KEY = 'byte_tasks_lock_override';

    function isLocked() {
      const override = localStorage.getItem(OVERRIDE_KEY);
      if (override === 'unlocked') return false;
      if (override === 'locked') return true;
      return Date.now() < TARGET_TIME;
    }

    function applyLockState(locked: boolean) {
      const statusTextEl = document.querySelector('.lock-status-text');
      if (locked) {
        document.documentElement.classList.add('tasks-locked');
        document.documentElement.classList.remove('tasks-unlocked');
        if (statusTextEl) statusTextEl.textContent = 'Status: Locked';
      } else {
        document.documentElement.classList.remove('tasks-locked');
        document.documentElement.classList.add('tasks-unlocked');
        if (statusTextEl) statusTextEl.textContent = 'Status: Unlocked';
      }
    }

    applyLockState(isLocked());

    // Listen to global lock changes
    window.addEventListener('byte:tasks-lock-change', ((e: CustomEvent) => {
      const locked = e.detail?.locked ?? isLocked();
      applyLockState(locked);
    }) as EventListener);

    // Gate countdown calculation
    function updateGateTimer() {
      if (!daysEl) return;
      const now = Date.now();
      let diff = Math.max(0, TARGET_TIME - now);

      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      diff -= d * (1000 * 60 * 60 * 24);
      const h = Math.floor(diff / (1000 * 60 * 60));
      diff -= h * (1000 * 60 * 60);
      const m = Math.floor(diff / (1000 * 60));
      diff -= m * (1000 * 60);
      const s = Math.floor(diff / 1000);

      const pad = (n: number) => String(n).padStart(2, '0');
      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minsEl) minsEl.textContent = pad(m);
      if (secsEl) secsEl.textContent = pad(s);
    }

    updateGateTimer();
    const interval = setInterval(updateGateTimer, 1000);

    document.addEventListener(
      'astro:before-swap',
      () => clearInterval(interval),
      { once: true }
    );
  }

  initDetailLock();
  document.addEventListener('astro:page-load', initDetailLock);
</script>

<style>
  .project-detail-header {
    padding-bottom: 24px;
  }

  .project-detail-header .wrap { padding-top: 6px; }

  .header-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .type-pill {
    display: inline-block;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--lime);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 14px;
    margin: 0;
  }

  .project-detail-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }

  .event-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 16px;
  }

  .event-meta-row span {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    font-size: .9rem;
  }

  .event-meta-row svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    color: var(--lime);
  }

  .status-live-meta {
    color: var(--text-dim) !important;
    font-weight: 600;
  }

  :global(html.tasks-unlocked) .status-live-meta {
    color: var(--lime-bright, #52e0a6) !important;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime-dim, #1a9c5f);
    box-shadow: 0 0 6px var(--lime-dim, #1a9c5f);
  }

  :global(html.tasks-unlocked) .live-dot {
    background: var(--lime-bright, #52e0a6);
    box-shadow: 0 0 6px var(--lime-bright, #52e0a6);
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* TWO-COLUMN GRID */
  .dept-content-section {
    padding-top: 28px;
    padding-bottom: 72px;
  }

  .event-detail-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .event-detail-main h2 {
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .02em;
    margin: 40px 0 16px;
    color: var(--text);
  }

  .event-detail-main h2:first-child {
    margin-top: 0;
  }

  .event-description {
    color: var(--text-dim);
    line-height: 1.75;
    font-size: .96rem;
    margin: 0;
  }

  .project-story p {
    color: var(--text-dim);
    line-height: 1.75;
    font-size: .96rem;
    margin: 0 0 16px;
  }

  .project-story section {
    padding: 40px 0 0;
  }

  .project-story h2 {
