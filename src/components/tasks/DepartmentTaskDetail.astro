---
import type { TaskDepartment } from '../../data/tasks';
import { taskDepartments } from '../../data/tasks';
import { getTechLogo } from '../../data/tech-logos';
import ProblemStatementCard from './ProblemStatementCard.astro';
import SubmissionProtocol from './SubmissionProtocol.astro';
import OtherDepartments from './OtherDepartments.astro';

interface Props {
  dept: TaskDepartment;
}

const { dept } = Astro.props;
const otherDepts = taskDepartments.filter((d) => d.slug !== dept.slug);
---

<!-- PAGE HEADER (MIRRORS ProjectDetail.astro) -->
<div class="page-header project-detail-header">
  <div class="wrap">
    <span class="type-pill">Recruitment Task &bull; {dept.department}</span>
    <h1>{dept.department} Tasks</h1>
    <div class="event-meta-row">
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Estimated: {dept.estimatedTime}
      </span>
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Deadline: Day 5 &bull; 11:59 PM IST
      </span>
      <span class="status-live-meta">
        <span class="live-dot"></span>
        Recruitment Active
      </span>
    </div>
  </div>
</div>

<!-- HERO BANNER -->
{dept.image && (
  <section class="event-hero-section">
    <div class="wrap">
      <figure class="hero-stage">
        <img
          src={dept.image}
          alt={`${dept.department} — Recruitment Task Banner`}
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>
)}

<!-- MAIN TWO-COLUMN CONTENT GRID -->
<section class="dept-content-section">
  <div class="wrap event-detail-grid">

    <!-- LEFT MAIN COLUMN -->
    <div class="event-detail-main">
      <h2>About this Department</h2>
      <p class="event-description">{dept.description}</p>

      <div class="project-story">
        <!-- EVALUATION CRITERIA -->
        <section>
          <h2>Evaluation Criteria</h2>
          <p>What our domain leads look for during code reviews and technical interview walkthroughs:</p>
          <ul class="attend-list eval-criteria-list">
            {dept.evaluationCriteria.map((criterion) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{criterion}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- PROBLEM STATEMENTS -->
        <section>
          <h2>Problem Statements</h2>
          <p>Read through the problem statement below. Fulfill the core requirements and follow the mandatory engineering stages.</p>

          <div class="tasks-stack">
            {dept.tasks.map((task) => (
              <ProblemStatementCard task={task} />
            ))}
          </div>
        </section>

        <!-- SUBMISSION PROTOCOL -->
        <section>
          <SubmissionProtocol />
        </section>
      </div>
    </div>

    <!-- RIGHT STICKY SIDEBAR -->
    <aside class="event-detail-side">
      <!-- TECH STACK CARD -->
      <div class="register-card tech-stack-card">
        <div class="tech-stack-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <h3>Tech Stack</h3>
        </div>
        <ul class="tech-stack-list">
          {dept.skills.map((techName) => {
            const logoUrl = getTechLogo(techName);
            return (
              <li class="tech-stack-item">
                {logoUrl ? (
                  <img src={logoUrl} alt={techName} class="tech-logo" width="28" height="28" loading="lazy" />
                ) : (
                  <span class="tech-logo-fallback" aria-hidden="true">
                    {techName.charAt(0).toUpperCase()}
                  </span>
                )}
                <span class="tech-name">{techName}</span>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- SUBMISSION ACTION CARD -->
      <div class="register-card submit-sidebar-card">
        <div class="submit-card-content">
          <div class="submit-card-badge">
            <span class="live-dot"></span>
            <span>Active Submission</span>
          </div>
          <h3>Ready to Submit?</h3>
          <p>Submit your GitHub repository, README, and live demo output link before the window closes.</p>
          <div class="side-deadline-tag">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Day 5 &bull; 11:59 PM IST</span>
          </div>
        </div>
        <a href="https://forms.gle" target="_blank" rel="noopener noreferrer" class="btn btn-primary submit-full-btn">
          Open Submission Form
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>

      <!-- DISCORD MENTOR SUPPORT LINK -->
      <a href="https://discord.gg/HNYhA4Ww5" class="github-project-link discord-sidebar-link" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6h0a14.5 14.5 0 0 0-4-1.5 9.8 9.8 0 0 0-.4 1.8 13.9 13.9 0 0 0-3.2 0 9.8 9.8 0 0 0-.4-1.8A14.5 14.5 0 0 0 6 6a15.8 15.8 0 0 0-2.4 9.7 14.4 14.4 0 0 0 4.5 2.3 10.3 10.3 0 0 0 1-1.6 9.3 9.3 0 0 1-1.5-.7c.1-.1.3-.2.4-.3a10.6 10.6 0 0 0 8 0c.1.1.3.2.4.3a9.3 9.3 0 0 1-1.5.7 10.3 10.3 0 0 0 1 1.6 14.4 14.4 0 0 0 4.5-2.3A15.8 15.8 0 0 0 18 6Z"/><path d="M9.5 11.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/><path d="M14.5 11.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/></svg>
        <span>Ask in Discord (#recruitment)</span>
        <svg class="external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>

      <!-- BACK TO ALL TASKS LINK -->
      <a href="/tasks" class="link-btn back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to all tasks
      </a>
    </aside>

  </div>
</section>

<!-- OTHER DEPARTMENTS -->
<section class="other-depts-wrap-section">
  <div class="wrap">
    <OtherDepartments otherDepts={otherDepts} />
  </div>
</section>

<style>
  .project-detail-header .wrap { padding-top: 6px; }

  .type-pill {
    display: inline-block;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--lime);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 14px;
    margin-bottom: 16px;
  }

  .project-detail-header h1 {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }

  .event-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 16px;
  }

  .event-meta-row span {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    font-size: .9rem;
  }

  .event-meta-row svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    color: var(--lime);
  }

  .status-live-meta {
    color: var(--lime) !important;
    font-weight: 600;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 6px var(--lime);
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* HERO SECTION */
  .event-hero-section {
    padding-bottom: 48px;
  }

  .hero-stage {
    position: relative;
    width: 100%;
    height: clamp(260px, 32vw, 420px);
    margin: 0;
    overflow: hidden;
    border-radius: 16px;
    background: var(--panel);
    border: 1px solid var(--line);
  }

  .hero-stage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* TWO-COLUMN GRID */
  .dept-content-section {
    padding-bottom: 72px;
  }

  .event-detail-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .event-detail-main h2 {
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .02em;
    margin: 40px 0 16px;
    color: var(--text);
  }

  .event-detail-main h2:first-child {
    margin-top: 0;
  }

  .event-description {
    color: var(--text-dim);
    line-height: 1.75;
    font-size: .96rem;
    margin: 0;
  }

  .project-story p {
    color: var(--text-dim);
    line-height: 1.75;
    font-size: .96rem;
    margin: 0 0 16px;
  }

  .project-story section {
    padding: 40px 0 0;
  }

  .project-story h2 {
    margin: 0 0 16px;
  }

  .eval-criteria-list {
    margin-top: 18px;
  }

  .attend-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .attend-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--text-dim);
    font-size: .92rem;
    line-height: 1.55;
  }

  .attend-list svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--lime);
  }

  .tasks-stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 20px;
  }

  /* SIDEBAR */
  .event-detail-side {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .register-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px;
  }

  /* TECH STACK CARD */
  .tech-stack-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .tech-stack-header svg {
    width: 20px;
    height: 20px;
    color: var(--lime);
    flex-shrink: 0;
  }

  .tech-stack-header h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .02em;
    color: var(--text);
  }

  .tech-stack-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tech-stack-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    transition: border-color .15s ease, transform .15s ease;
  }

  .tech-stack-item:hover {
    border-color: #2a3d2c;
    transform: translateX(4px);
  }

  .tech-logo {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 4px;
    object-fit: contain;
  }

  .tech-logo-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 4px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    color: var(--lime);
    font-size: .75rem;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
  }

  .tech-name {
    font-size: .88rem;
    font-weight: 600;
    color: var(--text);
  }

  /* SUBMISSION CARD */
  .submit-sidebar-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .submit-card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .submit-card-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--lime);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    width: fit-content;
  }

  .submit-card-content h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    margin: 4px 0 0;
  }

  .submit-card-content p {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-dim);
    margin: 0;
  }

  .side-deadline-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    color: var(--lime);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    padding: 4px 10px;
    border-radius: 6px;
    margin-top: 4px;
    width: fit-content;
  }

  .side-deadline-tag svg {
    width: 13px;
    height: 13px;
  }

  .submit-full-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 700;
  }

  .submit-full-btn svg {
    width: 15px;
    height: 15px;
  }

  /* DISCORD & BACK BUTTONS */
  .github-project-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text);
    background: var(--panel);
    font-size: .88rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color .15s ease, color .15s ease, transform .15s ease;
  }

  .github-project-link:hover {
    border-color: #2a3d2c;
    color: var(--lime);
    transform: translateY(-2px);
  }

  .discord-sidebar-link svg:first-child {
    width: 18px;
    height: 18px;
    color: var(--lime);
    flex-shrink: 0;
  }

  .discord-sidebar-link .external-icon {
    width: 14px;
    height: 14px;
    margin-left: auto;
    color: var(--text-dim);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 10px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--lime);
  }

  .back-link svg {
    width: 16px;
    height: 16px;
  }

  .other-depts-wrap-section {
    padding: 56px 0 96px;
  }

  @media (max-width: 900px) {
    .event-detail-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .event-detail-side {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .project-detail-header h1 {
      font-size: 1.8rem;
    }

    .hero-stage {
      height: clamp(200px, 50vw, 300px);
    }
  }
</style>
