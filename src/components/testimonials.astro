---
// Exact copy from the spec — do not reword.
const testimonials = [
  {
    label: 'Finding a place to build',
    quote:
      'I joined B.Y.T.E. thinking I would just learn a few new technologies. I ended up finding people who were just as curious, ambitious, and obsessed with building things as I was. Somewhere along the way, projects stopped feeling like assignments and started feeling like possibilities.',
    author: 'Student Member',
  },
  {
    label: 'From idea to reality',
    quote:
      'The best part about B.Y.T.E. is that nobody tells you your idea is too ambitious. Instead, someone asks, \u201cSo, how are we going to build it?\u201d That mindset completely changed the way I approach technology—and even the way I approach problems outside it.',
    author: 'Core Team Member',
  },
  {
    label: 'Beyond tutorials',
    quote:
      "There's a huge difference between watching someone build something and actually building it yourself. B.Y.T.E. gave me that transition. The late-night debugging, the failed experiments, the tiny victories—they taught me more than any tutorial ever could.",
    author: 'Developer, B.Y.T.E.',
  },
  {
    label: 'The people',
    quote:
      "What makes B.Y.T.E. special isn't just the projects or the events. It's the people you meet here. You walk in with an idea, find someone who wants to make it better, and suddenly you're working on something you never imagined building alone.",
    author: 'Society Member',
  },
  {
    label: 'Looking back',
    quote:
      'A year ago, I was intimidated by the word \u201cdeveloper.\u201d Today, I look at a problem and instinctively start thinking about how I could build a solution. B.Y.T.E. didn\u2019t just teach me how to code—it changed how I think, create, and see what I\u2019m capable of.',
    author: 'B.Y.T.E. Alumni',
  },
];
---

<section class="testi" data-testimonials>
  <div class="testi-track">
    <div class="testi-sticky">
      <div class="wrap testi-grid">
        <div class="testi-head">
          <div class="eyebrow">TESTIMONIALS</div>
          <h2>Built by the people<br />who lived it.</h2>
          <div class="testi-progress">
            <span data-testi-progress>01</span><i>/</i><span>{String(testimonials.length).padStart(2, '0')}</span>
          </div>
        </div>
        <div class="testi-stage">
          {testimonials.map((t, i) => (
            <blockquote class="testi-item" data-testi-item>
              <span class="testi-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="testi-label">{t.label}</span>
              <p class="testi-quote">{t.quote}</p>
              <footer>— {t.author}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testi {
    background: var(--bg);
    position: relative;
  }
  .testi-track {
    height: calc(100vh * 3.4);
    position: relative;
  }
  .testi-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .testi-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.4fr;
    gap: 64px;
    align-items: center;
    width: 100%;
  }
  .testi-head h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 14px 0 26px;
    text-transform: uppercase;
  }
  .testi-progress {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--text-faint);
    letter-spacing: 0.05em;
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .testi-progress span[data-testi-progress] {
    color: var(--lime);
    font-weight: 700;
  }
  .testi-stage {
    position: relative;
    min-height: 320px;
  }
  .testi-item {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transform: translateY(28px) scale(0.985);
    transition: opacity 0.55s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }
  .testi-item.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .testi-num {
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--lime);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 10px;
  }
  .testi-label {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    margin-bottom: 18px;
    font-weight: 600;
  }
  .testi-quote {
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.25rem, 2.4vw, 1.85rem);
    line-height: 1.4;
    font-weight: 500;
    color: var(--text);
    margin: 0 0 22px;
    max-width: 34ch;
  }
  .testi-item footer {
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* No-JS / no-animation fallback: a plain, fully visible stacked list.
     Only overridden once the script below confirms JS is running and the
     user hasn't asked for reduced motion (adds .js-anim to the section). */
  .testi:not(.js-anim) .testi-track {
    height: auto;
  }
  .testi:not(.js-anim) .testi-sticky {
    position: static;
    height: auto;
    display: block;
  }
  .testi:not(.js-anim) .testi-grid {
    display: block;
  }
  .testi:not(.js-anim) .testi-stage {
    min-height: 0;
  }
  .testi:not(.js-anim) .testi-item {
    position: static;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }
  .testi:not(.js-anim) .testi-progress {
    display: none;
  }

  @media (max-width: 980px) {
    .testi-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .testi-track {
      height: calc(100vh * 3);
    }
  }
  @media (max-width: 640px) {
    .testi-track {
      height: calc(100vh * 2.4);
    }
    .testi-sticky {
      height: 100svh;
      padding: 32px 0;
    }
    .testi-quote {
      font-size: 1.15rem;
    }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('[data-testimonials]');
    if (!section) return;
    var items = Array.prototype.slice.call(section.querySelectorAll('[data-testi-item]'));
    var progressEl = section.querySelector('[data-testi-progress]');
    var track = section.querySelector('.testi-track');
    if (!items.length || !track) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return; // keep the static stacked fallback (see CSS)

    section.classList.add('js-anim');

    function clamp01(n) {
      return Math.min(1, Math.max(0, n));
    }

    function update() {
      var rect = track.getBoundingClientRect();
      var total = track.offsetHeight - window.innerHeight;
      var scrolled = clamp01(-rect.top / Math.max(1, total));
      var idxFloat = scrolled * items.length;
      var idx = Math.min(items.length - 1, Math.max(0, Math.floor(idxFloat)));
      if (scrolled >= 0.999) idx = items.length - 1;

      items.forEach(function (item, i) {
        item.classList.toggle('is-active', i === idx);
      });
      if (progressEl) progressEl.textContent = String(idx + 1).padStart(2, '0');
    }

    var ticking = false;
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(function () {
          update();
          ticking = false;
        });
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  })();
</script>