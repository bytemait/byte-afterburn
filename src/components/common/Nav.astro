---
interface Props {
  active?: 'home' | 'events' | 'members' | 'contact' | 'projects';
  immersive?: boolean;
}

const { active = 'home', immersive = false } = Astro.props;

const links = [
  { href: '/', label: 'Home', activeWhen: 'home' },
  { href: '/#about', label: 'About' },
  { href: '/events', label: 'Events', activeWhen: 'events' },
  { href: '/members', label: 'Members', activeWhen: 'members' },
  { href: '/projects', label: 'Projects', activeWhen: 'projects' },
  { href: '/contact', label: 'Contact', activeWhen: 'contact' },
];
---

<header
  class:list={['site-nav', { 'is-immersive': immersive }]}
  data-byte-nav={immersive ? '' : undefined}
  data-mobile-nav-root
>
  <div class="nav-inner">
    <a href="/" class="brand"><span class="mark"><img src="/icon.png" alt="" width="38" height="38" /></span> Byte</a>
    <nav class="links" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} data-home-link={link.label === 'Home' ? '' : undefined} class:list={['nav-link', { active: link.activeWhen === active }]}>{link.label}</a>
      ))}
    </nav>

    <div class="nav-right">
      <a class="btn btn-primary" href="/contact">Join Us</a>
      <button class="burger" id="burgerBtn" type="button" aria-label="Open menu" aria-controls="mobileMenu" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>

  </div>

  <div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Site menu" aria-hidden="true" tabindex="-1">
    <div class="mobile-menu-top">
      <a href="/" class="mobile-wordmark" data-mobile-menu-link>
        <img src="/icon.png" alt="" width="42" height="42" />
        <span>Byte</span>
      </a>
      <button class="mobile-menu-close" id="mobileMenuClose" type="button" aria-label="Close menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" /></svg>
      </button>
    </div>

    <nav class="mobile-menu-links" aria-label="Mobile navigation">
      {links.map((link, index) => (
        <a
          href={link.href}
          class:list={['mobile-menu-link', { active: link.activeWhen === active }]}
          style={`--menu-index:${index}`}
          data-home-link={link.label === 'Home' ? '' : undefined}
          data-mobile-menu-link
        >
          <span class="mobile-link-node" aria-hidden="true"></span>
          <span>{link.label}</span>
        </a>
      ))}
    </nav>

  </div>
</header>

<script>
  const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
  type ByteWindow = Window & typeof globalThis & { __byteNavCleanup?: () => void };

  function setupMobileNav() {
    const byteWindow = window as ByteWindow;
    byteWindow.__byteNavCleanup?.();

    const root = document.querySelector<HTMLElement>('[data-mobile-nav-root]');
    const menuButton = root?.querySelector<HTMLButtonElement>('#burgerBtn');
    const menu = root?.querySelector<HTMLElement>('#mobileMenu');
    const closeButton = root?.querySelector<HTMLButtonElement>('#mobileMenuClose');
    if (!root || !menuButton || !menu || !closeButton) return;

    let previousFocus: HTMLElement | null = null;
    let closeTimer = 0;
    const abortController = new AbortController();
    const listenerOptions = { signal: abortController.signal };

    const publishState = (open: boolean) => {
      window.dispatchEvent(new CustomEvent('byte:nav-state', { detail: { open } }));
    };

    const resetMenu = () => {
      window.clearTimeout(closeTimer);
      menu.classList.remove('open', 'is-closing');
      menu.setAttribute('aria-hidden', 'true');
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Open menu');
      document.documentElement.classList.remove('mobile-nav-open');
      publishState(false);
    };

    const openMenu = () => {
      window.clearTimeout(closeTimer);
      previousFocus = document.activeElement as HTMLElement;
      menu.classList.remove('is-closing');
      menu.classList.add('open');
      menu.setAttribute('aria-hidden', 'false');
      menuButton.setAttribute('aria-expanded', 'true');
      menuButton.setAttribute('aria-label', 'Close menu');
      document.documentElement.classList.add('mobile-nav-open');
      publishState(true);
      requestAnimationFrame(() => closeButton.focus({ preventScroll: true }));
    };

    const closeMenu = ({ restoreFocus = true, immediate = false } = {}) => {
      if (!menu.classList.contains('open')) return;
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Open menu');
      publishState(false);
      if (immediate) {
        resetMenu();
        return;
      }
      menu.classList.add('is-closing');
      closeTimer = window.setTimeout(() => {
        resetMenu();
        if (restoreFocus && previousFocus?.isConnected) previousFocus.focus({ preventScroll: true });
      }, 360);
    };

    menuButton.addEventListener('click', () => menu.classList.contains('open') ? closeMenu() : openMenu(), listenerOptions);
    closeButton.addEventListener('click', () => closeMenu(), listenerOptions);
    root.querySelectorAll<HTMLAnchorElement>('[data-home-link]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (window.location.pathname !== '/') return;
        event.preventDefault();
        closeMenu({ restoreFocus: false });
        window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }, listenerOptions);
    });
    menu.querySelectorAll('[data-mobile-menu-link]').forEach((link) => {
      link.addEventListener('click', () => closeMenu({ restoreFocus: false }), listenerOptions);
    });

    document.addEventListener('keydown', (event) => {
      if (!menu.classList.contains('open')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu();
        return;
      }
      if (event.key !== 'Tab') return;
      const focusable = [...menu.querySelectorAll<HTMLElement>(focusableSelector)].filter((element) => element.offsetParent !== null);
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }, listenerOptions);

    window.addEventListener('resize', () => {
      if (window.innerWidth > 980) closeMenu({ restoreFocus: false, immediate: true });
    }, { passive: true, signal: abortController.signal });

    byteWindow.__byteNavCleanup = () => {
      abortController.abort();
      resetMenu();
      delete byteWindow.__byteNavCleanup;
    };
  }

  setupMobileNav();
  document.addEventListener('astro:after-swap', setupMobileNav);
  document.addEventListener('astro:page-load', setupMobileNav);
  document.addEventListener('astro:before-swap', () => (window as ByteWindow).__byteNavCleanup?.());
</script>

<style>
  @font-face {
    font-family: 'Clash Display';
    src: url('/assets/clash-600.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  .burger {
    position: relative;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: 50%;
  }
  .burger span {
    position: absolute;
    width: 19px;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
  }
  .burger span:first-child { transform: translateY(-4px); }
  .burger span:last-child { transform: translateY(4px); }

  .mobile-menu { display: none; }

  @media (max-width: 980px) {
    :global(html.mobile-nav-open),
    :global(html.mobile-nav-open body) { overflow: hidden; overscroll-behavior: none; }
    :global(html.mobile-nav-open .site-nav) {
      z-index: 10000;
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
      transform: none !important;
      animation: none !important;
    }
    :global(html.mobile-nav-open .nav-inner) {
      visibility: hidden;
      opacity: 0;
    }
    :global(html.mobile-nav-open .new-tasks-badge) { opacity: 0 !important; pointer-events: none; }
    :global(html.mobile-nav-open .page-transition-content),
    :global(html.mobile-nav-open body > main),
    :global(html.mobile-nav-open body > footer) {
      opacity: 0 !important;
      visibility: hidden;
      pointer-events: none;
    }
    :global(html.mobile-nav-open .title-network) { opacity: 0; }

    .nav-inner { padding-block: 12px; }
    .nav-right > .btn-primary { display: none; }
    .burger { display: flex; z-index: 1; }

    .mobile-menu {
      --menu-accent: #52e0a6;
      position: fixed;
      z-index: 1000;
      inset: 0;
      display: grid;
      grid-template-rows: auto 1fr;
      width: 100%;
      height: 100dvh;
      padding: max(12px, env(safe-area-inset-top)) 24px max(22px, env(safe-area-inset-bottom));
      overflow-x: hidden;
      overflow-y: auto;
      visibility: hidden;
      opacity: 1;
      color: #f2f6f2;
      background: #0b0e0c;
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path 560ms cubic-bezier(.16, 1, .3, 1),
        visibility 0s linear 560ms;
      transform-origin: top center;
      will-change: clip-path;
      isolation: isolate;
    }
    :global(html.has-node-mesh) .mobile-menu { background: rgba(7, 10, 8, .72); }
    .mobile-menu:focus { outline: none; }
    .mobile-menu.open {
      visibility: visible;
      clip-path: inset(0);
      transition-delay: 0s;
    }
    .mobile-menu.is-closing {
      clip-path: inset(0 0 100% 0);
      transition-duration: 340ms, 0s;
    }

    .mobile-menu-top {
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 48px;
      opacity: 1;
      transform: none;
    }
    .mobile-wordmark { display: flex; align-items: center; gap: 10px; color: #f6faf6; text-decoration: none; }
    .mobile-wordmark img { width: 38px; height: 38px; object-fit: contain; }
    .mobile-wordmark span { font-family: 'Baloo 2', sans-serif; font-size: 1.1rem; font-weight: 700; line-height: 1; }
    .mobile-menu-close {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: 1px solid rgba(151, 179, 162, .14);
      border-radius: 50%;
      background: rgba(4, 7, 5, .72);
      box-shadow: 0 18px 42px -20px rgba(0, 0, 0, .9);
      color: #f4f7f4;
    }
    .mobile-menu-close svg { width: 23px; height: 23px; fill: none; stroke: currentColor; stroke-width: 1.7; }
    .mobile-menu-close:active { color: var(--menu-accent); transform: scale(.94); }

    .mobile-menu-links {
      align-self: center;
      width: 100%;
      padding: clamp(18px, 4vh, 44px) 0 clamp(12px, 2.5vh, 28px);
    }
    .mobile-menu-link {
      position: relative;
      display: flex;
      align-items: center;
      min-height: clamp(48px, 7.2vh, 66px);
      padding-left: clamp(28px, 11vw, 52px);
      overflow: hidden;
      color: #657068;
      font-family: 'Clash Display', sans-serif;
      font-size: clamp(42px, 13vw, 72px);
      font-weight: 600;
      line-height: .9;
      letter-spacing: -.04em;
      text-transform: uppercase;
      text-decoration: none;
      border: 0;
      opacity: 0;
      transform: translateY(100px);
      transition: color 140ms ease;
    }
    .open .mobile-menu-link {
      animation: menu-link-in 560ms calc(260ms + var(--menu-index) * 54ms) cubic-bezier(.16, 1, .3, 1) forwards;
    }
    .mobile-menu-link.active:first-child,
    .mobile-menu-link:focus-visible,
    .mobile-menu-link:active { color: #f0f5f1; }
    .mobile-link-node {
      position: absolute;
      left: 8px;
      width: 8px;
      height: 8px;
      border: 1px solid var(--menu-accent);
      border-radius: 50%;
      background: #0b0e0c;
      box-shadow: 0 0 0 0 rgba(82, 224, 166, .28);
      transition: background 140ms ease, box-shadow 180ms ease, transform 180ms ease;
    }
    .mobile-menu-link.active:first-child .mobile-link-node,
    .mobile-menu-link:focus-visible .mobile-link-node,
    .mobile-menu-link:active .mobile-link-node {
      background: var(--menu-accent);
      box-shadow: 0 0 0 7px rgba(82, 224, 166, .11);
      transform: scale(1.2);
    }

    .mobile-menu :is(a, button):focus-visible { outline: 1px solid var(--menu-accent); outline-offset: 4px; }
  }

  @media (max-width: 360px), (max-height: 680px) {
    .mobile-menu { padding-inline: 24px; }
    .mobile-menu-top { min-height: 48px; }
    .mobile-menu-links { padding-block: 8px; }
    .mobile-menu-link { min-height: 43px; font-size: clamp(36px, 11.8vw, 46px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu { opacity: 0; clip-path: none; transition: opacity 160ms ease, visibility 0s linear 160ms; }
    .mobile-menu.open { opacity: 1; }
    .mobile-menu.open { transition-delay: 0s; }
    .mobile-menu.is-closing { opacity: 0; clip-path: none; }
    .open .mobile-menu-top,
    .open .mobile-menu-link { animation: menu-fade-in 180ms ease forwards; }
  }

  @keyframes menu-link-in { to { opacity: 1; transform: translateY(0); } }
  @keyframes menu-fade-in { to { opacity: 1; transform: none; } }
</style>
