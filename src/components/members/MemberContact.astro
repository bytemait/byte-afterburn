---
interface Props {
  phone?: string;
  discord?: string;
}
const { phone, discord } = Astro.props;
---

<section class="member-contact" aria-labelledby="member-contact-title">
  <h2 id="member-contact-title">Get in touch</h2>
  <div class="contact-methods">
    {discord && (
      <div class="contact-method" data-discord-contact>
        <svg class="method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 21l1.9-5.5a9 9 0 0 1-.9-4A8.5 8.5 0 0 1 12.5 3H13a8.5 8.5 0 0 1 8 8v.5Z" />
          <path d="M8 11h.01M12 11h.01M16 11h.01" />
        </svg>
        <div class="method-copy">
          <label class="method-label" for="member-discord">Discord</label>
          <input class="method-value discord-value" id="member-discord" value={discord} readonly spellcheck="false" />
        </div>
        <button class="copy-discord" type="button" aria-label="Copy Discord username">Copy</button>
        <span class="copy-feedback" role="status" aria-live="polite"></span>
      </div>
    )}
    {phone && (
      <a class="contact-method phone-method" href={`https://wa.me/${phone.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer">
        <svg class="method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
        </svg>
        <span class="method-copy"><span class="method-label">WhatsApp</span><span class="method-value">{phone}</span></span>
        <span class="method-action">Text <span aria-hidden="true">↗</span></span>
      </a>
    )}
  </div>
</section>

<script>
  function setupDiscordCopy() {
    const contact = document.querySelector<HTMLElement>('[data-discord-contact]');
    if (!contact || contact.dataset.bound) return;
    const button = contact.querySelector<HTMLButtonElement>('.copy-discord');
    const input = contact.querySelector<HTMLInputElement>('input');
    const feedback = contact.querySelector<HTMLElement>('.copy-feedback');
    if (!button || !input || !feedback) return;
    contact.dataset.bound = 'true';
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      clearTimeout(resetTimer);
      let copied = false;
      try {
        await navigator.clipboard.writeText(input.value);
        copied = true;
      } catch {
        // Clipboard API may be unavailable on the local HTTP dev server.
        input.focus();
        input.select();
        try { copied = document.execCommand('copy'); } catch { /* Manual selection stays available. */ }
        if (copied) button.focus();
      }
      button.textContent = copied ? 'Copied' : 'Copy';
      feedback.textContent = copied ? 'Username copied.' : 'Copy unavailable. Select the username to copy it manually.';
      resetTimer = setTimeout(() => {
        button.textContent = 'Copy';
        feedback.textContent = '';
      }, 4000);
    });
    document.addEventListener('astro:before-swap', () => clearTimeout(resetTimer), { once: true });
  }
  setupDiscordCopy();
  document.addEventListener('astro:page-load', setupDiscordCopy);
</script>

<style>
  .member-contact {
    min-width: 0;
    padding: 24px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--green);
    border-radius: 12px;
    background: var(--panel);
  }
  .member-contact h2 {
    margin: 0 0 16px;
    color: var(--green);
    font: 600 1.15rem/1.3 'Clash Display', sans-serif;
  }
  .contact-methods { display: grid; gap: 16px; }
  .contact-method {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-width: 0;
    min-height: 56px;
    color: var(--ink);
    text-decoration: none;
  }
  .contact-method + .contact-method { padding-top: 16px; border-top: 1px solid var(--line); }
  .method-icon { width: 22px; height: 22px; color: var(--green); }
  .method-copy { display: grid; gap: 4px; min-width: 0; }
  .method-label { color: var(--muted); font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .method-value { color: var(--ink); font: 600 clamp(1rem, 2vw, 1.25rem)/1.4 'Clash Display', sans-serif; overflow-wrap: anywhere; }
  .discord-value { width: 100%; min-width: 0; padding: 0; border: 0; background: transparent; border-radius: 0; text-overflow: ellipsis; }
  .method-action { color: var(--green); font-size: .8rem; font-weight: 700; white-space: nowrap; }
  .phone-method:hover .method-value { color: var(--green); }
  .copy-discord { min-height: 44px; min-width: 72px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 6px; color: var(--green); background: var(--bg-soft); font-size: .8rem; font-weight: 700; }
  .copy-discord:hover { border-color: var(--green); }
  .phone-method:focus-visible, .copy-discord:focus-visible, .discord-value:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
  .copy-feedback { grid-column: 2 / -1; color: var(--green); font-size: .75rem; line-height: 1.5; }
  .copy-feedback:empty { display: none; }
  @media (max-width: 480px) {
    .member-contact { padding: 20px 16px; }
    .contact-method { grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
    .method-icon { display: none; }
    .copy-feedback { grid-column: 1 / -1; }
  }
</style>
