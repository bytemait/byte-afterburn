---
import DotField from './home-hero/DotField.astro';
import ProjectCardCluster from './home-hero/ProjectCardCluster.astro';
import type { ProjectCardData } from './home-hero/ProjectCardCluster.astro';
import HeroHeadline from './home-hero/HeroHeadline.astro';
import MarqueeStrip from './home-hero/MarqueeStrip.astro';

// Three even, symmetric rows (18% / 45% / 72%) instead of the original
// scattered offsets — reads as a tidier grid of cards rather than a messy
// pile, and the 18% top row keeps clear of the fixed nav above it.
const projectCards: ProjectCardData[] = [
  { grad: 'grad1', mark: 'TB', label: 'ThothBox', rot: -8, curve: 1, spin: 420, style: 'top:18%; left:2%; width:150px;', hide: 'tablet' },
  { grad: 'grad2', mark: 'PG', label: 'Progmatic', rot: 6, curve: -1, spin: 360, style: 'top:72%; left:1%; width:120px;', hide: 'tablet' },
  { grad: 'grad7', mark: 'HQ', label: 'HQ Build', rot: 3, curve: 1, spin: 480, style: 'top:45%; left:8.5%; width:130px;', hide: 'tablet' },
  { grad: 'grad3', mark: 'HN', label: 'HackNight 3.0', rot: 7, curve: -1, spin: 400, style: 'top:18%; right:3%; width:170px;', hide: 'tablet' },
  { grad: 'grad4', mark: 'ST', label: 'Sentinel', rot: -6, curve: 1, spin: 340, style: 'top:72%; right:1%; width:130px;', hide: 'tablet' },
  { grad: 'grad5', mark: 'ERP', label: 'ERP Portal', rot: 5, curve: -1, spin: 460, style: 'top:45%; right:5.5%; width:150px;', hide: 'tablet' },
  { grad: 'grad6', mark: 'BW', label: 'Byte Weekly', rot: -4, curve: 1, spin: 380, style: 'top:18%; left:24%; width:105px;', hide: 'wide' },
  { grad: 'grad8', mark: 'GG', label: 'Git Wkshp', rot: 4, curve: -1, spin: 440, style: 'top:72%; left:26%; width:100px;', hide: 'wide' },
  { grad: 'grad9', mark: 'OR', label: 'Orientation', rot: -5, curve: 1, spin: 320, style: 'top:18%; right:24%; width:110px;', hide: 'wide' },
  { grad: 'grad10', mark: 'DS', label: 'Design Jam', rot: -3, curve: -1, spin: 500, style: 'top:72%; right:26%; width:100px;', hide: 'wide' },
];
---

<section class="home-hero">
  <DotField />
  <ProjectCardCluster cards={projectCards} />
  <HeroHeadline />
  <MarqueeStrip />
</section>

<style is:global>
  /* Shared design tokens for the home-hero family of components. `is:global`
     so DotField/ProjectCardCluster/ProjectCard/HeroHeadline/MarqueeStrip —
     each scoped to its own file — can all read these custom properties by
     simple inheritance, without every file redeclaring them. Custom property
     *names* are prefixed enough (--dark, --neon, etc.) not to collide with
     the rest of the site's tokens in global.css, and everything here stays
     scoped under .home-hero so it can never leak into the rest of the page. */
  .home-hero {
    --dark: #090d0a;
    --dark-2: #0e140f;
    --paper: #f4f7ef;
    --ink: #0b120d;
    --neon: #4dffa0;
    --neon-dim: #22c37a;
    --muted: #6f9c85;
    --dot: rgba(77, 255, 160, 0.16);

    position: relative;
    min-height: 100svh;
    background: var(--dark);
    color: var(--paper);
    padding-bottom: 70px;
    overflow: hidden;
    font-family: 'Sora', ui-sans-serif, system-ui, sans-serif;
  }
  .home-hero * {
    box-sizing: border-box;
  }
  .home-hero a {
    color: inherit;
    text-decoration: none;
  }
</style>
