---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import NavbarScrollFade from './NavbarScrollFade';
import type { ShowcasePageData } from '../data/showcase-pages';
import { defaultFaqs } from '../data/showcase-pages';
import '../styles/recreation.css';

interface Props {
  page: ShowcasePageData;
}

const { page } = Astro.props;
const faqs = page.faqs ?? defaultFaqs;
const typeLabel = page.kind === 'work' ? 'Project' : 'Department';
---

<Layout title={`${page.title} — BYTE`} immersiveNav footerInSlot contentTransition={false}>
  <main class="showcase-page" data-showcase-page>
    <NavbarScrollFade client:load />

    <div class="page-transition-content" data-page-transition-content data-page-enter>
    <article>
      <header class="showcase-hero">
        <div class="showcase-hero-top">
          <div class:list={['title-window', { 'is-long': page.title.length > 18 }]}>
            <h1>{page.title}</h1>
          </div>
          <div class="showcase-meta">
            {page.meta.map((item) => (
              <div class="meta-item">
                <p>{item.value}</p>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        </div>

        <figure class="media-stage hero-media" data-media-reveal>
          <img src={page.hero.src} alt={page.hero.alt} style={`object-position:${page.hero.position ?? 'center'}`} fetchpriority="high" />
          <figcaption>{typeLabel} / {page.slug.replaceAll('-', ' ')}</figcaption>
        </figure>
      </header>

      <div class="editorial-block first-editorial">
        {page.sections.slice(0, 2).map((section, index) => (
          <section class="story-row" data-reveal>
            <div class="story-index" aria-hidden="true">0{index + 1}</div>
            <h2>{section.title}</h2>
            <div class="story-copy">
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </section>
        ))}
      </div>

      <section class="detail-gallery" aria-label={`${page.title} details`}>
        {page.gallery.map((image, index) => (
          <figure class="media-stage gallery-media" data-media-reveal style={`--reveal-delay:${index * 80}ms`}>
            <img src={image.src} alt={image.alt} loading="lazy" style={`object-position:${image.position ?? 'center'}`} />
          </figure>
        ))}
      </section>

      <div class="editorial-block outcome-block">
        <section class="story-row" data-reveal>
          <div class="story-index" aria-hidden="true">03</div>
          <h2>{page.sections[2].title}</h2>
          <div class="story-copy">
            {page.sections[2].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <a class="inline-cta" href="/contact"><span>Start a conversation</span><span aria-hidden="true">↗</span></a>
          </div>
        </section>
      </div>

      {page.closingImage && (
        <section class="closing-media-wrap">
          <figure class="media-stage closing-media" data-media-reveal>
            <img src={page.closingImage.src} alt={page.closingImage.alt} loading="lazy" style={`object-position:${page.closingImage.position ?? 'center'}`} />
          </figure>
        </section>
      )}

      <section class="faq-section" aria-labelledby="faq-title">
        <div class="section-marker"><span>//</span><h2 id="faq-title">QUESTIONS</h2><span>//</span></div>
        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details class="faq-item" data-reveal>
              <summary>
                <span class="faq-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="faq-question">{faq.question}</span>
                <span class="faq-toggle" aria-hidden="true"></span>
              </summary>
              <div class="faq-answer"><p>{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </section>

      <section class="showcase-cta" data-reveal>
        <div>
          <h2>{page.ctaTitle ?? 'MAKE THE NEXT THING'}</h2>
          <p>{page.ctaBody ?? 'Have an idea worth testing? Bring it to Byte and build it with people who care about making it work.'}</p>
        </div>
        <a href="/contact">Contact Byte <span aria-hidden="true">↗</span></a>
      </section>
    </article>
    </div>

    <Footer immersive />
  </main>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('[data-showcase-page]');
  if (root) {
    const revealItems = root.querySelectorAll<HTMLElement>('[data-reveal], [data-media-reveal]');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });
      revealItems.forEach((item) => observer.observe(item));
    }
  }
</script>

<style>
  @font-face {
    font-family: 'Clash Display';
    src: url('/portx/original/clash-600.woff2') format('woff2');
    font-weight: 600;
    font-display: swap;
  }

  .showcase-page {
    --detail-edge: clamp(20px, 5vw, 72px);
    --detail-max: 1920px;
    --detail-line: rgba(159, 183, 168, .18);
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: transparent;
    color: #f4f7f4;
    font-family: 'Inter', sans-serif;
  }
  .showcase-page article { position: relative; z-index: 1; }

  .showcase-hero {
    width: min(100%, var(--detail-max));
    margin: 0 auto;
    padding: 160px var(--detail-edge) 0;
  }
  .showcase-hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 416px);
    gap: 72px;
    align-items: start;
    min-height: 198px;
  }
  .title-window { overflow: hidden; }
  .title-window h1 {
    max-width: 11ch;
    margin: 0;
    color: #fff;
    font-family: 'Clash Display', sans-serif;
    font-size: clamp(4.75rem, 8.2vw, 7.5rem);
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: .86;
    text-wrap: balance;
    animation: title-drop 850ms cubic-bezier(.16, 1, .3, 1) both;
  }
  .title-window.is-long h1 { font-size: clamp(4.25rem, 6vw, 6.35rem); }
  .showcase-meta {
    display: grid;
    gap: 32px;
    padding-top: 4px;
    opacity: 0;
    transform: translateY(30px);
    animation: meta-rise 680ms 200ms cubic-bezier(.16, 1, .3, 1) forwards;
  }
  .meta-item { display: grid; gap: 5px; }
  .meta-item p {
    margin: 0;
    font-family: 'Clash Display', sans-serif;
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .meta-item span { color: #8f9991; font-size: .9rem; line-height: 1.45; }

  .media-stage {
    position: relative;
    overflow: hidden;
    margin: 0;
    border-radius: 20px;
    background: #171717;
  }
  .media-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .05);
    border-radius: inherit;
  }
  .media-stage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.25);
    transition: transform 900ms cubic-bezier(.16, 1, .3, 1);
  }
  .media-stage.is-visible img { transform: scale(1); }
  .hero-media {
    height: 526px;
    margin-top: 64px;
    background: #171717;
  }
  .hero-media img { object-fit: contain; }
  .hero-media figcaption {
    position: absolute;
    right: 18px;
    bottom: 16px;
    z-index: 2;
    padding: 8px 11px;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 999px;
    background: rgba(7, 10, 8, .72);
    color: #c8d2ca;
    font-size: .66rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .editorial-block {
    display: grid;
    gap: 96px;
    width: min(100%, var(--detail-max));
    margin: 0 auto;
    padding: 70px var(--detail-edge) 96px;
  }
  .story-row {
    display: grid;
    grid-template-columns: 52px minmax(180px, .75fr) minmax(320px, 1.25fr);
    gap: 38px;
    align-items: start;
    opacity: 0;
    transform: translateY(140px);
    transition:
      opacity 720ms cubic-bezier(.16, 1, .3, 1),
      transform 900ms cubic-bezier(.16, 1, .3, 1);
  }
  .story-row.is-visible { opacity: 1; transform: translateY(0); }
  .story-row:first-child {
    padding-bottom: 96px;
    border-bottom: 1px solid var(--detail-line);
  }
  .story-index {
    color: #52e0a6;
    font-family: 'JetBrains Mono', monospace;
    font-size: .72rem;
    letter-spacing: .08em;
  }
  .story-row h2 {
    margin: 0;
    font-family: 'Clash Display', sans-serif;
    font-size: clamp(1.65rem, 2.5vw, 2.55rem);
    font-weight: 600;
    letter-spacing: -.025em;
    line-height: 1;
    text-transform: uppercase;
  }
  .story-copy { display: grid; gap: 20px; max-width: 68ch; }
  .story-copy p {
    margin: 0;
    color: #aeb8b0;
    font-size: clamp(1rem, 1.1vw, 1.08rem);
    line-height: 1.7;
  }

  .detail-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px;
    width: min(100%, var(--detail-max));
    margin: 0 auto;
    padding: 0 var(--detail-edge);
  }
  .gallery-media { height: 461px; transition-delay: var(--reveal-delay); }
  .gallery-media img { object-fit: cover; }
  .outcome-block { padding-top: 96px; }
  .outcome-block .story-row { padding-bottom: 0; border-bottom: 0; }
  .inline-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 360px);
    margin-top: 18px;
    padding: 15px 0;
    border-top: 1px solid var(--detail-line);
    border-bottom: 1px solid var(--detail-line);
    color: #f2f6f2;
    font-family: 'Clash Display', sans-serif;
    font-size: .92rem;
    text-transform: uppercase;
    transition: color 180ms ease, padding 260ms cubic-bezier(.16, 1, .3, 1);
  }
  .inline-cta:hover, .inline-cta:focus-visible { padding-inline: 8px; color: #52e0a6; }

  .closing-media-wrap {
    width: min(100%, var(--detail-max));
    margin: 0 auto;
    padding: 0 var(--detail-edge);
  }
  .closing-media { height: 526px; }
  .closing-media img { object-fit: contain; }

  .faq-section {
    width: min(100%, var(--detail-max));
    margin: 0 auto;
    padding: 112px var(--detail-edge);
  }
  .section-marker {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: center;
    margin-bottom: 48px;
    color: #556159;
  }
  .section-marker span:last-child { text-align: right; }
  .section-marker h2 {
    margin: 0;
    color: #eff4ef;
    font-family: 'Clash Display', sans-serif;
    font-size: .82rem;
    letter-spacing: .08em;
  }
  .faq-list { border-top: 1px solid var(--detail-line); }
  .faq-item {
    border-bottom: 1px solid var(--detail-line);
    opacity: 0;
    transform: translateY(38px);
    transition: opacity 600ms cubic-bezier(.16, 1, .3, 1), transform 700ms cubic-bezier(.16, 1, .3, 1);
  }
  .faq-item.is-visible { opacity: 1; transform: none; }
  .faq-item summary {
    display: grid;
    grid-template-columns: 52px 1fr 32px;
    gap: 24px;
    align-items: center;
    min-height: 88px;
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-number { color: #59645c; font-family: 'JetBrains Mono', monospace; font-size: .7rem; }
  .faq-question {
    font-family: 'Clash Display', sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    font-weight: 600;
    text-transform: uppercase;
  }
  .faq-toggle { position: relative; width: 24px; height: 24px; }
  .faq-toggle::before, .faq-toggle::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 16px; height: 1px;
    background: #dbe5dd;
    transform: translate(-50%, -50%);
    transition: transform 260ms cubic-bezier(.16, 1, .3, 1);
  }
  .faq-toggle::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq-item[open] .faq-toggle::after { transform: translate(-50%, -50%) rotate(0); }
  .faq-answer { overflow: hidden; }
  .faq-answer p { max-width: 70ch; margin: -4px 56px 28px 76px; color: #aeb8b0; line-height: 1.7; }

  .showcase-cta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    width: min(calc(100% - 2 * var(--detail-edge)), calc(var(--detail-max) - 2 * var(--detail-edge)));
    min-height: 410px;
    margin: 0 auto 96px;
    padding: clamp(30px, 5vw, 72px);
    border-radius: 20px;
    background:
      radial-gradient(circle at 78% 20%, rgba(82, 224, 166, .21), transparent 30%),
      linear-gradient(135deg, #181818, #111111);
    opacity: 0;
    transform: translateY(90px);
    transition: opacity 700ms cubic-bezier(.16, 1, .3, 1), transform 900ms cubic-bezier(.16, 1, .3, 1);
  }
  .showcase-cta.is-visible { opacity: 1; transform: none; }
  .showcase-cta h2 {
    max-width: 10ch;
    margin: 0 0 18px;
    font-family: 'Clash Display', sans-serif;
    font-size: clamp(2.8rem, 6vw, 6rem);
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: .9;
  }
  .showcase-cta p { max-width: 54ch; margin: 0; color: #aeb8b0; line-height: 1.65; }
  .showcase-cta > a {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    min-width: 190px;
    padding: 16px 20px;
    border: 1px solid rgba(255, 255, 255, .5);
    border-radius: 999px;
    font-family: 'Clash Display', sans-serif;
    font-size: .86rem;
    text-transform: uppercase;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }
  .showcase-cta > a:hover, .showcase-cta > a:focus-visible { background: #52e0a6; color: #07110b; transform: translateY(-2px); }

  :global(.showcase-page a:focus-visible), :global(.showcase-page summary:focus-visible) { outline: 2px solid #52e0a6; outline-offset: 5px; }
  :global(.showcase-page ::selection) { background: #52e0a6; color: #07110b; }

  @keyframes title-drop {
    from { opacity: .001; transform: translateY(-400px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes meta-rise { to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 809px) {
    .showcase-hero { padding-top: 130px; }
    .showcase-hero-top { grid-template-columns: 1fr; gap: 40px; min-height: 228px; }
    .title-window h1 { max-width: 100%; font-size: clamp(3.3rem, 15vw, 5.5rem); overflow-wrap: anywhere; }
    .title-window.is-long h1 { font-size: clamp(2.75rem, 12.5vw, 4.5rem); }
    .showcase-meta { grid-template-columns: 1fr 1fr; gap: 20px; }
    .meta-item p { font-size: .9rem; }
    .meta-item span { font-size: .75rem; }
    .hero-media { height: 526px; margin-top: 48px; }
    .hero-media img { transform: scale(1.35); }
    .hero-media.is-visible img { transform: scale(1.08); }
    .editorial-block { gap: 96px; }
    .story-row { grid-template-columns: 38px 1fr; gap: 28px 16px; }
    .story-row h2 { font-size: 1.75rem; }
    .story-copy { grid-column: 2; }
    .story-row:first-child { padding-bottom: 96px; }
    .detail-gallery { grid-template-columns: 1fr; gap: 72px; }
    .gallery-media { height: 461px; }
    .closing-media { height: 526px; }
    .faq-section { padding-block: 96px; }
    .faq-item summary { grid-template-columns: 32px 1fr 28px; gap: 12px; min-height: 82px; }
    .faq-answer p { margin: 0 40px 26px 44px; }
    .showcase-cta { align-items: stretch; flex-direction: column; justify-content: end; min-height: 480px; margin-bottom: 60px; }
    .showcase-cta > a { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .title-window h1, .showcase-meta { animation: none; opacity: 1; transform: none; }
    .story-row, .faq-item, .showcase-cta { opacity: 1; transform: none; transition: none; }
    .media-stage img { transform: none; transition: none; }
  }
</style>
