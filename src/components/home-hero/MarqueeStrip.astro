---
interface Props {
  items?: string[];
}

const { items = ['BUILDERS', 'HACKERS', 'DESIGNERS', 'MAKERS', 'DREAMERS'] } = Astro.props;
// duplicated once so the marquee can loop seamlessly at translateX(-50%)
const looped = [...items, ...items];
---

<div class="ticker-strip">
  <div class="ticker">
    {looped.map((label) => (
      <span>{label} <i class="pip"></i></span>
    ))}
  </div>
</div>

<style>
  .ticker-strip {
    position: relative;
    z-index: 2;
    background: var(--dark-2);
    border-top: 1px solid rgba(77, 255, 160, 0.16);
    border-bottom: 1px solid rgba(77, 255, 160, 0.16);
    overflow: hidden;
    margin-top: 20px;
  }
  .ticker {
    display: flex;
    width: max-content;
    /* --tick-duration is nudged by the script below in response to scroll
       velocity; 24s is the resting/no-JS speed. */
    animation: sw-tickx var(--tick-duration, 24s) linear infinite;
    padding: 14px 0;
  }
  .ticker-strip:hover .ticker {
    animation-play-state: paused;
  }
  .ticker span {
    font-family: 'Bungee', sans-serif;
    font-size: clamp(16px, 2.6vw, 26px);
    color: var(--neon);
    padding: 0 26px;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 26px;
    text-transform: uppercase;
  }
  .ticker span.pip {
    width: 8px;
    height: 8px;
    background: var(--neon);
    border-radius: 50%;
    display: inline-block;
    padding: 0;
    box-shadow: 0 0 8px 1px rgba(77, 255, 160, 0.6);
  }
  @keyframes sw-tickx {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker {
      animation: none;
    }
  }
</style>

<script>
  (function () {
    var strips = document.querySelectorAll('.ticker-strip');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    strips.forEach(function (strip) {
      var ticker = strip.querySelector('.ticker');
      if (!ticker) return;

      // Scroll faster -> shorter loop duration (feels "pulled" by the
      // scroll); relaxes back to the base 24s once scrolling stops.
      var baseDuration = 24;
      var minDuration = 6;
      var lastY = window.scrollY;
      var current = baseDuration;

      function frame() {
        var y = window.scrollY;
        var delta = Math.abs(y - lastY);
        lastY = y;
        var target = Math.max(minDuration, baseDuration - delta * 1.4);
        current += (target - current) * 0.12;
        ticker.style.setProperty('--tick-duration', current.toFixed(2) + 's');
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    });
  })();
</script>