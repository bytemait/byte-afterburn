---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import Testimonials from '../components/testimonials.astro';
---

<Layout title="B.Y.T.E. — Build. Connect. Create Impact." active="home">
  <HomeHero />

  <div class="stats-bar">
    <div class="wrap stats-grid" data-stats>
      <div class="stat"><div class="stat-icon"><svg><use href="#i-user"/></svg></div><div><b data-count="150" data-suffix="+">150+</b><span>Members</span></div></div>
      <div class="stat"><div class="stat-icon"><svg><use href="#i-sun"/></svg></div><div><b data-count="25" data-suffix="+">25+</b><span>Events</span></div></div>
      <div class="stat"><div class="stat-icon"><svg><use href="#i-folder"/></svg></div><div><b data-count="10" data-suffix="+">10+</b><span>Projects</span></div></div>
      <div class="stat"><div class="stat-icon"><svg><use href="#i-award"/></svg></div><div><b data-count="4" data-suffix="+">4+</b><span>Years</span></div></div>
    </div>
  </div>

  <section id="about" data-who>
    <div class="wrap who-grid">
      <div class="who-copy">
        <div class="eyebrow">WHO WE ARE</div>
        <h2>
          <span class="who-line" data-who-line>We don't just attend college.</span><br>
          <span class="who-line" data-who-line>We <span class="hi">build</span> what comes next.</span>
        </h2>
        <p class="who-line" data-who-line>B.Y.T.E. is a community of innovators, thinkers and doers. We organize events, build projects and collaborate to create meaningful impact.</p>
        <button class="btn btn-outline who-line" data-who-line>Learn More</button>
      </div>
      <div class="ph who-visual who-line" data-who-line data-ratio="1600 × 1100"><span class="ph-tag">Image</span><svg><use href="#i-image"/></svg></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2>Upcoming Events</h2>
        <a href="/events" class="view-all">View all events</a>
      </div>
    </div>
    <div class="events-stage-track">
      <div class="event-stage-slot">
        <article class="event-stage-item" data-event-item>
          <div class="event-stage-num">01</div>
          <div class="date-chip"><b>12</b><span>Sep</span></div>
          <div class="event-stage-body">
            <h4>Web Dev Workshop 2026</h4>
            <div class="meta-row">
              <span><svg><use href="#i-pin"/></svg>Seminar Hall, CSE Block</span>
              <span><svg><use href="#i-clock"/></svg>06:00 PM – 08:00 PM</span>
            </div>
            <a href="/events" class="view">View Details</a>
          </div>
        </article>
      </div>
      <div class="event-stage-slot">
        <article class="event-stage-item" data-event-item>
          <div class="event-stage-num">02</div>
          <div class="date-chip"><b>20</b><span>Sep</span></div>
          <div class="event-stage-body">
            <h4>Hack The Future Hackathon</h4>
            <div class="meta-row">
              <span><svg><use href="#i-pin"/></svg>Auditorium, Main Block</span>
              <span><svg><use href="#i-clock"/></svg>09:00 AM – 06:00 PM</span>
            </div>
            <a href="/events" class="view">View Details</a>
          </div>
        </article>
      </div>
      <div class="event-stage-slot">
        <article class="event-stage-item" data-event-item>
          <div class="event-stage-num">03</div>
          <div class="date-chip"><b>04</b><span>Oct</span></div>
          <div class="event-stage-body">
            <h4>AI/ML Hands-on Session</h4>
            <div class="meta-row">
              <span><svg><use href="#i-pin"/></svg>Lab 3, CSE Block</span>
              <span><svg><use href="#i-clock"/></svg>04:00 PM – 07:00 PM</span>
            </div>
            <a href="/events" class="view">View Details</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <Testimonials />

  <section>
    <div class="wrap">
      <div class="cta-band" data-cta-reveal>
        <div>
          <h3>Ready to be part of it?</h3>
          <p>Great things happen when we build together.</p>
        </div>
        <button class="btn btn-primary">Join The Society</button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Stats: staggered reveal, count-up handled in JS ---------- */
  .stats-grid.js-anim .stat {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .stats-grid.js-anim.in-view .stat {
    opacity: 1;
    transform: translateY(0);
  }
  .stats-grid.js-anim.in-view .stat:nth-child(1) { transition-delay: 0.02s; }
  .stats-grid.js-anim.in-view .stat:nth-child(2) { transition-delay: 0.12s; }
  .stats-grid.js-anim.in-view .stat:nth-child(3) { transition-delay: 0.22s; }
  .stats-grid.js-anim.in-view .stat:nth-child(4) { transition-delay: 0.32s; }

  /* ---------- Who We Are: JS drives opacity/translate inline once active */
  [data-who].js-anim .who-line {
    opacity: 0;
    transform: translateY(22px);
  }

  /* ---------- Events: sticky stack ---------- */
  .events-stage-track {
    padding-bottom: 6vh;
  }
  .event-stage-slot {
    height: 78vh;
    display: flex;
    align-items: flex-start;
  }
  .event-stage-item {
    position: sticky;
    top: 110px;
    width: 100%;
    max-width: var(--maxw);
    margin: 0 auto;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 34px 40px;
  }
  .event-stage-num {
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 2.4rem;
    color: var(--lime);
    opacity: 0.35;
    flex-shrink: 0;
    width: 64px;
  }
  .event-stage-item .date-chip {
    flex-shrink: 0;
  }
  .event-stage-body h4 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .event-stage-body .view {
    color: var(--lime);
    font-size: 0.78rem;
    font-weight: 600;
    margin-top: 8px;
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* ---------- CTA reveal ---------- */
  .cta-band.js-anim {
    opacity: 0;
    transform: translateY(24px) scale(0.98);
    transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cta-band.js-anim.is-in {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (max-width: 980px) {
    .event-stage-item {
      padding: 26px 24px;
      max-width: calc(var(--maxw) - 48px);
    }
  }
  @media (max-width: 640px) {
    .event-stage-slot {
      height: 56vh;
    }
    .event-stage-item {
      top: 84px;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      max-width: calc(100% - 36px);
    }
    .event-stage-num {
      font-size: 1.8rem;
      width: auto;
    }
  }
</style>

<script>
  import '../scripts/scroll-story.js';
</script>