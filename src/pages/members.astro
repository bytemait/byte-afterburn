const departmentMembers = {
  development: [
    'Aditya Shahi', 'Chirag', 'Dev Saini', 'Himanshu Vishwakarma', 'Ishuman Chaudhary', 'Krishna Tiwari', 'Parth Garg', 'Snehashish Ghosh',
    'Srishti Raghava', 'Tanmay Aggarwal', 'Vaibhav Jain', 'Vandit Kad', 'Vinayak Mittal', 'Yash Bahuguna', 'Yash Malhotra', 'Yuktarth Naman',
