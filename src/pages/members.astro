const alumni2024: AlumniMember[] = [
  { name: 'Shivam Kumar Jha', role: 'Founding President', tier: 'lead' },
  { name: 'Abir Thakur', role: 'Vice President', tier: 'inner' },
  { name: 'Aman Sharma', role: 'Vice President', tier: 'inner' },
  { name: 'Ansh Kapila', role: 'Creative Outreach', tier: 'outer' },
  { name: 'Tanush Purwar', role: 'Creative Outreach', tier: 'outer' },
  { name: 'Ishaan Minocha', role: 'Coordinator', tier: 'outer' },
  { name: 'Haaris Huda', role: 'Coordinator', tier: 'outer' },
  { name: 'Piyush Mittal', role: 'Coordinator', tier: 'outer' },
  { name: 'Chayan Khetan', role: 'Coordinator', tier: 'outer' },
  { name: 'Pratham Gupta', role: 'Coordinator', tier: 'outer' },
];

const founderPositions = [
  { x: 50, y: 47 },
  { x: 28, y: 24 },
  { x: 72, y: 24 },
  { x: 15, y: 49 },
  { x: 85, y: 49 },
  { x: 24, y: 76 },
  { x: 36, y: 88 },
  { x: 64, y: 88 },
  { x: 76, y: 76 },
  { x: 50, y: 12 },
] as const;

const chapters = [
  { key: 'leadership', title: 'The Council', heading: 'The Council', note: 'Seven people keeping every part of Byte in motion.', listedMembers: [] },
  { key: 'development', title: 'Development', heading: 'Develop\nment', note: 'Builders turning ambitious ideas into things people can use.', listedMembers: departmentMembers.development },
  { key: 'cybersecurity', title: 'Cybersecurity', heading: 'Cyber\nSecurity', note: 'Break it, understand it, secure it, teach it.', listedMembers: departmentMembers.cybersecurity },
  { key: 'creative', title: 'Creative Outreach', heading: 'Creative\nOutreach', note: 'The voice, image and connective tissue of the society.', listedMembers: departmentMembers.creative },
  { key: 'aiml', title: 'AI / ML', heading: 'AI / ML', note: 'Learning systems, practical experiments and a healthy appetite for the unknown.', listedMembers: departmentMembers.aiml },
  { key: 'mechatronics', title: 'Mechatronics', heading: 'Mecha\ntronics', note: 'Code that leaves the screen and moves through the physical world.', listedMembers: departmentMembers.mechatronics },
] as const;
---

<Layout title="Living Constellation — B.Y.T.E." active="members">
  <main class="constellation-page" data-members-concept="constellation">
    <div class="chapter-rail" aria-label="Member groups">
      <span class="rail-signal" aria-hidden="true"></span>
      {chapters.map((chapter, index) => (
        <a href={`#${chapter.key}`} data-rail-link={chapter.key} aria-label={`Jump to ${chapter.title}`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
        </a>
      ))}
    </div>

    <section class="constellation-hero" aria-labelledby="constellation-title">
      <div class="hero-meta">
        <p>Byte Tech Society · Core Team 2026</p>
        <p>~50 members · one signal</p>
      </div>
      <h1 id="constellation-title">
        <span data-mesh-title>WE ARE</span>
        <span data-mesh-title>BYTE<span data-mesh-dot>.</span></span>
      </h1>
      <p class="hero-thesis">A living network of builders, breakers, designers and experimenters. Move through the constellation to meet the people behind the signal.</p>
      <a class="hero-enter" href="#leadership">
        <span>Enter the network</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2v14M4.5 10.5 10 16l5.5-5.5" /></svg>
      </a>
      <div class="hero-orbit orbit-a" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="hero-orbit orbit-b" aria-hidden="true"><i></i><i></i></div>
    </section>

    <section class="network-intro" aria-label="Council introduction">
      <p class="intro-index">CORE TEAM / 26</p>
      <p class="intro-copy">Meet the 17 coordinators at the center of a society nearly 50 members strong. Every project starts when one connection becomes a team.</p>
    </section>

    <div class="chapters">
      {chapters.map((chapter) => {
        const chapterMembers = members.filter((member) => member.group === chapter.key);
        return (
          <section class="member-chapter" id={chapter.key} data-member-chapter={chapter.key}>
            <header class="chapter-heading">
              <p class="chapter-count">{String(chapterMembers.length).padStart(2, '0')} core coordinators</p>
              <h2>{chapter.heading}</h2>
              <p>{chapter.note}</p>
              {chapter.listedMembers.length > 0 && (
                <div class="member-cluster" aria-label={`${chapter.listedMembers.length} members in ${chapter.title}`}>
                  <ul>
                    {chapter.listedMembers.map((memberName, index) => (
                      <li data-member-name={memberName} title={memberName} style={`--avatar-index:${index}`}>
                        <span aria-hidden="true">{avatarInitials(memberName)}</span>
                        <span class="sr-only">{memberName}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </header>

            <div class:list={['member-field', `field-${chapter.key}`]}>
              {chapterMembers.map((member, index) => (
                <article
                  class="member-node"
                  data-mesh-member
                  data-mesh-shape="silhouette"
                  data-achievement-card
                  data-member-index={index}
                  tabindex="0"
                  aria-label={`${member.name}, ${member.role}`}
                >
                  <div class="portrait-stage" data-mesh-frame>
                    {member.photo ? (
                      <img src={member.photo} alt="" loading={chapter.key === 'leadership' ? 'eager' : 'lazy'} />
                    ) : (
                      <div class="portrait-fallback" aria-hidden="true">
                        <span>{member.short}</span>
                        <svg viewBox="0 0 200 260"><path d="M100 24c31 0 51 25 51 58 0 29-14 47-28 57 34 9 58 39 62 96H15c4-57 28-87 62-96-15-10-28-28-28-57 0-33 20-58 51-58Z" /></svg>
                      </div>
                    )}
                    <span class="node-coordinate" aria-hidden="true">N{String(members.indexOf(member) + 1).padStart(2, '0')}</span>
                  </div>
                  <div class="member-label">
                    <h3>{member.name}</h3>
                    <p>{member.role}</p>
                    <span class="member-pulse" aria-hidden="true"></span>
                  </div>
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <section class="alumni-era alumni-era--2025" id="alumni-2025" data-alumni-era="2025" aria-labelledby="alumni-2025-title">
      <div class="era-stage">
        <div class="era-year" aria-hidden="true">2025</div>
        <div class="era-copy">
          <p class="era-generation">Generation 02 · 2025</p>
          <h2 id="alumni-2025-title">The signal<br />before us.</h2>
          <p>Twelve alumni carried Byte into its next orbit. Their roles form a relay: leadership, outreach and development passing momentum into today’s team.</p>
        </div>
        <div class="alumni-roster alumni-roster--2025" aria-label="2025 alumni">
          {alumni2025.map((person, index) => (
            <article
              class:list={['alumni-person', `alumni-person--${person.tier}`]}
              data-alumni-person
              data-alumni-year="2025"
              tabindex="0"
              style={`--person-index:${index};--person-column:${index % 4};--person-row:${Math.floor(index / 4)}`}
              aria-label={`${person.name}, ${person.role}`}
            >
              <div class="alumni-placeholder" aria-hidden="true">
                <i></i><i></i><span>{avatarInitials(person.name)}</span>
              </div>
              <div class="alumni-person-copy"><h3>{person.name}</h3><p>{person.role}</p></div>
            </article>
          ))}
        </div>
        <div class="era-record">
          <span>12 alumni · 5 roles</span>
          <strong>The relay generation</strong>
        </div>
        <div class="tunnel-cue" aria-hidden="true"><span></span><p>Continue to origin</p></div>
      </div>
    </section>

    <section class="alumni-era alumni-era--2024" id="alumni-2024" data-alumni-era="2024" aria-labelledby="alumni-2024-title">
      <div class="era-stage era-stage--founders">
        <div class="era-year" aria-hidden="true">2024</div>
        <div class="founder-tunnel" aria-hidden="true">
          <div class="origin-flare"></div>
          {Array.from({ length: 8 }, (_, index) => <i style={`--tunnel-ring:${index}`}></i>)}
          <span class="tunnel-axis tunnel-axis--x"></span>
          <span class="tunnel-axis tunnel-axis--y"></span>
        </div>
        <div class="founder-constellation" data-alumni-mesh-target data-mesh-reveal="0" aria-label="2024 founding alumni">
          <span class="origin-ring origin-ring--outer" aria-hidden="true"></span>
          <span class="origin-ring origin-ring--inner" aria-hidden="true"></span>
          {alumni2024.map((person, index) => (
            <article
              class:list={['alumni-person', 'founder-person', `alumni-person--${person.tier}`]}
              data-alumni-person
              data-alumni-year="2024"
              tabindex="0"
              style={`--person-index:${index};--founder-x:${founderPositions[index].x}%;--founder-y:${founderPositions[index].y}%;--burst-x:${(50 - founderPositions[index].x) * 0.72}vw;--burst-y:${(48 - founderPositions[index].y) * 0.6}vh`}
              aria-label={`${person.name}, ${person.role}`}
            >
              <div class="alumni-placeholder" aria-hidden="true">
                <i></i><i></i><span>{avatarInitials(person.name)}</span>
              </div>
              <div class="alumni-person-copy"><h3>{person.name}</h3><p>{person.role}</p></div>
            </article>
          ))}
          <div class="origin-caption" aria-hidden="true">
            <span>Origin point</span><strong>10 founders · one first spark</strong>
          </div>
        </div>
        <div class="era-copy era-copy--founders">
          <p class="era-generation">Generation 01 · 2024</p>
          <h2 id="alumni-2024-title">The first<br />spark.</h2>
          <p>Ten people made the leap from an idea to a society. Every connection, project and generation after them expands from this origin.</p>
        </div>
        <div class="era-record era-record--founders">
          <span>Founding generation · 2024</span>
          <strong>The origin of Byte</strong>
        </div>
      </div>
    </section>

    <section class="constellation-close" aria-label="Closing statement">
      <p>There is always room for another node.</p>
      <a href="/contact">Connect with Byte <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</Layout>

<script>
  const setupConstellation = () => {
    const root = document.querySelector<HTMLElement>('[data-members-concept="constellation"]');
    if (!root || root.dataset.enhanced === 'true') return;
    root.dataset.enhanced = 'true';

    const memberNodes = [...root.querySelectorAll<HTMLElement>('[data-mesh-member]')];
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-member-chapter]')];
    const railLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')];
    const alumniEras = [...root.querySelectorAll<HTMLElement>('[data-alumni-era]')];
    const founderTarget = root.querySelector<HTMLElement>('[data-alumni-mesh-target]');
    const mobile = window.matchMedia('(max-width: 760px), (hover: none)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let mobileFrame = 0;
    let alumniFrame = 0;

    const activate = (node: HTMLElement | null) => {
      memberNodes.forEach((item) => item.classList.toggle('is-mesh-active', item === node));
      root.classList.toggle('has-active-member', Boolean(node));
    };

    memberNodes.forEach((node) => {
      node.addEventListener('pointermove', (event) => {
        if (mobile.matches) return;
        const box = node.getBoundingClientRect();
        node.style.setProperty('--pointer-x', `${event.clientX - box.left}px`);
        node.style.setProperty('--pointer-y', `${event.clientY - box.top}px`);
      }, { passive: true });
      node.addEventListener('pointerenter', () => { if (!mobile.matches) activate(node); });
      node.addEventListener('pointerleave', () => { if (!mobile.matches && !node.matches(':focus-visible')) activate(null); });
      node.addEventListener('focus', () => activate(node));
      node.addEventListener('blur', () => { if (!mobile.matches) activate(null); });
    });

    const updateMobileFocus = () => {
      mobileFrame = 0;
      if (!mobile.matches) return;
      const center = window.innerHeight * 0.53;
      let nearest: HTMLElement | null = null;
      let distance = Infinity;
      memberNodes.forEach((node) => {
        const box = node.getBoundingClientRect();
        if (box.bottom < 80 || box.top > window.innerHeight - 40) return;
        const nextDistance = Math.abs(box.top + box.height * 0.5 - center);
        if (nextDistance < distance) {
          nearest = node;
          distance = nextDistance;
        }
      });
      activate(nearest);
    };

    const queueMobileFocus = () => {
      if (!mobileFrame) mobileFrame = requestAnimationFrame(updateMobileFocus);
    };

    const updateAlumniTunnel = () => {
      alumniFrame = 0;
      alumniEras.forEach((era) => {
        const rect = era.getBoundingClientRect();
        const distance = Math.max(1, rect.height - innerHeight);
        const progress = Math.min(1, Math.max(0, -rect.top / distance));
        era.style.setProperty('--era-progress', reducedMotion.matches ? '1' : progress.toFixed(4));
        era.classList.toggle('is-era-active', rect.top < innerHeight * 0.55 && rect.bottom > innerHeight * 0.45);

        const alumniPeople = [...era.querySelectorAll<HTMLElement>('[data-alumni-person]')];
        alumniPeople.forEach((person, index) => {
          const stagger = era.dataset.alumniEra === '2024'
            ? (person.classList.contains('alumni-person--lead') ? 0 : person.classList.contains('alumni-person--inner') ? 0.08 : 0.14 + index * 0.012)
            : index * 0.018;
          const duration = era.dataset.alumniEra === '2024' ? 0.48 : 0.58;
          const rawReveal = Math.min(1, Math.max(0, (progress - stagger) / duration));
          const reveal = reducedMotion.matches ? 1 : 1 - Math.pow(1 - rawReveal, 3);
          person.style.setProperty('--person-reveal', reveal.toFixed(4));
        });

        if (era.dataset.alumniEra === '2024' && founderTarget) {
          const reveal = Math.min(1, Math.max(0, (progress - 0.04) / 0.54));
          founderTarget.dataset.meshReveal = String(reducedMotion.matches ? 0 : reveal);
          root.style.setProperty('--founder-reveal', String(reducedMotion.matches ? 1 : reveal));
        }
      });
    };

    const queueAlumniTunnel = () => {
      if (!alumniFrame) alumniFrame = requestAnimationFrame(updateAlumniTunnel);
    };

    const chapterObserver = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => Math.abs(a.boundingClientRect.top - innerHeight * 0.28) - Math.abs(b.boundingClientRect.top - innerHeight * 0.28))[0];
      if (!visible) return;
      const key = (visible.target as HTMLElement).dataset.memberChapter;
      chapters.forEach((chapter) => chapter.classList.toggle('is-current', chapter === visible.target));
      railLinks.forEach((link) => {
        const current = link.dataset.railLink === key;
        link.classList.toggle('is-current', current);
        if (current) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    }, { rootMargin: '-18% 0px -58% 0px', threshold: 0 });

    chapters.forEach((chapter) => chapterObserver.observe(chapter));
    window.addEventListener('scroll', queueMobileFocus, { passive: true });
    window.addEventListener('resize', queueMobileFocus, { passive: true });
    window.addEventListener('scroll', queueAlumniTunnel, { passive: true });
    window.addEventListener('resize', queueAlumniTunnel, { passive: true });
    mobile.addEventListener('change', () => mobile.matches ? queueMobileFocus() : activate(null));
    queueMobileFocus();
    queueAlumniTunnel();
  };

  setupConstellation();
  document.addEventListener('astro:page-load', setupConstellation);
</script>

<style>
  @font-face {
    font-family: 'Clash Display';
    src: url('/assets/clash-600.woff2') format('woff2');
    font-weight: 600;
    font-display: swap;
  }

  @font-face {
    font-family: 'Clash Display';
    src: url('/assets/clash-700.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
  }

  :global(html) {
    background: #101010;
  }

  :global(body) {
    overflow-x: clip;
  }

  :global(::selection) {
    color: #07110b;
    background: #52e0a6;
  }

  .constellation-page {
    --ink: #eef4ef;
    --muted: #8d9a91;
    --green: #52e0a6;
    --line: rgba(139, 160, 147, 0.24);
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: rgba(16, 16, 16, 0.18);
    color: var(--ink);
  }

  .constellation-page::before {
    position: fixed;
    z-index: -1;
    inset: 0;
    background: radial-gradient(circle at 50% 48%, transparent 0 35%, rgba(16, 16, 16, 0.34) 100%);
    content: '';
    pointer-events: none;
  }

  .constellation-hero {
    position: relative;
    min-height: 100svh;
    padding: clamp(7rem, 14vh, 10rem) clamp(1.25rem, 4.6vw, 5rem) 3rem;
    display: grid;
    grid-template-columns: 1fr minmax(16rem, 27rem);
    grid-template-rows: auto 1fr auto;
    align-items: end;
    border-bottom: 1px solid var(--line);
  }

  .hero-meta {
    grid-column: 1 / -1;
    align-self: start;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font: 500 clamp(0.66rem, 0.75vw, 0.78rem)/1.2 Inter, sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero-meta p { margin: 0; }

  .constellation-hero h1 {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    margin: 0;
    width: 100%;
    align-self: center;
    font-family: 'Clash Display', Sora, sans-serif;
    font-size: clamp(5rem, 15.7vw, 14rem);
    font-weight: 700;
    line-height: 0.69;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .constellation-hero h1 > span {
    display: block;
    width: max-content;
  }

  .constellation-hero h1 > span:first-child {
    color: transparent;
    -webkit-text-stroke: 1px rgba(238, 244, 239, 0.48);
  }

  .constellation-hero h1 > span:last-child { margin-left: auto; }
  .constellation-hero h1 [data-mesh-dot] { color: var(--green); }

  .hero-thesis {
    grid-column: 1;
    max-width: 41ch;
    margin: 0;
    font: 500 clamp(1.05rem, 1.45vw, 1.35rem)/1.46 Inter, sans-serif;
    text-wrap: balance;
  }

  .hero-enter {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    border-bottom: 1px solid var(--green);
    color: var(--green);
    font: 600 0.75rem/1 Inter, sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-enter svg { width: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.5; }

  .hero-orbit {
    position: absolute;
    border: 1px solid rgba(82, 224, 166, 0.12);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-orbit i {
    position: absolute;
