  { name: 'Aniket Yadav', short: 'AY', role: 'Vice President', group: 'leadership', photo: '/team_pics/optimized/aniket_yadav_alpha.webp' },
  { name: 'Vansh', short: 'VA', role: 'Vice President', group: 'leadership', photo: '/team_pics/optimized/vansh_alpha.webp' },
  { name: 'Sanyam', short: 'SA', role: 'General Secretary', group: 'leadership', photo: '/team_pics/optimized/sanyam_alpha.webp' },
  { name: 'Krish Malik', short: 'KM', role: 'General Secretary', group: 'leadership', photo: '/team_pics/optimized/krish_malik_alpha.webp' },
  { name: 'Arpan', short: 'AR', role: 'Project Manager', group: 'leadership' },
  { name: 'Mohit Madan', short: 'MM', role: 'Project Manager', group: 'leadership' },
  { name: 'Aditya Gupta', short: 'AG', role: 'Development', group: 'development', photo: '/team_pics/optimized/aditya_gupta_alpha.webp' },
  { name: 'Khushi Dhankar', short: 'KD', role: 'Development', group: 'development', photo: '/team_pics/optimized/khushi_dhankar_alpha.webp' },
  { name: 'Shruti', short: 'SH', role: 'Cybersecurity', group: 'cybersecurity', photo: '/team_pics/optimized/shruti_alpha.webp' },
  { name: 'Tejas', short: 'TE', role: 'Cybersecurity', group: 'cybersecurity', photo: '/team_pics/optimized/tejas_alpha.webp' },
  { name: 'Punya', short: 'PA', role: 'Creative & Outreach', group: 'creative', photo: '/team_pics/optimized/punya_arora_alpha.webp' },
  { name: 'Chidroopa', short: 'CH', role: 'Creative & Outreach', group: 'creative', photo: '/team_pics/optimized/chidroopa_alpha.webp' },
  { name: 'Snow', short: 'SN', role: 'AIML', group: 'aiml', photo: '/team_pics/optimized/snow_alpha.webp' },
  { name: 'Krishna', short: 'KR', role: 'AIML', group: 'aiml', photo: '/team_pics/optimized/krishna_mudgal_alpha.webp' },
  { name: 'Aditya Maurya', short: 'AM', role: 'Mechatronics', group: 'mechatronics', photo: '/team_pics/optimized/aditya_maurya_alpha.webp' },
