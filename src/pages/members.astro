---
import Layout from '../layouts/Layout.astro';

/* ============================================================
   MEMBER DATA — edit everything in this block to update the
   members page. Nothing below "derived data" needs to change.

   Each person supports:
     name    — display name
     post    — role / title shown on their card
     category— 'current' | 'alumni'
     group   — only for category:'current' — one of:
                 'president' | 'vp' | 'secretariat' | a DEPARTMENTS key
     year    — only for category:'alumni' — graduation / batch year,
               used to group the alumni grid
     photo   — image URL (swap the placehold.co links for real photos)
     links   — any of instagram / linkedin / github / website / twitter.
               Leave a key out (or empty) and that icon just won't show.
   ============================================================ */

const SOCIETY_NAME = 'B.Y.T.E.';
const SECOND_TIER_LABEL = 'General Secretary';

const DEPARTMENTS = [
  { key: 'development', label: 'Development', desc: 'Building and shipping the software behind everything the society does.' },
  { key: 'cybersecurity', label: 'Cybersecurity', desc: "Securing systems, running audits, and keeping the society's infrastructure safe." },
  { key: 'creative', label: 'Creative & Outreach', desc: 'Shaping how the society looks, sounds, and reaches people outside it.' },
  { key: 'aiml', label: 'AIML', desc: "Exploring machine learning and AI-driven projects across the society's initiatives." },
  { key: 'mechatronics', label: 'Mechatronics', desc: 'Bridging hardware and software — robotics, embedded systems, and physical builds.' },
];

const TEAM = [
  // ---------------- Current Council ----------------
  { name: 'Swayam', post: 'President', category: 'current', group: 'president', photo: 'https://placehold.co/400x600', links: {} },

  { name: 'Aniket', post: 'Vice President', category: 'current', group: 'vp', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Vansh', post: 'Vice President', category: 'current', group: 'vp', photo: 'https://placehold.co/400x600', links: {} },

  { name: 'Sanyam', post: 'General Secretary', category: 'current', group: 'gensec', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Krish Malik', post: 'General Secretary', category: 'current', group: 'gensec', photo: 'https://placehold.co/400x600', links: {} },

  { name: 'Aditya Gupta', post: 'Development', category: 'current', group: 'development', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Arpan', post: 'Development', category: 'current', group: 'development', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Khushi', post: 'Development', category: 'current', group: 'development', photo: 'https://placehold.co/400x600', links: {} },

  { name: 'Shruti', post: 'Cybersecurity', category: 'current', group: 'cybersecurity', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Tejas', post: 'Cybersecurity', category: 'current', group: 'cybersecurity', photo: 'https://placehold.co/400x600', links: {} },

  { name: 'Punya', post: 'Creative & Outreach', category: 'current', group: 'creative', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Chidroopa', post: 'Creative & Outreach', category: 'current', group: 'creative', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Priyanka', post: 'Creative & Outreach', category: 'current', group: 'creative', photo: 'https://placehold.co/400x600', links: {} },

  { name: 'Snow', post: 'AIML', category: 'current', group: 'aiml', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Krishna', post: 'AIML', category: 'current', group: 'aiml', photo: 'https://placehold.co/400x600', links: {} },

  { name: 'Aditya Maurya', post: 'Mechatronics', category: 'current', group: 'mechatronics', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Devesh', post: 'Mechatronics', category: 'current', group: 'mechatronics', photo: 'https://placehold.co/400x600', links: {} },

  // ---------------- Alumni ----------------
  { name: 'Devika Rao', post: 'Founding President', category: 'alumni', year: '2022', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Arjun Malhotra', post: 'Vice President', category: 'alumni', year: '2023', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Sneha Kapoor', post: 'Technical Lead', category: 'alumni', year: '2023', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Rahul Verma', post: 'Design Lead', category: 'alumni', year: '2024', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Tanvi Joshi', post: 'Events Lead', category: 'alumni', year: '2024', photo: 'https://placehold.co/400x600', links: {} },
  { name: 'Yash Thakur', post: 'Marketing Lead', category: 'alumni', year: '2025', photo: 'https://placehold.co/400x600', links: {} },
];

/* ============================================================
   Derived data — you shouldn't need to touch anything below this.
   ============================================================ */
const currentTeam = TEAM.filter((m) => m.category === 'current');
const alumni = TEAM.filter((m) => m.category === 'alumni');

const president = currentTeam.find((m) => m.group === 'president');
const vps = currentTeam.filter((m) => m.group === 'vp');
const secretariat = currentTeam.filter((m) => m.group === 'secretariat');

const deptByKey = DEPARTMENTS
  .map((dept) => ({ dept, members: currentTeam.filter((m) => m.group === dept.key) }))
  .filter((d) => d.members.length > 0);

const alumniYears = Array.from(new Set(alumni.map((m) => m.year))).sort((a, b) => Number(b) - Number(a));
const alumniByYear = alumniYears.map((year) => ({ year, members: alumni.filter((m) => m.year === year) }));

const SOCIAL_ORDER = ['linkedin', 'github', 'website', 'instagram', 'twitter'];
const SOCIAL_LABELS = { linkedin: 'LinkedIn', github: 'GitHub', website: 'Website', instagram: 'Instagram', twitter: 'Twitter' };
const ICONS = {
  instagram: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>',
  linkedin: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 11-.01 5.001A2.5 2.5 0 014.98 3.5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05C20.9 8.65 21 11.5 21 14.4V21h-4v-6c0-1.4-.03-3.2-1.95-3.2-1.96 0-2.26 1.53-2.26 3.1V21H9z"/></svg>',
  github: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.36-3.37-1.36-.46-1.2-1.11-1.52-1.11-1.52-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.32.1-2.75 0 0 .84-.28 2.75 1.05a9.3 9.3 0 015 0c1.9-1.33 2.74-1.05 2.74-1.05.56 1.43.21 2.49.1 2.75.65.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.02 10.02 0 0022 12.2C22 6.58 17.52 2 12 2z"/></svg>',
  website: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3z"/></svg>',
  twitter: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 6.5c-.63.29-1.3.48-2 .57a3.5 3.5 0 001.53-1.93 6.9 6.9 0 01-2.2.85 3.47 3.47 0 00-5.9 3.17A9.85 9.85 0 014.1 5.6a3.47 3.47 0 001.08 4.63c-.55-.02-1.07-.17-1.53-.42v.04a3.47 3.47 0 002.79 3.4c-.5.14-1.03.16-1.53.06a3.48 3.48 0 003.25 2.41A6.96 6.96 0 013 17.55a9.83 9.83 0 005.32 1.56c6.38 0 9.87-5.3 9.87-9.9l-.01-.45c.68-.49 1.26-1.1 1.72-1.8-.62.28-1.28.46-1.9.55z"/></svg>',
};
---

<Layout title={`Members — ${SOCIETY_NAME}`} active="members">
  <div class="page-header">
    <div class="wrap">
      <h1>Our Members</h1>
      <p>{currentTeam.length} on the current council · {alumni.length} alumni</p>
    </div>
  </div>

  <section class="members-page">
    <div class="wrap">
      <!-- big category selector -->
      <div class="category-selector" role="tablist" aria-label="Member category">
        <button class="category-btn active" data-category="current" role="tab" aria-selected="true" type="button">
          <span class="category-num">{currentTeam.length}</span>
          <span class="category-label">Current Council</span>
          <span class="category-sub">Meet this year's team</span>
        </button>
        <button class="category-btn" data-category="alumni" role="tab" aria-selected="false" type="button">
          <span class="category-num">{alumni.length}</span>
          <span class="category-label">Alumni</span>
          <span class="category-sub">Past leaders &amp; members</span>
        </button>
      </div>

      <!-- ============ CURRENT COUNCIL ============ -->
      <div class="council-panel active" data-category="current" role="tabpanel" aria-label="Current council">
        <section class="leadership">
          {president && vps.length === 2 ? (
            <div class="offgrid-row">
              <div class="tile vp left" data-name={vps[0].name} data-post={vps[0].post} data-photo={vps[0].photo} data-links={JSON.stringify(vps[0].links ?? {})} role="button" tabindex="0" aria-label={`${vps[0].name}, ${vps[0].post}`}>
                <img src={vps[0].photo} alt={vps[0].name} loading="lazy" />
                <span class="tile-tag">{vps[0].post}</span>
                <div class="tile-cap"><div class="name">{vps[0].name}</div><div class="post">{vps[0].post}</div></div>
              </div>
              <div class="tile president" data-name={president.name} data-post={president.post} data-photo={president.photo} data-links={JSON.stringify(president.links ?? {})} role="button" tabindex="0" aria-label={`${president.name}, ${president.post}`}>
                <img src={president.photo} alt={president.name} loading="lazy" />
                <span class="tile-tag">{president.post}</span>
                <div class="tile-cap"><div class="name">{president.name}</div><div class="post">{president.post}</div></div>
              </div>
              <div class="tile vp right" data-name={vps[1].name} data-post={vps[1].post} data-photo={vps[1].photo} data-links={JSON.stringify(vps[1].links ?? {})} role="button" tabindex="0" aria-label={`${vps[1].name}, ${vps[1].post}`}>
                <img src={vps[1].photo} alt={vps[1].name} loading="lazy" />
                <span class="tile-tag">{vps[1].post}</span>
                <div class="tile-cap"><div class="name">{vps[1].name}</div><div class="post">{vps[1].post}</div></div>
              </div>
            </div>
          ) : (
            <>
              <div class="offgrid-row">
                {president && (
                  <div class="tile president" data-name={president.name} data-post={president.post} data-photo={president.photo} data-links={JSON.stringify(president.links ?? {})} role="button" tabindex="0" aria-label={`${president.name}, ${president.post}`}>
                    <img src={president.photo} alt={president.name} loading="lazy" />
                    <span class="tile-tag">{president.post}</span>
                    <div class="tile-cap"><div class="name">{president.name}</div><div class="post">{president.post}</div></div>
                  </div>
                )}
              </div>
              {vps.length > 0 && (
                <div class="vp-fallback-row">
                  {vps.map((m) => (
                    <div class="tile" data-name={m.name} data-post={m.post} data-photo={m.photo} data-links={JSON.stringify(m.links ?? {})} role="button" tabindex="0" aria-label={`${m.name}, ${m.post}`}>
                      <img src={m.photo} alt={m.name} loading="lazy" />
                      <span class="tile-tag">{m.post}</span>
                      <div class="tile-cap"><div class="name">{m.name}</div><div class="post">{m.post}</div></div>
                    </div>
                  ))}
                </div>
              )}
            </>
          )}

          {secretariat.length > 0 && (
            <>
              <div class="tier-heading">{SECOND_TIER_LABEL}</div>
              <div class="tile-row gensec-row">
                {secretariat.map((m) => (
                  <div class="tile" data-name={m.name} data-post={m.post} data-photo={m.photo} data-links={JSON.stringify(m.links ?? {})} role="button" tabindex="0" aria-label={`${m.name}, ${m.post}`}>
                    <img src={m.photo} alt={m.name} loading="lazy" />
                    <span class="tile-tag">{m.post}</span>
                    <div class="tile-cap"><div class="name">{m.name}</div><div class="post">{m.post}</div></div>
                  </div>
                ))}
              </div>
            </>
          )}
        </section>

        {deptByKey.length > 0 && (
          <section class="dept-section" id="departments">
            <div class="dept-grid">
              <div class="dept-left">
                <div class="dept-nav">
                  {deptByKey.map(({ dept, members }, i) => (
                    <div class:list={['dept-nav-entry', { active: i === 0 }]} data-key={dept.key}>
                      <button type="button" class:list={['dept-nav-item', { active: i === 0 }]} data-key={dept.key}>{dept.label}</button>
                      <div class="dept-nav-info">
                        <p class="dept-desc">{dept.desc}</p>
                        <div class="honeycomb">
                          {members.map((m) => (
                            <div class="hex-item">
                              <div class="hex-circle" role="button" tabindex="0" data-name={m.name} data-post={m.post} data-photo={m.photo} data-links={JSON.stringify(m.links ?? {})} aria-label={`${m.name}, ${m.post}`}>
                                <img src={m.photo} alt={m.name} loading="lazy" />
                              </div>
                              <span class="hex-name">{m.name}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
              <div class="dept-right">
                <div class="dept-cards">
                  {deptByKey.map(({ dept, members }) => (
                    <section class="dept-panel" id={`panel-${dept.key}`} data-key={dept.key}>
                      <div class="dept-panel-heading">{dept.label}</div>
                      <div class="dept-panel-grid">
                        {members.map((m) => (
                          <div class="tile" data-name={m.name} data-post={m.post} data-photo={m.photo} data-links={JSON.stringify(m.links ?? {})} role="button" tabindex="0" aria-label={`${m.name}, ${m.post}`}>
                            <img src={m.photo} alt={m.name} loading="lazy" />
                            <span class="tile-tag">{m.post}</span>
                            <div class="tile-cap"><div class="name">{m.name}</div><div class="post">{m.post}</div></div>
                          </div>
                        ))}
                      </div>
                    </section>
                  ))}
                </div>
              </div>
            </div>
          </section>
        )}
      </div>

      <!-- ============ ALUMNI ============ -->
      <div class="council-panel" data-category="alumni" role="tabpanel" aria-label="Alumni">
        {alumniByYear.length > 0 ? (
          alumniByYear.map(({ year, members }) => (
            <>
              <div class="tier-heading">Batch of {year}</div>
              <div class="tile-row alumni-row">
                {members.map((m) => (
                  <div class="tile" data-name={m.name} data-post={m.post} data-photo={m.photo} data-links={JSON.stringify(m.links ?? {})} role="button" tabindex="0" aria-label={`${m.name}, ${m.post}`}>
                    <img src={m.photo} alt={m.name} loading="lazy" />
                    <span class="tile-tag">{m.post}</span>
                    <div class="tile-cap"><div class="name">{m.name}</div><div class="post">{m.post}</div></div>
                  </div>
                ))}
              </div>
            </>
          ))
        ) : (
          <p class="empty-note">Alumni details coming soon.</p>
        )}
      </div>
    </div>
  </section>

  <!-- spotlight modal (shared by both categories) -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal-panel" id="modalPanel">
      <button class="modal-close" id="modalClose" aria-label="Close">✕</button>
      <button class="modal-nav prev" id="modalPrev" aria-label="Previous person">‹</button>
      <button class="modal-nav next" id="modalNext" aria-label="Next person">›</button>
      <div class="modal-photo-wrap"><img id="modalPhoto" src="" alt="" /></div>
      <div class="modal-cap">
        <div class="modal-name" id="modalName"></div>
        <div class="modal-post" id="modalPost"></div>
        <div class="modal-links" id="modalLinks"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;500&display=swap');

  .members-page { padding-top: 8px; }
  .empty-note { text-align: center; color: var(--text-faint); padding: 40px 0; }

  /* ---------- category selector ---------- */
  .category-selector { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 56px; }
  .category-btn {
    display: flex; flex-direction: column; align-items: flex-start; gap: 4px; text-align: left;
    padding: 28px 30px; border-radius: 14px; border: 1px solid var(--line); background: var(--panel);
    transition: border-color .2s ease, background .2s ease, transform .2s ease;
  }
  .category-btn:hover { border-color: #2a3d2c; transform: translateY(-2px); }
  .category-btn.active { border-color: var(--lime); background: linear-gradient(135deg, rgba(34,197,121,0.14), var(--panel) 60%); }
  .category-num { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 2.2rem; color: var(--lime); line-height: 1; }
  .category-label { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.15rem; text-transform: uppercase; letter-spacing: .01em; margin-top: 8px; }
  .category-sub { color: var(--text-faint); font-size: .85rem; }

  /* ---------- shared tile ---------- */
  .tile { position: relative; border-radius: 12px; overflow: hidden; background: var(--panel); border: 1px solid var(--line); cursor: pointer; transition: box-shadow .25s ease, border-color .2s ease, transform .25s ease; }
  .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: filter .3s ease, transform .3s ease; }
  .tile:hover img { filter: grayscale(0) contrast(1.05); transform: scale(1.035); }
  .tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(4,7,5,.9) 100%); pointer-events: none; }
  .tile-tag { position: absolute; top: 10px; left: 10px; z-index: 2; font-family: 'JetBrains Mono', monospace; font-size: .6rem; letter-spacing: .05em; color: var(--text); text-transform: uppercase; background: rgba(6,9,7,.6); backdrop-filter: blur(6px); padding: 4px 8px; border-radius: 6px; }
  .tile-cap { position: absolute; left: 14px; right: 14px; bottom: 13px; z-index: 2; }
  .tile-cap .name { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1rem; text-transform: uppercase; letter-spacing: -.01em; position: relative; display: inline-block; }
  .tile-cap .name::after { content: ''; position: absolute; left: 0; bottom: -3px; height: 1px; width: 0; background: var(--lime-bright); transition: width .2s ease; }
  .tile:hover .tile-cap .name::after { width: 100%; }
  .tile-cap .post { font-family: 'JetBrains Mono', monospace; font-size: .72rem; color: var(--text-dim); letter-spacing: .04em; text-transform: uppercase; margin-top: 3px; }

  /* ---------- leadership offgrid ---------- */
  .leadership { position: relative; padding: 5vh 0 3vh; overflow: hidden; }
  .offgrid-row { display: flex; align-items: flex-start; justify-content: center; padding: 26px 0 18px; flex-wrap: wrap; }
  .offgrid-row .tile { border-radius: 8px; }
  .offgrid-row .tile.president { --stagger: -34px; width: clamp(260px, 31vw, 370px); height: clamp(340px, 40vw, 470px); z-index: 3; transform: translateY(var(--stagger)); box-shadow: 0 34px 64px -20px rgba(0,0,0,.8); }
  .offgrid-row .tile.vp { --stagger: 58px; width: clamp(210px, 24vw, 285px); height: clamp(275px, 31vw, 360px); z-index: 1; transform: translateY(var(--stagger)); }
  .offgrid-row .tile.vp.left { margin-right: 18px; }
  .offgrid-row .tile.vp.right { margin-left: 18px; }
  .offgrid-row .tile:hover { transform: translateY(calc(var(--stagger) - 6px)); border-color: var(--lime); box-shadow: 0 26px 50px -18px rgba(0,0,0,.7); }
  .offgrid-row .tile.president img, .offgrid-row .tile.president:hover img { filter: grayscale(1) contrast(1.12); }
  .offgrid-row .tile.president:hover img { transform: scale(1.025); }
  .offgrid-row .tile.president .tile-cap .name { font-size: clamp(1.4rem, 2.8vw, 2.1rem); }
  .offgrid-row .tile.president .tile-cap .post { font-size: .78rem; }
  .offgrid-row .tile.vp .tile-cap .name { font-size: clamp(1rem, 1.7vw, 1.25rem); }
  .offgrid-row .tile.vp .tile-cap .post { font-size: .68rem; }

  .vp-fallback-row { display: flex; flex-wrap: wrap; gap: 22px; justify-content: center; margin-top: 30px; }
  .vp-fallback-row .tile { width: min(240px, 44vw); aspect-ratio: 3/4; }
  .vp-fallback-row .tile .tile-cap .name { font-size: 1.15rem; }

  @media (max-width: 700px) {
    .offgrid-row .tile.president { --stagger: -10px; width: clamp(230px, 58vw, 300px); height: clamp(300px, 74vw, 390px); }
    .offgrid-row .tile.vp { --stagger: 22px; width: clamp(150px, 39vw, 205px); height: clamp(195px, 50vw, 270px); }
    .offgrid-row .tile.vp.left { margin-right: 7px; }
    .offgrid-row .tile.vp.right { margin-left: 7px; }
  }

  .tier-heading { text-align: center; font-family: 'JetBrains Mono', monospace; font-size: .7rem; letter-spacing: .15em; color: var(--text-faint); text-transform: uppercase; margin: 44px 0 20px; }
  .tile-row { display: flex; flex-wrap: wrap; gap: 22px; justify-content: center; }
  .gensec-row .tile, .alumni-row .tile { width: min(240px, 46vw); aspect-ratio: 3/4; }
  .gensec-row .tile-cap .name, .alumni-row .tile-cap .name { font-size: 1.15rem; }
  .gensec-row .tile-cap .post, .alumni-row .tile-cap .post { font-size: .72rem; }

  /* ---------- departments ---------- */
  .dept-section { position: relative; padding: 9vh 0 12vh; }
  .dept-grid { display: grid; grid-template-columns: minmax(280px, .88fr) minmax(0, 1.4fr); gap: 6vw; align-items: stretch; }
  .dept-left { position: sticky; top: 90px; align-self: start; height: calc(100vh - 130px); min-height: 460px; display: flex; align-items: center; }
  .dept-nav { width: 100%; display: flex; flex-direction: column; gap: 4px; }
  .dept-nav-item { appearance: none; background: none; border: none; font: inherit; text-align: left; cursor: pointer; display: block; width: 100%; font-family: 'Space Grotesk', sans-serif; letter-spacing: -.01em; color: var(--text-dim); font-size: 1rem; font-weight: 500; text-transform: uppercase; padding: 10px 0; transition: color .2s ease, font-size .2s ease, transform .2s ease; }
  .dept-nav-item:hover:not(.active) { color: var(--text); transform: translateX(4px); }
  .dept-nav-item.active { color: var(--text); font-size: 1.5rem; font-weight: 700; }
  .dept-nav-info { display: none; padding: 0 0 18px 0; max-width: 44ch; }
  .dept-nav-entry.active .dept-nav-info { display: block; }
  .dept-desc { color: var(--text-dim); font-size: 1rem; line-height: 1.65; }

  .honeycomb { display: flex; flex-wrap: wrap; gap: 16px 14px; margin-top: 22px; min-height: 74px; }
  .hex-item { display: flex; flex-direction: column; align-items: center; }
  .hex-circle { width: min(52px, 15vw); aspect-ratio: 1/1; border-radius: 50%; overflow: hidden; border: 2px solid var(--line); cursor: pointer; transition: border-color .2s ease; }
  .hex-circle:hover { border-color: var(--lime); }
  .hex-circle img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); transition: filter .2s ease, transform .2s ease; }
  .hex-circle:hover img { filter: grayscale(0); transform: scale(1.08); }
  .hex-name { font-family: 'JetBrains Mono', monospace; font-size: .62rem; color: var(--text-faint); margin-top: 7px; text-align: center; }

  .dept-right { min-width: 0; }
  .dept-cards { display: flex; flex-direction: column; gap: 14vh; }
  .dept-panel { scroll-margin-top: 90px; min-height: 60vh; }
  .dept-panel-heading { font-family: 'Space Grotesk', sans-serif; font-size: 1.4rem; font-weight: 700; text-transform: uppercase; letter-spacing: -.01em; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .dept-panel-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 20px; }
  .dept-panel-grid .tile { aspect-ratio: 3/4; }
  .dept-panel-grid .tile-cap .name { font-size: 1.12rem; }

  @media (max-width: 900px) {
    .dept-section { padding-top: 0; }
    .dept-grid { grid-template-columns: 1fr; gap: 0; }
    .dept-left { position: static; height: auto; min-height: 0; display: block; }
    .dept-nav { flex-direction: row; overflow-x: auto; gap: 22px; position: sticky; top: 73px; z-index: 30; padding: 14px 0; margin: 0; background: rgba(6,9,7,.9); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
    .dept-nav-entry { width: auto; flex: 0 0 auto; }
    .dept-nav-item { white-space: nowrap; width: auto; font-size: .82rem !important; padding: 0; }
    .dept-nav-item.active { font-size: 1rem !important; }
    .dept-nav-info { padding-bottom: 18px; }
    .dept-right { margin-top: 36px; }
    .dept-cards { gap: 10vh; }
    .dept-panel { min-height: auto; }
    .dept-panel-grid { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; }
  }

  .council-panel { display: none; }
  .council-panel.active { display: block; }

  /* ---------- spotlight modal ---------- */
  .modal-overlay { position: fixed; inset: 0; z-index: 200; background: rgba(4,6,5,.8); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .2s ease; }
  .modal-overlay.open { opacity: 1; pointer-events: auto; }
  .modal-panel { position: relative; width: min(820px, 92vw); max-height: 90vh; background: rgba(16,22,15,.9); border: 1px solid rgba(255,255,255,.07); backdrop-filter: blur(20px); border-radius: 20px; padding: 38px 30px 32px; display: flex; flex-direction: column; align-items: center; text-align: center; overflow: auto; transform: scale(.97); transition: transform .2s ease; }
  .modal-overlay.open .modal-panel { transform: scale(1); }
  .modal-photo-wrap { position: relative; z-index: 1; width: min(300px, 44vw); aspect-ratio: 4/5; border-radius: 14px; overflow: hidden; box-shadow: 0 20px 50px -12px rgba(0,0,0,.6); }
  .modal-photo-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .modal-cap { position: relative; z-index: 1; margin-top: 16px; }
  .modal-name { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.3rem; text-transform: uppercase; }
  .modal-post { font-family: 'JetBrains Mono', monospace; font-size: .72rem; color: var(--lime-bright); letter-spacing: .06em; text-transform: uppercase; margin-top: 5px; }
  .modal-links { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 22px; min-height: 40px; width: 100%; }
  .modal-links a, .modal-links .social-disabled { display: flex; align-items: center; justify-content: center; gap: 9px; min-width: 128px; height: 40px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: rgba(255,255,255,.025); font-family: 'JetBrains Mono', monospace; font-size: .68rem; text-transform: uppercase; letter-spacing: .05em; color: var(--text-dim); }
  .modal-links svg { width: 18px; height: 18px; flex: 0 0 auto; }
  .modal-links a { transition: color .15s ease, border-color .15s ease, background .15s ease; }
  .modal-links a:hover { color: var(--lime-bright); border-color: var(--lime); background: rgba(34,197,121,.08); }
  .modal-links .social-disabled { opacity: .38; cursor: default; }
  .modal-close, .modal-nav { position: absolute; z-index: 2; background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.1); color: var(--text); border-radius: 50%; width: 34px; height: 34px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1rem; transition: background .15s ease, border-color .15s ease; }
  .modal-close:hover, .modal-nav:hover { background: rgba(34,197,121,.25); border-color: var(--lime); }
  .modal-close { top: 14px; right: 14px; }
  .modal-nav.prev { left: 14px; top: 50%; transform: translateY(-50%); }
  .modal-nav.next { right: 14px; top: 50%; transform: translateY(-50%); }

  @media (max-width: 640px) {
    .category-selector { grid-template-columns: 1fr; }
    .modal-nav { display: none; }
    .modal-panel { width: 92vw; padding: 30px 20px 26px; }
    .modal-photo-wrap { width: min(210px, 56vw); }
  }
</style>

<script define:vars={{ ICONS, SOCIAL_LABELS, SOCIAL_ORDER }}>
  // ---------- big category selector: current council vs alumni ----------
  const categoryButtons = document.querySelectorAll('.category-btn');
  const councilPanels = document.querySelectorAll('.council-panel');
  categoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.category;
      categoryButtons.forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
      });
      councilPanels.forEach((p) => p.classList.toggle('active', p.dataset.category === cat));
    });
  });

  // ---------- departments: sticky nav + scroll-spy ----------
  (function initDepartments() {
    const nav = document.querySelector('.dept-nav');
    const cardsWrap = document.querySelector('.dept-cards');
    if (!nav || !cardsWrap) return;

    const entries = Array.from(nav.querySelectorAll('.dept-nav-entry'));
    const buttons = Array.from(nav.querySelectorAll('.dept-nav-item'));
    const panels = Array.from(cardsWrap.querySelectorAll('.dept-panel'));

    function setActive(key) {
      entries.forEach((e) => e.classList.toggle('active', e.dataset.key === key));
      buttons.forEach((b) => b.classList.toggle('active', b.dataset.key === key));
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        document.getElementById(`panel-${btn.dataset.key}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    if (panels.length) {
      const observer = new IntersectionObserver(() => {
        const visible = panels.filter((p) => {
          const r = p.getBoundingClientRect();
          return r.bottom > window.innerHeight * 0.18 && r.top < window.innerHeight * 0.82;
        });
        if (!visible.length) return;
        visible.sort((a, b) => {
          const ar = a.getBoundingClientRect();
          const br = b.getBoundingClientRect();
          const ac = Math.abs(ar.top + ar.height / 2 - window.innerHeight / 2);
          const bc = Math.abs(br.top + br.height / 2 - window.innerHeight / 2);
          return ac - bc;
        });
        setActive(visible[0].dataset.key);
      }, { threshold: [0.2, 0.45, 0.7], rootMargin: '-18% 0px -18% 0px' });
      panels.forEach((p) => observer.observe(p));
      setActive(panels[0].dataset.key);
    }
  })();

  // ---------- spotlight modal ----------
  (function initModal() {
    const overlay = document.getElementById('modalOverlay');
    const photoEl = document.getElementById('modalPhoto');
    const nameEl = document.getElementById('modalName');
    const postEl = document.getElementById('modalPost');
    const linksEl = document.getElementById('modalLinks');
    let currentList = [];
    let currentIndex = 0;

    function keyOf(node) { return `${node.dataset.name}|${node.dataset.post}`; }

    function getActiveList() {
      const root = document.querySelector('.council-panel.active') || document;
      const nodes = Array.from(root.querySelectorAll('[data-name]'));
      const seen = new Set();
      const list = [];
      nodes.forEach((n) => {
        const key = keyOf(n);
        if (!seen.has(key)) { seen.add(key); list.push(n); }
      });
      return list;
    }

    function linksHTML(links) {
      return SOCIAL_ORDER.map((k) => {
        const label = SOCIAL_LABELS[k];
        const icon = ICONS[k] || '';
        const url = (links || {})[k];
        if (url) {
          return `<a href="${url}" target="_blank" rel="noopener" aria-label="${label}">${icon}<span>${label}</span></a>`;
        }
        return `<span class="social-disabled" aria-label="${label} not added">${icon}<span>${label}</span></span>`;
      }).join('');
    }

    function renderModal(node) {
      let links = {};
      try { links = JSON.parse(node.dataset.links || '{}'); } catch (e) { links = {}; }
      photoEl.src = node.dataset.photo;
      photoEl.alt = node.dataset.name;
      nameEl.textContent = node.dataset.name;
      postEl.textContent = node.dataset.post;
      linksEl.innerHTML = linksHTML(links);
    }

    function openModalFromNode(node) {
      currentList = getActiveList();
      const key = keyOf(node);
      currentIndex = currentList.findIndex((n) => keyOf(n) === key);
      if (currentIndex === -1) currentIndex = 0;
      renderModal(currentList[currentIndex] || node);
      overlay.classList.add('open');
    }

    function step(delta) {
      if (!currentList.length) return;
      currentIndex = (currentIndex + delta + currentList.length) % currentList.length;
      renderModal(currentList[currentIndex]);
    }

    function closeModal() { overlay.classList.remove('open'); }

    document.addEventListener('click', (e) => {
      const node = e.target.closest('[data-name]');
      if (node) openModalFromNode(node);
    });
    document.addEventListener('keydown', (e) => {
      if ((e.key === 'Enter' || e.key === ' ') && e.target.matches && e.target.matches('[data-name]')) {
        e.preventDefault();
        openModalFromNode(e.target);
      }
    });

    document.getElementById('modalClose').addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
    document.getElementById('modalNext').addEventListener('click', () => step(1));
    document.getElementById('modalPrev').addEventListener('click', () => step(-1));
    document.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('open')) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
    });
  })();
</script>
