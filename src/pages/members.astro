---
import Layout from '../layouts/Layout.astro';

type Member = {
  name: string;
  short: string;
  role: string;
  group: 'leadership' | 'development' | 'cybersecurity' | 'creative' | 'aiml' | 'mechatronics';
  photo?: string;
};

const members: Member[] = [
