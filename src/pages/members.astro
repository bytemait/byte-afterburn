  { name: 'Arnav Chopra', role: 'President', tier: 'lead' },
  { name: 'Vipul Kohli', role: 'Vice President', tier: 'inner' },
  { name: 'Pratham Gupta', role: 'Vice President', tier: 'inner' },
  { name: 'Sukaran Gulati', role: 'Vice President', tier: 'inner' },
  { name: 'Divyansh Kalra', role: 'General Secretary', tier: 'inner' },
  { name: 'Anagh Miglani', role: 'General Secretary', tier: 'inner' },
  { name: 'Shrey Garg', role: 'Creative Outreach', tier: 'outer' },
  { name: 'Jahnvi Pareek', role: 'Creative Outreach', tier: 'outer' },
  { name: 'Dishant Pandey', role: 'Creative Outreach', tier: 'outer' },
  { name: 'Manan Wadhwa', role: 'Development Coordinator', tier: 'outer' },
  { name: 'Kush Aheer', role: 'Development Coordinator', tier: 'outer' },
