---
import Layout from '../layouts/Layout.astro';
import { events } from '../data/events';

const upcomingEvents = events.filter((e) => e.isUpcoming);
const pastEvents = events.filter((e) => !e.isUpcoming);
---

<Layout title="Events — B.Y.T.E." active="events">
  <div class="page-header">
    <div class="wrap">
      <h1>Events</h1>
      <p>Discover. Learn. Grow. Together.</p>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="filter-row">
        <button class="filter-pill active">All</button>
        <button class="filter-pill">Workshop</button>
        <button class="filter-pill">Competition</button>
        <button class="filter-pill">Tech Talk</button>
        <button class="filter-pill">Social</button>
      </div>

      {upcomingEvents.length > 0 && (
        <div class="events-section-block" style="margin-bottom: 80px;">
          <h2 style="font-family: 'Clash Display', sans-serif; font-size: 2rem; color: #fff; margin-bottom: 30px;">Upcoming Events</h2>
          <div class="events-list">
            {upcomingEvents.map((event, index) => {
              const isFlip = index % 2 === 1;
              const [day, month] = event.date.split(' ');
              return (
                <div class={`event-card ${isFlip ? 'flip' : ''}`}>
                  {!isFlip && (
                    <div class="ph" data-ratio="800 × 600"><span class="ph-tag">Event photo</span><svg><use href="#i-image"/></svg></div>
                  )}
                  <div class="event-body">
                    <div class="date-chip"><b>{day}</b><span>{month}</span></div>
                    <div class="event-content">
                      <h3>{event.name}</h3>
                      <p>{event.shortDescription}</p>
                      <div class="meta-row">
                        <span><svg><use href="#i-clock"/></svg>{event.time}</span>
                        <span><svg><use href="#i-pin"/></svg>{event.venue}</span>
                      </div>
                      <a href={`/events/${event.slug}`} class="link-btn">View Details <svg><use href="#i-arrow"/></svg></a>
                    </div>
                  </div>
                  {isFlip && (
                    <div class="ph" data-ratio="800 × 600"><span class="ph-tag">Event photo</span><svg><use href="#i-image"/></svg></div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      {pastEvents.length > 0 && (
        <div class="events-section-block">
          <h2 style="font-family: 'Clash Display', sans-serif; font-size: 2rem; color: #fff; margin-bottom: 30px; opacity: 0.8;">Past Events</h2>
          <div class="events-list" style="opacity: 0.7;">
            {pastEvents.map((event, index) => {
              const isFlip = index % 2 === 1;
              const [day, month] = event.date.split(' ');
              return (
                <div class={`event-card ${isFlip ? 'flip' : ''}`}>
                  {!isFlip && (
                    <div class="ph" data-ratio="800 × 600"><span class="ph-tag">Archive photo</span><svg><use href="#i-image"/></svg></div>
                  )}
                  <div class="event-body">
                    <div class="date-chip"><b>{day}</b><span>{month}</span></div>
                    <div class="event-content">
                      <h3>{event.name}</h3>
                      <p>{event.shortDescription}</p>
                      <div class="meta-row">
                        <span><svg><use href="#i-clock"/></svg>{event.time}</span>
                        <span><svg><use href="#i-pin"/></svg>{event.venue}</span>
                      </div>
                      <a href={`/events/${event.slug}`} class="link-btn">View Details <svg><use href="#i-arrow"/></svg></a>
                    </div>
                  </div>
                  {isFlip && (
                    <div class="ph" data-ratio="800 × 600"><span class="ph-tag">Archive photo</span><svg><use href="#i-image"/></svg></div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      {upcomingEvents.length === 0 && pastEvents.length === 0 && (
        <div class="empty-events" style="text-align: center; color: #888; padding: 60px 0;">
          <p>No events found.</p>
        </div>
      )}
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="newsletter">
        <div>
          <h3>Stay Updated</h3>
          <p>Subscribe to get the latest updates about our events.</p>
        </div>
        <div class="newsletter-form">
          <input type="email" placeholder="Enter your email">
          <button class="btn btn-primary">Subscribe</button>
        </div>
        <div class="ph newsletter-visual"><svg><use href="#i-mail"/></svg></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.filter-pill').forEach((p) => {
    p.addEventListener('click', () => {
      document.querySelectorAll('.filter-pill').forEach((x) => x.classList.remove('active'));
      p.classList.add('active');
    });
  });
</script>
