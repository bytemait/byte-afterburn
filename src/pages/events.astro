---
import Layout from '../layouts/Layout.astro';
import { events } from '../data/events';

// Helper to parse dates for sorting (combines "DD MMM" with "YYYY")
function parseDate(dateStr: string, yearStr: string = '2026') {
  return new Date(`${dateStr} ${yearStr}`).getTime();
}

const sortedEvents = [...events].sort((a, b) => parseDate(b.date, b.year) - parseDate(a.date, a.year));

const upcomingEvents = sortedEvents.filter((e) => e.isUpcoming);
const pastEvents = sortedEvents.filter((e) => !e.isUpcoming);
---

<Layout title="Events — B.Y.T.E." active="events">
  <div class="page-header">
    <div class="wrap">
      <h1>Events</h1>
      <p>Discover. Learn. Grow. Together.</p>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="filter-row">
        <button class="filter-pill active">All</button>
        <button class="filter-pill">Workshop</button>
        <button class="filter-pill">Competition</button>
        <button class="filter-pill">Tech Talk</button>
        <button class="filter-pill">Social</button>
      </div>

      {upcomingEvents.length > 0 && (
        <div class="events-section-block" style="margin-bottom: 80px;">
          <h2 style="font-family: 'Clash Display', sans-serif; font-size: 2rem; color: #fff; margin-bottom: 30px;">Upcoming Events</h2>
          <div class="events-list">
            {upcomingEvents.map((event, index) => {
              const isFlip = index % 2 === 1;
              const [day, month] = event.date.split(' ');
              return (
                <div class={`event-card ${isFlip ? 'flip' : ''}`} data-type={event.type}>
                  {!isFlip && (
                    <div class="ph" data-ratio="800 × 600"><span class="ph-tag">Event photo</span><svg><use href="#i-image"/></svg></div>
                  )}
                  <div class="event-body">
                    <div class="date-chip">
                      <b>{day}</b>
                      <span>{month}</span>
                      {event.year && <span style="font-size: 0.7em; opacity: 0.8; display: block; text-align: center;">{event.year}</span>}
                    </div>
                    <div class="event-content">
                      <h3>{event.name}</h3>
                      <p>{event.shortDescription}</p>
                      <div class="meta-row">
                        <span><svg><use href="#i-clock"/></svg>{event.time}</span>
                        <span><svg><use href="#i-pin"/></svg>{event.venue}</span>
                      </div>
                      <a href={`/events/${event.slug}`} class="link-btn">View Details <svg><use href="#i-arrow"/></svg></a>
                    </div>
                  </div>
                  {isFlip && (
                    <div class="ph" data-ratio="800 × 600"><span class="ph-tag">Event photo</span><svg><use href="#i-image"/></svg></div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      {pastEvents.length > 0 && (
        <div class="events-section-block">
          <h2 style="font-family: 'Clash Display', sans-serif; font-size: 2rem; color: #fff; margin-bottom: 30px; opacity: 0.8;">Past Events</h2>
          <div class="events-list" style="opacity: 0.7;">
            {pastEvents.map((event, index) => {
              const isFlip = index % 2 === 1;
              const [day, month] = event.date.split(' ');
              return (
                <div class={`event-card ${isFlip ? 'flip' : ''}`} data-type={event.type}>
                  {!isFlip && (
                    <div class="ph" data-ratio="800 × 600"><span class="ph-tag">Archive photo</span><svg><use href="#i-image"/></svg></div>
                  )}
                  <div class="event-body">
                    <div class="date-chip">
                      <b>{day}</b>
                      <span>{month}</span>
                      {event.year && <span style="font-size: 0.7em; opacity: 0.8; display: block; text-align: center;">{event.year}</span>}
                    </div>
                    <div class="event-content">
                      <h3>{event.name}</h3>
                      <p>{event.shortDescription}</p>
                      <div class="meta-row">
                        <span><svg><use href="#i-clock"/></svg>{event.time}</span>
                        <span><svg><use href="#i-pin"/></svg>{event.venue}</span>
                      </div>
                      <a href={`/events/${event.slug}`} class="link-btn">View Details <svg><use href="#i-arrow"/></svg></a>
                    </div>
                  </div>
                  {isFlip && (
                    <div class="ph" data-ratio="800 × 600"><span class="ph-tag">Archive photo</span><svg><use href="#i-image"/></svg></div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      {upcomingEvents.length === 0 && pastEvents.length === 0 && (
        <div class="empty-events" style="text-align: center; color: #888; padding: 60px 0;">
          <p>No events found.</p>
        </div>
      )}
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="newsletter">
        <div>
          <h3>Stay Updated</h3>
          <p>Subscribe to get the latest updates about our events.</p>
        </div>
        <div class="newsletter-form">
          <input type="email" placeholder="Enter your email">
          <button class="btn btn-primary">Subscribe</button>
        </div>
        <div class="ph newsletter-visual"><svg><use href="#i-mail"/></svg></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.filter-pill').forEach((pill) => {
    pill.addEventListener('click', (e) => {
      // Handle active state
      document.querySelectorAll('.filter-pill').forEach((x) => x.classList.remove('active'));
      const target = e.target as HTMLElement;
      target.classList.add('active');

      // Handle filtering
      const filterValue = target.textContent?.trim().toLowerCase() || 'all';
      const eventCards = document.querySelectorAll('.event-card');
      const blocks = document.querySelectorAll('.events-section-block');

      eventCards.forEach((card) => {
        const type = (card as HTMLElement).dataset.type?.toLowerCase() || '';
        if (filterValue === 'all' || type === filterValue) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // Hide empty section blocks
      blocks.forEach((block) => {
        // If a card doesn't have display: none, it's visible.
        // We use querySelectorAll with a negation pseudo-class to find visible cards.
        const visibleCards = block.querySelectorAll('.event-card:not([style*="display: none"])');
        if (visibleCards.length === 0) {
          (block as HTMLElement).style.display = 'none';
        } else {
          (block as HTMLElement).style.display = '';
        }
      });
    });
  });
</script>
