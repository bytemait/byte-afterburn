---
import Layout from '../layouts/Layout.astro';

const socialLinks = [
  {
    name: 'Instagram',
    description: 'Follow BYTE for updates, events and community highlights.',
    href: 'https://www.instagram.com/byte__official',
    icon: 'instagram',
  },
  {
    name: 'LinkedIn',
    description: 'Connect with BYTE MAIT and follow our professional journey.',
    href: 'https://www.linkedin.com/company/byte-official',
    icon: 'linkedin',
  },
  {
    name: 'GitHub',
    description: 'Explore projects and code built by the BYTE community.',
    href: 'https://github.com/bytemait',
    icon: 'github',
  },
  {
    name: 'Discord',
    description: 'Join the BYTE community and connect with fellow builders.',
    href: 'https://discord.gg/HNYhA4Ww5',
    icon: 'discord',
  },
  {
    name: 'Email',
    description: 'Reach out to BYTE for collaborations, queries and opportunities.',
    href: '#',
    icon: 'email',
  },
];

/*
  Recruitment is separate from Linktree.
  Replace this URL later with your actual recruitment form URL.
*/
const recruitmentSubmissionUrl = '#';
---

<Layout title="Contact — B.Y.T.E." active="contact">

  <main class="contact-page">

    <!-- HERO -->
    <section class="contact-hero">
      <div class="wrap">

        <p class="eyebrow">
          GET IN TOUCH
        </p>

        <h1>
          Let's build something
          <span>together.</span>
        </h1>

        <p class="contact-intro">
          Have an idea, a question, or simply want to connect with a
          community of builders and creators? Reach out and become part
          of the BYTE journey.
        </p>

      </div>
    </section>


    <!-- SOCIAL LINKS -->
    <section class="social-section">

      <div class="wrap">

        <div class="section-heading">

          <div>
            <p class="eyebrow">
              FOLLOW BYTE
            </p>

            <h2>
              Stay connected.
            </h2>
          </div>

          <p>
            Find us across the platforms where our community learns,
            builds and grows together.
          </p>

        </div>


        <div class="social-grid">

          {socialLinks.map((social) => (

            <a
              href={social.href}
              target={social.href !== '#' ? '_blank' : undefined}
              rel={social.href !== '#' ? 'noopener noreferrer' : undefined}
              class="social-card"
            >

              <div class="social-icon">

                {social.icon === 'instagram' && (
                  <svg>
                    <use href="#i-ig" />
                  </svg>
                )}

                {social.icon === 'linkedin' && (
                  <svg>
                    <use href="#i-li" />
                  </svg>
                )}

                {social.icon === 'github' && (
                  <svg>
                    <use href="#i-gh" />
                  </svg>
                )}

                {social.icon === 'email' && (
                  <svg>
                    <use href="#i-mail" />
                  </svg>
                )}

                {social.icon === 'discord' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M20.32 4.37A19.8 19.8 0 0 0 15.4 2.9l-.62 1.25a18.1 18.1 0 0 0-5.56 0L8.6 2.9a19.8 19.8 0 0 0-4.92 1.47C.56 9.06-.29 13.63.14 18.14A19.9 19.9 0 0 0 6.18 21.1l1.47-2.02a12.1 12.1 0 0 1-2.32-1.12l.6-.47c4.48 2.05 9.33 2.05 13.76 0l.6.47a12.3 12.3 0 0 1-2.33 1.12l1.47 2.02a19.9 19.9 0 0 0 6.05-2.96c.5-5.23-.85-9.76-5.16-13.77ZM8.66 15.4c-1.3 0-2.37-1.19-2.37-2.65s1.04-2.65 2.37-2.65c1.33 0 2.4 1.19 2.37 2.65 0 1.46-1.04 2.65-2.37 2.65Zm6.68 0c-1.3 0-2.37-1.19-2.37-2.65s1.04-2.65 2.37-2.65c1.33 0 2.4 1.19 2.37 2.65 0 1.46-1.04 2.65-2.37 2.65Z" />
                  </svg>
                )}

              </div>


              <div class="social-content">

                <h3>
                  {social.name}
                </h3>

                <p>
                  {social.description}
                </p>

              </div>


              {social.href !== '#' && (
                <div class="social-arrow">
                  <svg>
                    <use href="#i-arrow" />
                  </svg>
                </div>
              )}

            </a>

          ))}

        </div>

      </div>

    </section>


    <!-- RECRUITMENT -->
    <section class="recruitment-section">

      <div class="wrap">

        <div class="recruitment-card">

          <div class="recruitment-glow"></div>

          <div class="recruitment-content">

            <p class="eyebrow">
              BYTE RECRUITMENT
            </p>

            <h2>
              We're
              <span>recruiting.</span>
            </h2>

            <p class="recruitment-text">
              Already received your recruitment task? Submit your work
              and take the next step toward becoming a part of BYTE.
            </p>

            <div class="recruitment-actions">

              <a
                href={recruitmentSubmissionUrl}
                class="btn btn-primary"
              >
                Submit Recruitment Task

                <svg>
                  <use href="#i-arrow" />
                </svg>

              </a>

            </div>

          </div>


          <div class="recruitment-number">
            BYTE
          </div>

        </div>

      </div>

    </section>


    <!-- BOTTOM SECTION -->
    <section class="contact-bottom">

      <div class="wrap">

        <div class="bottom-content">

          <p class="eyebrow">
            BUILD WITH US
          </p>

          <h2>
            Curious minds.
            <br />
            <span>Big ideas.</span>
          </h2>

          <p>
            BYTE is more than a technical society. It's a community of
            people who are curious enough to ask questions and ambitious
            enough to build the answers.
          </p>

          <a
            href="/"
            class="btn btn-outline"
          >
            Explore BYTE
          </a>

        </div>

      </div>

    </section>

  </main>

</Layout>


<style>

  .contact-page {
    min-height: 100vh;

    background:
      radial-gradient(
        ellipse at 80% 0%,
        rgba(34, 197, 121, 0.09),
        transparent 35%
      ),
      var(--bg);
  }


  .contact-hero {
    padding: 150px 0 100px;
    border-bottom: 1px solid var(--line);
  }


  .contact-hero h1 {
    max-width: 900px;

    font-size: clamp(3.5rem, 8vw, 7rem);

    line-height: 0.98;

    letter-spacing: -0.06em;
  }


  .contact-hero h1 span {
    display: block;
    color: var(--lime);
  }


  .contact-intro {
    max-width: 600px;

    margin-top: 32px;

    color: var(--text-dim);

    font-size: 1.05rem;

    line-height: 1.8;
  }


  .social-section {
    padding: 100px 0;
  }


  .section-heading {
    display: flex;

    justify-content: space-between;

    align-items: end;

    gap: 40px;

    margin-bottom: 48px;
  }


  .section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4rem);
  }


  .section-heading > p {
    max-width: 420px;

    margin: 0;

    color: var(--text-dim);

    line-height: 1.7;
  }


  .social-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 14px;
  }


  .social-card {
    position: relative;

    display: flex;

    align-items: center;

    gap: 22px;

    min-height: 150px;

    padding: 28px;

    overflow: hidden;

    background: rgba(16, 22, 15, 0.75);

    border: 1px solid var(--line);

    border-radius: 14px;

    transition:
      transform 220ms ease,
      border-color 220ms ease,
      background 220ms ease;
  }


  .social-card::before {
    content: "";

    position: absolute;

    inset: auto -20% -80% auto;

    width: 180px;

    height: 180px;

    border-radius: 50%;

    background: rgba(34, 197, 121, 0.08);

    filter: blur(20px);

    transition: transform 300ms ease;
  }


  .social-card:hover {
    transform: translateY(-4px);

    border-color: rgba(82, 224, 166, 0.5);

    background: rgba(20, 30, 20, 0.9);
  }


  .social-card:hover::before {
    transform: scale(1.3);
  }


  .social-icon {
    position: relative;

    z-index: 1;

    width: 52px;

    height: 52px;

    display: grid;

    place-items: center;

    flex-shrink: 0;

    border: 1px solid rgba(34, 197, 121, 0.18);

    border-radius: 12px;

    background: rgba(34, 197, 121, 0.1);

    color: var(--lime);
  }


  .social-icon svg {
    width: 24px;
    height: 24px;
  }


  .social-content {
    position: relative;

    z-index: 1;

    flex: 1;
  }


  .social-content h3 {
    margin-bottom: 8px;

    font-size: 1.15rem;
  }


  .social-content p {
    margin: 0;

    color: var(--text-dim);

    font-size: 0.88rem;

    line-height: 1.6;
  }


  .social-arrow {
    position: relative;

    z-index: 1;

    color: var(--lime);
  }


  .social-arrow svg {
    width: 20px;
    height: 20px;
  }


  .recruitment-section {
    padding: 40px 0 110px;
  }


  .recruitment-card {
    position: relative;

    overflow: hidden;

    padding: clamp(42px, 7vw, 90px);

    border: 1px solid rgba(34, 197, 121, 0.25);

    border-radius: 20px;

    background:
      linear-gradient(
        135deg,
        rgba(34, 197, 121, 0.13),
        rgba(10, 15, 11, 0.95) 60%
      );
  }


  .recruitment-glow {
    position: absolute;

    width: 500px;

    height: 500px;

    right: -220px;

    top: -250px;

    border-radius: 50%;

    background: rgba(34, 197, 121, 0.2);

    filter: blur(80px);

    pointer-events: none;
  }


  .recruitment-content {
    position: relative;

    z-index: 1;

    max-width: 680px;
  }


  .recruitment-content h2 {
    font-size: clamp(3rem, 6vw, 6rem);

    line-height: 0.95;

    letter-spacing: -0.05em;
  }


  .recruitment-content h2 span {
    display: block;

    color: var(--lime);
  }


  .recruitment-text {
    max-width: 560px;

    margin: 28px 0 34px;

    color: var(--text-dim);

    font-size: 1rem;

    line-height: 1.75;
  }


  .recruitment-actions {
    display: flex;

    gap: 20px;

    align-items: center;

    flex-wrap: wrap;
  }


  .recruitment-actions svg {
    width: 16px;

    height: 16px;
  }


  .recruitment-number {
    position: absolute;

    right: 40px;

    bottom: -35px;

    color: rgba(82, 224, 166, 0.08);

    font-family: "Sora", sans-serif;

    font-size: clamp(7rem, 18vw, 17rem);

    font-weight: 800;

    letter-spacing: -0.08em;

    pointer-events: none;
  }


  .contact-bottom {
    padding: 100px 0;

    border-top: 1px solid var(--line);

    background: var(--bg-soft);
  }


  .bottom-content {
    max-width: 750px;
  }


  .bottom-content h2 {
    margin-bottom: 28px;

    font-size: clamp(2.8rem, 5vw, 5rem);

    line-height: 1;
  }


  .bottom-content h2 span {
    color: var(--lime);
  }


  .bottom-content p:not(.eyebrow) {
    max-width: 600px;

    margin-bottom: 30px;

    color: var(--text-dim);

    line-height: 1.8;
  }


  @media (max-width: 760px) {

    .contact-hero {
      padding: 110px 0 70px;
    }

    .section-heading {
      flex-direction: column;

      align-items: flex-start;
    }

    .social-grid {
      grid-template-columns: 1fr;
    }

    .social-card {
      min-height: auto;
    }

    .recruitment-number {
      right: 15px;

      bottom: -10px;

      opacity: 0.6;
    }

  }


  @media (max-width: 520px) {

    .contact-hero h1 {
      font-size: 3.3rem;
    }

    .social-card {
      align-items: flex-start;
    }

    .social-arrow {
      display: none;
    }

    .recruitment-actions {
      align-items: flex-start;

      flex-direction: column;
    }

  }

</style>