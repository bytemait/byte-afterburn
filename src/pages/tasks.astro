---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/common/Footer.astro';

interface Dept {
  department: string;
  tagline: string;
  description: string;
  image: string;
  skills: string[];
  difficulty: 'Beginner' | 'Intermediate' | 'Advanced';
}

const departments: Dept[] = [
  {
    department: 'App Development',
    tagline: 'Build apps people actually use.',
    description: 'Work on native and cross-platform mobile apps — from first wireframe to Play Store. Ship real products alongside a team that reviews, iterates, and cares about UX.',
    image: '/assets/tasks/app-dev.png',
    skills: ['React Native', 'Flutter', 'Swift', 'Kotlin', 'Firebase'],
    difficulty: 'Beginner',
  },
  {
    department: 'Web Development',
    tagline: 'Ship it. Then ship it faster.',
    description: 'Full-stack web projects — marketing sites, dashboards, tools, APIs. We care about performance, accessibility, and code that the next person can read.',
    image: '/assets/tasks/web-dev.png',
    skills: ['React', 'Astro', 'Node.js', 'TypeScript', 'Tailwind'],
    difficulty: 'Beginner',
  },
  {
    department: 'AI / ML',
    tagline: 'Models that solve real problems.',
    description: 'Data pipelines, model training, evaluation, and deployment. Work on projects where machine learning meets a genuine use case — not just a notebook.',
    image: '/assets/tasks/ai-ml.png',
    skills: ['Python', 'PyTorch', 'TensorFlow', 'Pandas', 'OpenCV'],
    difficulty: 'Intermediate',
  },
  {
    department: 'Mechatronics',
    tagline: 'Code meets the physical world.',
    description: 'Robotics, embedded systems, hardware prototyping. Design circuits, write firmware, and build things that move, sense, and respond.',
    image: '/assets/tasks/mechatronics.png',
    skills: ['Arduino', 'Raspberry Pi', 'ROS', 'PCB Design', 'C/C++'],
    difficulty: 'Intermediate',
  },
  {
    department: 'Cybersecurity',
    tagline: 'Break things. Then fix them.',
    description: 'CTFs, penetration testing, vulnerability research, and secure architecture. Learn offensive and defensive security through hands-on challenges.',
    image: '/assets/tasks/cybersecurity.png',
    skills: ['Linux', 'Networking', 'Burp Suite', 'Wireshark', 'Python'],
    difficulty: 'Intermediate',
  },
  {
    department: 'Outreach',
    tagline: 'Connect minds. Build community.',
    description: 'Sponsorships, event operations, PR, and community growth. Lead society initiatives, forge industry partnerships, and represent Byte to the wider tech ecosystem.',
    image: '/assets/tasks/outreach.png',
    skills: ['Community', 'Event Ops', 'Sponsorships', 'Content Creation', 'PR & Media'],
    difficulty: 'Beginner',
  },
];

const timelineSteps = [
  { step: '01', title: 'Tasks Drop', date: 'Day 1', desc: 'Problem statements live', status: 'current' },
  { step: '02', title: 'Build Sprint', date: 'Days 2–4', desc: 'Hack, test & mentor sync', status: 'upcoming' },
  { step: '03', title: 'Submission Lock', date: 'Day 5', desc: 'Repo & form lock at 11:59 PM', status: 'upcoming' },
  { step: '04', title: 'Walkthroughs', date: 'Days 6–7', desc: '1-on-1 lead discussions', status: 'upcoming' },
];

const faqs = [
  {
    q: 'Can I apply for more than one department?',
    a: 'Yes! You can attempt tasks for up to two departments if you are interested in multiple domains. Each submission will be evaluated independently by domain leads.',
  },
  {
    q: 'Do I need prior experience to attempt starter tasks?',
    a: 'No prior experience required. Our starter tasks are designed to assess problem-solving mindset, curiosity, and execution rather than pre-existing mastery.',
  },
  {
    q: 'What if I get stuck or have questions during the task?',
    a: 'Join our Discord server and post in the #recruitment-help channel. Our domain leads and seniors are available to clarify requirements and unblock you.',
  },
  {
    q: 'How will my submission be evaluated?',
    a: 'We evaluate code quality, problem breakdown, creativity, edge-case thinking, and clean documentation. Finishing 80% with thoughtful architecture beats rushed completion.',
  },
  {
    q: 'What happens after I submit?',
    a: 'Submissions are reviewed within a week after the deadline. Shortlisted candidates receive an invite for a brief walkthrough discussion with domain leads.',
  },
];

const difficultyColor: Record<string, string> = {
  Beginner: '#52e0a6',
  Intermediate: '#e0c752',
  Advanced: '#e05252',
};
---

<Layout title="Tasks — B.Y.T.E." active="tasks" footerInSlot>
  <div class="page-header">
    <div class="wrap">
      <h1>Tasks</h1>
      <p>Pick a department. Grab a task. Start building.</p>
    </div>
  </div>

  <section class="tasks-section">
    <div class="wrap">
      <!-- PREMIUM PROGRESS BAR TIMELINE -->
      <div class="timeline-progress-wrapper" aria-label="Recruitment progress">
        <div class="timeline-header-bar">
          <div class="timeline-header-left">
            <span class="timeline-status-pill">
              <span class="pulse-dot"></span>
              STAGE 01 ACTIVE
            </span>
            <span class="timeline-header-title">RECRUITMENT ROADMAP</span>
          </div>
          <span class="timeline-header-badge">5-DAY SPRINT</span>
        </div>

        <div class="progress-track-container">
          <div class="progress-track-bg"></div>
          <div class="progress-track-fill" style="width: 16%;"></div>

          <div class="progress-nodes">
            {timelineSteps.map((item) => (
              <div class:list={['progress-node-item', { 'is-current': item.status === 'current' }]}>
                <div class="node-indicator">
                  <div class="node-ring"></div>
                  <div class="node-dot">
                    {item.status === 'current' ? (
                      <span class="node-active-icon">●</span>
                    ) : (
                      <span class="node-num">{item.step}</span>
                    )}
                  </div>
                </div>
                <div class="node-content">
                  <div class="node-top-row">
                    <span class="node-step-tag">{item.step}</span>
                    <span class="node-date">{item.date}</span>
                  </div>
                  <span class="node-title">{item.title}</span>
                  <span class="node-desc">{item.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- DEPARTMENTS GRID DIRECTLY VISIBLE -->
      <div class="project-grid">
        {departments.map((dept) => (
          <div class="project-card">
            <div class="project-card-image">
              <img
                src={dept.image}
                alt={`${dept.department} preview`}
                loading="lazy"
              />
            </div>
            <div class="project-card-body">
              <h3>{dept.department}</h3>
              <div class="task-tagline">{dept.tagline}</div>
              <p class="task-desc">{dept.description}</p>
              <div class="project-meta">
                <span class="project-meta-item">
                  <span class="difficulty-indicator" style={`--dot-color: ${difficultyColor[dept.difficulty]}`}>
                    {dept.difficulty} friendly
                  </span>
                </span>
                <span class="project-meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                  <span class="project-meta-tags">
                    {dept.skills.map((skill) => (
                      <span class="project-tag">{skill}</span>
                    ))}
                  </span>
                </span>
              </div>
              <div class="project-card-actions">
                <span class="link-btn disabled-task-btn">
                  Tasks coming soon
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- DISCORD SUPPORT CALLOUT -->
      <div class="discord-callout">
        <div class="discord-callout-content">
          <div class="discord-icon-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6h0a14.5 14.5 0 0 0-4-1.5 9.8 9.8 0 0 0-.4 1.8 13.9 13.9 0 0 0-3.2 0 9.8 9.8 0 0 0-.4-1.8A14.5 14.5 0 0 0 6 6a15.8 15.8 0 0 0-2.4 9.7 14.4 14.4 0 0 0 4.5 2.3 10.3 10.3 0 0 0 1-1.6 9.3 9.3 0 0 1-1.5-.7c.1-.1.3-.2.4-.3a10.6 10.6 0 0 0 8 0c.1.1.3.2.4.3a9.3 9.3 0 0 1-1.5.7 10.3 10.3 0 0 0 1 1.6 14.4 14.4 0 0 0 4.5-2.3A15.8 15.8 0 0 0 18 6Z"/><path d="M9.5 11.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/><path d="M14.5 11.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/></svg>
          </div>
          <div>
            <h3>Stuck on a task? Ask in Discord.</h3>
            <p>Our domain leads and mentors are active on Discord to help you troubleshoot, clarify requirements, or discuss ideas.</p>
          </div>
        </div>
        <a href="https://discord.gg/HNYhA4Ww5" target="_blank" rel="noopener noreferrer" class="btn btn-outline discord-btn">
          Join Discord
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>

      <!-- FAQ SECTION -->
      <div class="section-heading" id="faqs" style="margin-top: 56px;">
        <h2>Recruitment FAQs</h2>
        <p>Everything you need to know about the tasks and selection process.</p>
      </div>

      <div class="faq-accordion">
        {faqs.map((faq, i) => (
          <details class="faq-card">
            <summary>
              <span class="faq-num">0{i + 1}</span>
              <span class="faq-title">{faq.q}</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="faq-body">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- FOOTER CTA -->
      <div class="newsletter" style="margin-top:56px;">
        <div>
          <h3>Ready to have a byte?</h3>
          <p>Tasks will be posted here when recruitment opens. Follow us to stay in the loop.</p>
        </div>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>

  <!-- STICKY FLOATING COUNTDOWN BADGE (BOTTOM RIGHT) -->
  <div class="sticky-countdown-badge" id="stickyCountdown" role="timer" aria-label="Submission deadline countdown">
    <div class="sticky-countdown-inner">
      <div class="sticky-badge-header">
        <span class="sticky-live-dot" aria-hidden="true"></span>
        <span class="sticky-badge-label">SUBMISSION DEADLINE</span>
      </div>
      <div class="sticky-digits-row">
        <span class="sticky-digit" id="cdDays">03</span><span class="sticky-unit">d</span> :
        <span class="sticky-digit" id="cdHours">14</span><span class="sticky-unit">h</span> :
        <span class="sticky-digit" id="cdMins">42</span><span class="sticky-unit">m</span> :
        <span class="sticky-digit" id="cdSecs">18</span><span class="sticky-unit">s</span>
      </div>
    </div>
  </div>

  <Footer immersive />
</Layout>

<script>
  function initStickyCountdown() {
    const daysEl = document.getElementById('cdDays');
    const hoursEl = document.getElementById('cdHours');
    const minsEl = document.getElementById('cdMins');
    const secsEl = document.getElementById('cdSecs');
    const badge = document.getElementById('stickyCountdown');

    // 1. Footer collision observer
    if (badge) {
      const footer = document.querySelector('.byte-footer');
      if (footer) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            badge.classList.toggle('is-over-footer', entry.isIntersecting);
          },
          { rootMargin: '0px 0px 90px' }
        );
        observer.observe(footer);
      }
    }

    // 2. Countdown calculation
    if (!daysEl) return;

    const TARGET_STORAGE_KEY = 'byte_tasks_target_v1';
    let targetTime = 0;
    try {
      const stored = localStorage.getItem(TARGET_STORAGE_KEY);
      if (stored && Number(stored) > Date.now()) {
        targetTime = Number(stored);
      } else {
        targetTime = Date.now() + (4 * 24 + 14) * 3600 * 1000 + 42 * 60 * 1000;
        localStorage.setItem(TARGET_STORAGE_KEY, String(targetTime));
      }
    } catch {
      targetTime = Date.now() + (4 * 24 + 14) * 3600 * 1000;
    }

    function updateCountdown() {
      const now = Date.now();
      let diff = Math.max(0, targetTime - now);

      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      diff -= d * (1000 * 60 * 60 * 24);
      const h = Math.floor(diff / (1000 * 60 * 60));
      diff -= h * (1000 * 60 * 60);
      const m = Math.floor(diff / (1000 * 60));
      diff -= m * (1000 * 60);
      const s = Math.floor(diff / 1000);

      const pad = (n: number) => String(n).padStart(2, '0');

      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minsEl) minsEl.textContent = pad(m);
      if (secsEl) secsEl.textContent = pad(s);
    }

    updateCountdown();
    const interval = setInterval(updateCountdown, 1000);

    document.addEventListener(
      'astro:before-swap',
      () => clearInterval(interval),
      { once: true }
    );
  }

  initStickyCountdown();
  document.addEventListener('astro:page-load', initStickyCountdown);
</script>

<style>
  /* =============================================================
     PREMIUM PROGRESS BAR TIMELINE
     ============================================================= */
  .timeline-progress-wrapper {
    background: linear-gradient(180deg, #131714 0%, #0d100e 100%);
    border: 1px solid rgba(82, 224, 166, 0.25);
    border-radius: 14px;
    padding: 20px 24px 22px;
    margin-bottom: 38px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  .timeline-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .timeline-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .timeline-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--lime-bright, #52e0a6);
    background: rgba(82, 224, 166, 0.12);
    border: 1px solid rgba(82, 224, 166, 0.3);
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.04em;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime-bright, #52e0a6);
    box-shadow: 0 0 6px var(--lime-bright, #52e0a6);
    animation: livePulse 2s infinite;
  }

  .timeline-header-title {
    font-family: 'Sora', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .timeline-header-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3px 10px;
    border-radius: 6px;
  }

  .progress-track-container {
    position: relative;
    padding-top: 4px;
  }

  .progress-track-bg {
    position: absolute;
    top: 18px;
    left: 48px;
    right: 48px;
    height: 2px;
    background: rgba(255, 255, 255, 0.08);
    z-index: 1;
    border-radius: 2px;
  }

  .progress-track-fill {
    position: absolute;
    top: 18px;
    left: 48px;
    height: 2px;
    background: linear-gradient(90deg, #52e0a6 0%, #34d399 100%);
    box-shadow: 0 0 10px rgba(82, 224, 166, 0.8);
    z-index: 2;
    border-radius: 2px;
  }

  .progress-nodes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    position: relative;
    z-index: 3;
  }

  .progress-node-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 6px;
    transition: transform 0.2s ease;
  }

  .progress-node-item:hover {
    transform: translateY(-2px);
  }

  .node-indicator {
    position: relative;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .node-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0d110e;
    transition: all 0.25s ease;
  }

  .progress-node-item.is-current .node-ring {
    border-color: var(--lime-bright, #52e0a6);
    background: rgba(82, 224, 166, 0.12);
    box-shadow: 0 0 14px rgba(82, 224, 166, 0.5);
  }

  .node-dot {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-dim);
  }

  .node-active-icon {
    color: var(--lime-bright, #52e0a6);
    font-size: 0.75rem;
    line-height: 1;
    filter: drop-shadow(0 0 4px var(--lime-bright, #52e0a6));
  }

  .node-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    width: 100%;
  }

  .node-top-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .node-step-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-dim);
  }

  .progress-node-item.is-current .node-step-tag {
    color: var(--lime-bright, #52e0a6);
  }

  .node-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.04);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .node-title {
    font-family: 'Sora', sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .progress-node-item.is-current .node-title {
    color: #ffffff;
  }

  .node-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    color: var(--text-dim);
    line-height: 1.35;
    margin-top: 2px;
  }

  /* =============================================================
     STICKY FLOATING COUNTDOWN BADGE (BOTTOM RIGHT)
     ============================================================= */
  .sticky-countdown-badge {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 20;
    transform: translateZ(0);
    transition: bottom 420ms cubic-bezier(0.16, 1, 0.3, 1), transform 220ms ease;
  }

  .sticky-countdown-badge.is-over-footer {
    bottom: 88px;
  }

  .sticky-countdown-inner {
    background: rgba(12, 16, 13, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(82, 224, 166, 0.38);
    border-radius: 12px;
    padding: 10px 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(82, 224, 166, 0.1);
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 175px;
  }

  .sticky-badge-header {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .sticky-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime-bright, #52e0a6);
    box-shadow: 0 0 6px var(--lime-bright, #52e0a6);
    animation: livePulse 2s infinite;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .sticky-badge-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .sticky-digits-row {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--lime-bright, #52e0a6);
    letter-spacing: 0.02em;
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .sticky-unit {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-dim);
    margin-right: 2px;
  }

  /* =============================================================
     DEPARTMENT CARDS & TAGS
     ============================================================= */
  .section-heading {
    margin-bottom: 24px;
  }

  .section-heading h2 {
    font-size: 1.45rem;
    font-weight: 700;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .section-heading p {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0;
  }

  .task-tagline {
    color: var(--lime);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: -4px 0 8px;
  }

  .task-desc {
    color: var(--text-dim);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0 0 14px;
  }

  .difficulty-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--dot-color);
  }

  .difficulty-indicator::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dot-color);
  }

  .disabled-task-btn {
    opacity: 0.55;
    pointer-events: none;
    cursor: default;
  }

  /* =============================================================
     DISCORD BANNER
     ============================================================= */
  .discord-callout {
    margin-top: 56px;
    background: linear-gradient(135deg, rgba(82, 224, 166, 0.08) 0%, rgba(20, 20, 20, 0.95) 100%);
    border: 1px solid rgba(82, 224, 166, 0.25);
    border-radius: 14px;
    padding: 28px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .discord-callout-content {
    display: flex;
