---
import Icons from '../components/common/Icons.astro';
import Nav from '../components/common/Nav.astro';
import Footer from '../components/common/Footer.astro';
import PageTransitions from '../components/common/PageTransitions.astro';
import NodeMesh from '../components/common/NodeMesh';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  active?: 'home' | 'events' | 'members' | 'contact';
  immersiveNav?: boolean;
  footerInSlot?: boolean;
  contentTransition?: boolean;
}

const {
  title,
  active = 'home',
  immersiveNav = false,
  footerInSlot = false,
  contentTransition = Astro.url.pathname !== '/'
} = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="/icon.png" />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <ClientRouter fallback="swap" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&family=Baloo+2:wght@600;700;800&family=Bungee&family=Archivo+Black&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Icons />
    <PageTransitions />

    <div class="global-mesh-layer" transition:persist="byte-node-mesh" aria-hidden="true">
      <NodeMesh client:load />
    </div>

    <Nav active={active} immersive={immersiveNav} />

    {contentTransition ? (
      <div class="page-transition-content" data-page-transition-content data-page-enter>
        <slot />
      </div>
    ) : (
      <slot />
    )}

    {!footerInSlot && <Footer immersive={immersiveNav} />}
  </body>
</html>

<style is:global>
  .global-mesh-layer {
    position: fixed;
    z-index: 0;
    inset: 0;
    pointer-events: none;
  }

  .global-mesh-layer .node-mesh {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .global-mesh-layer .title-network {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .site-nav,
  .page-transition-content,
  body > main,
  body > footer {
    position: relative;
    z-index: 1;
  }

  ::view-transition-old(root),
  ::view-transition-new(root),
  ::view-transition-old(byte-node-mesh),
  ::view-transition-new(byte-node-mesh) {
    animation: none;
  }
</style>
