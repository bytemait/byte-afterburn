---
import Icons from '../components/common/Icons.astro';
import Nav from '../components/common/Nav.astro';
import Footer from '../components/common/Footer.astro';
import PageTransitions from '../components/common/PageTransitions.astro';
import NodeMesh from '../components/common/NodeMesh';
import { ClientRouter } from 'astro:transitions';
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_SOCIAL_IMAGE,
  DEFAULT_SOCIAL_IMAGE_ALT,
  MAIT_ID,
  ORGANIZATION_ID,
  SITE_NAME,
  SITE_URL,
  WEBSITE_ID,
  type JsonLd,
} from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  active?: 'home' | 'events' | 'members' | 'contact' | 'projects';
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string;
  pageType?: string | string[];
  mainEntityId?: string;
  structuredData?: JsonLd | JsonLd[];
  immersiveNav?: boolean;
  footerInSlot?: boolean;
  contentTransition?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_SOCIAL_IMAGE,
  imageAlt = DEFAULT_SOCIAL_IMAGE_ALT,
  imageWidth: providedImageWidth,
  imageHeight: providedImageHeight,
  canonical,
  pageType = 'WebPage',
  mainEntityId,
  structuredData = [],
  active = 'home',
  immersiveNav = false,
  footerInSlot = false,
  contentTransition = Astro.url.pathname !== '/',
} = Astro.props;

const siteURL = Astro.site ?? SITE_URL;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, siteURL);
const ogImageURL = new URL(image, siteURL);
const usesDefaultImage = image === DEFAULT_SOCIAL_IMAGE;
const imageWidth = providedImageWidth ?? (usesDefaultImage ? 1200 : undefined);
const imageHeight = providedImageHeight ?? (usesDefaultImage ? 630 : undefined);
const pageId = `${canonicalURL.href}#webpage`;
const imageId = `${ogImageURL.href}#primaryimage`;
const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemaGraph: JsonLd[] = [
  {
    '@type': 'Organization',
    '@id': ORGANIZATION_ID,
    name: SITE_NAME,
    alternateName: ['BYTE', 'BYTE Society', 'Brains Yielding Technical Endeavors'],
    description: DEFAULT_DESCRIPTION,
    url: new URL('/', siteURL).href,
    email: 'innovators.byte@gmail.com',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/icon.png', siteURL).href,
      width: 264,
      height: 263,
    },
    parentOrganization: {
      '@type': 'CollegeOrUniversity',
      '@id': MAIT_ID,
      name: 'Maharaja Agrasen Institute of Technology',
      alternateName: 'MAIT',
      url: 'https://www.mait.ac.in/',
    },
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'PSP Area, Plot No. 1, Sector 22, Rohini',
      addressLocality: 'Delhi',
      postalCode: '110086',
      addressCountry: 'IN',
    },
    knowsAbout: ['Software Development', 'Artificial Intelligence', 'Machine Learning', 'Robotics', 'Cybersecurity', 'Research'],
    sameAs: [
      'https://cse.mait.ac.in/index.php/societies-chapters/student-club',
      'https://www.instagram.com/byte__official',
      'https://www.linkedin.com/company/byte-official',
      'https://github.com/bytemait',
      'https://www.youtube.com/@BYTE-mait',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': WEBSITE_ID,
    url: new URL('/', siteURL).href,
    name: SITE_NAME,
    alternateName: 'BYTE',
    description: DEFAULT_DESCRIPTION,
    publisher: { '@id': ORGANIZATION_ID },
    inLanguage: 'en-IN',
  },
  {
    '@type': 'ImageObject',
    '@id': imageId,
    url: ogImageURL.href,
    contentUrl: ogImageURL.href,
    caption: imageAlt,
    ...(imageWidth ? { width: imageWidth } : {}),
    ...(imageHeight ? { height: imageHeight } : {}),
  },
  {
    '@type': pageType,
    '@id': pageId,
    url: canonicalURL.href,
    name: title,
    description,
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': ORGANIZATION_ID },
    primaryImageOfPage: { '@id': imageId },
    ...(mainEntityId ? { mainEntity: { '@id': mainEntityId } } : {}),
    inLanguage: 'en-IN',
  },
  ...extraStructuredData,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph }).replace(
  /</g,
  '\\u003c',
);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07110b" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={jsonLd} />

    <ClientRouter fallback="swap" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&family=Baloo+2:wght@600;700;800&family=Bungee&family=Archivo+Black&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Icons />
    <PageTransitions />

    <div class="global-mesh-layer" transition:persist="byte-node-mesh" aria-hidden="true">
      <NodeMesh client:load />
    </div>

    <Nav active={active} immersive={immersiveNav} />

    {contentTransition ? (
      <div class="page-transition-content" data-page-transition-content data-page-enter>
        <slot />
      </div>
    ) : (
      <slot />
    )}

    {!footerInSlot && <Footer immersive={immersiveNav} />}
  </body>
</html>

<style is:global>
  .global-mesh-layer {
    position: fixed;
    z-index: 0;
    inset: 0;
    pointer-events: none;
  }

  .global-mesh-layer .node-mesh {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .global-mesh-layer .title-network {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .site-nav,
  .page-transition-content,
  body > main,
  body > footer {
    position: relative;
    z-index: 1;
  }

  ::view-transition-old(root),
  ::view-transition-new(root),
  ::view-transition-old(byte-node-mesh),
  ::view-transition-new(byte-node-mesh) {
    animation: none;
  }
</style>